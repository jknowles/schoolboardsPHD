@phdthesis{RefWorks:232,
	author={Joseph William Heinzelman},
	year={1996},
	title={The impact of increased female representation on Wisconsin school boards},
  school={The University of Wisconsin - Madison},
	pages={168},
	abstract={Prior to 1975, women accounted for only about 12% of the members of the nation's school boards. By 1978 the percentage had risen to 30%, and by 1995 had risen to 43% (ASBJ, 1995). According to the Wisconsin Association of School Boards (1993), female membership on Wisconsin boards mirrors the national increase (25% in 1980, 35% in 1994). Historical roles of superintendents and school boards evolved under these predominately male boards. Male board members tend to be more concerned about finance and facility related issues (Trotter, 1989), leave education decisions to the administration (Marshall and Heller, 1983) and tend to use authoritarian responses to settle disputes (Bendelow, 1983; Hughes and Robertson, 1980). Recent research argues that female members prefer to focus on curriculum and instruction issues (Trotter and Downey, 1989), to be part of the educational decision making (Marshall and Heller, 1983) and to avoid open conflict (Tannen, 1990). The purpose of the study was to investigate the impact of increased numbers of female board members on Wisconsin School Boards. The study consisted of 52 male majority school boards and 49 female majority school boards. A questionnaire was developed to identify the amount of time spent on curriculum and instruction issues, outside involvement in the decision making process and the level of conflict experienced by the school board. An analysis of variance was used to study the data. The results indicated no significant difference between male majority school boards and female majority school boards in time spent on curriculum and instruction issues or level of conflict. There was significant difference between the two boards on amount of outside group involvement in the decision making process. This could mean that superintendents may need to adjust how they operate when working with female majority school boards, especially putting a plan in place to solicit outside opinion. This could also indicate that school boards are heading in a slightly different direction.},
	keywords={School administration; Womens studies; Public administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=743157781&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

