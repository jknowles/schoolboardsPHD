@phdthesis{RefWorks:258,
	author={Paul Alan Strobel},
	year={1991},
	title={Influence on Wisconsin school boards: An analysis of selected individuals and groups},
	pages={221},
  school={University of Wisconsin - Milwaukee},
	abstract={This study analyzed factors that may impact on individuals' and groups' reported influence on school boards on four types of issues: curriculum, personnel, finance and facilities. The board's governance style, five district characteristics, and the perceptions of influence of board presidents, board members and superintendents were examined to determine their effect on the reported degree of influence of twelve individuals and groups: the governor, legislators, the state superintendent of public instruction, district superintendents, principals, teacher union officials, classroom teachers, special interest groups, school support groups, the general public and parents. The frequency of the individual's or group's communication with the board was also compared to their perceived level of influence to determine if there was a correlation between the frequency of communication and reported level of influence. Wisconsin school boards comprised the population for the study and 215 districts comprised the systematic sample. Surveys were returned from eighty-two percent of the districts. Analysis of the data showed school administrators tended to have more reputed influence with a trustee type board while teachers' and citizens' perceived influence increased when the board's governance style was described as a delegate/trustee or delegate type. District office administrators' reported influence increased as enrollment increased while principals' perceived influence declined. Restructuring initiatives increased the reported influence of teachers, parents and special interest groups. Positive board teacher-union relations increased the perceived influence of teacher union officials, classroom teachers and principals. Special interest groups had more reported influence in districts with little community agreement over expectations for their schools while superintendents' and principals' perceived influence increased as the level of community agreement increased. Board presidents, board members and superintendents perceptions of influence were found to differ as to the level of influence of certain individuals and groups on several of the governance issues. All three groups agreed that superintendents exercise the most influence on the board. A rather slight positive correlation was found between the degree of perceived influence a group or individual had on the board and the frequency of communication between the board and the group or individual.},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=746709221&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

