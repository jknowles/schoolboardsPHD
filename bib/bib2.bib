	pages={187},
  school={Rutgers},
	abstract={The purpose of this study was to determine the degree to which selected conflict variables impacted upon the buy out of superintendent contracts through a case study approach of four New Jersey communities. A forty-three item questionnaire was used to conduct interviews where buy outs had occurred. The bought out superintendents were interviewed as well as board of education members, school administrators, staff and community members. Additional data was collected on community growth patterns, enrollment figures, school board elections and evaluation procedures. The study concluded that there are six areas of conflict which could lead to contract termination. These are: (1) change in the community, both in composition and identity. As new people enter a community, mini-neighborhoods can develop in which different views surface. These views may not conform to that of long term residents. With a wide range of interest groups, superintendents may find it difficult to address the concerns of one group without creating conflict with another. Waning board support can add significantly to this dilemma. (2) change in boards of education. As board members change, power can easily shift causing political instability for the superintendent as well as changed expectations. Changes that are not clearly communicated to the superintendent can result in inconsistent focus of district priorities and activities. (3) infrequent and inconsistent evaluation of the superintendent. Districts which do not have a systematic and stable evaluation process, in which appropriate feedback is given to the superintendent, are almost certain to meet with difficulty. The superintendent must be informed of the areas needing improvement and given the opportunity to improve. (4) budget concerns relating to increased costs, budget defeats and poor fiscal management. Since there is probably no single activity in which a superintendent engages which has more importance than the school budget, conflicts in this area can be detrimental to the superintendent's employment. (5) poor board/superintendent interpersonal relationships. Superintendents and board members with opposing personalities, inflexible leadership styles and poor communication skills will no doubt find themselves in conflict. Relationships such as these create serious problems which may be irresolvable. (6) history of involuntary superintendent turnover and prior history of buy outs. (Abstract shortened with permission of author.)},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=745556031&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

@phdthesis{RefWorks:245,
	author={Dennis Patrick Maguire},
	year={1989},
	title={Assessment of community dissatisfaction: A study of electoral conflict in school board elections in Washington state},
	pages={195},
  school={Washington State University},
	abstract={This is a report of the fourth phase of a longitudinal study on school board elections in Washington state. The purpose of the study was to collect and analyze data using the Dissatisfaction Theory as a theoretical framework (Iannaccone & Lutz, 1970). The theoretical framework includes four variables of change: (1) community values, (2) citizen participation, (3) school board members' values, and (4) school policies. The variables form a causal chain which culminates in a change of school policies. Data were collected through a self response survey instrument distributed to the 296 school superintendents in Washington state. The survey instrument collected data on primary and general school board elections conducted in 1987. There was an 84% return rate of survey instruments. The data analysis suggests that there is a relationship between change in community values and community participation with respect to school board elections. From the analysis, it was concluded districts which experience an increase in community participation, as measured by the number of participants in an election, are more likely to experience a change in school board members' values, as measured by incumbent defeat in the election. A clear relationship exists between the change in school board members' values and change in school policies, as measured by superintendent turnover. Districts that experience incumbent defeat are more likely to experience superintendent turnover in one-to-three year period following an incumbent defeat election than districts that do not experience incumbent defeat. The study concludes districts that conduct primary elections, an indicator of increased community participation, are more likely to experience incumbent defeat in the general election than districts that do not conduct primary elections. Primary election districts experience more superintendent turnovers in the year following the primary election than do non-primary election districts. The study concluded the Dissatisfaction Theory is an appropriate theoretical framework for describing and explaining the local politics of education in Washington state.},
	keywords={School administration; Public administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=746880131&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

