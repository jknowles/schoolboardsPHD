@phdthesis{RefWorks:261,
	author={Jacque Allen Cowherd},
	year={1989},
	title={Perceptions of school board effectiveness as perceived by school board presidents and superintendents},
	pages={280},
  school={University of Missouri - Columbia},
	abstract={Purpose. The purpose of this study was to examine the perceptions of school board presidents and superintendents concerning the amount of emphasis ideally given to the characteristics of effective school boards and the amount of emphasis actually given to the characteristics of effective school boards. Procedures. The stratified random sample consisted of 224, K-12 six director public school districts divided into three size categories based on student enrollment. Data were obtained from a questionnaire based on the fifteen characteristics of effective school boards developed by the Institute for Educational Leadership. The overall response rate was 95.3%. The data were analyzed using descriptive statistics, repeated measures and one-way analysis of variance, univariate and multivariate, and the Least Significant Differences means comparison procedure. Findings. The following statements briefly describe the status of board presidents' and superintendents' perceptions on the fifteen characteristics. Both groups placed the most ideal and actual emphasis on dealing straightforwardly with controversy and the least ideal and actual emphasis on the use of committees. The data indicated that board presidents and superintendents differed regarding community support of the school. Different groups of superintendents, based on age, years of service within the district, level of education, and size of district, were compared to see if they gave significantly different ratings either under ideal or actual conditions to the 15 characteristics. Even though significant differences were found among groups for several characteristics, the variable related to the most clear cut pattern of differences was the size of the district. Board presidents and superintendents of small districts almost always responded, on both the ideal and actual condition, differently from their counterparts in medium and large groups. It appeared that board presidents and superintendents in medium and large districts focused more on policy decisions, long range planning and educational outcomes than did their counterparts in small districts. Board presidents and superintendents in small districts focused more on daily administrative operations as opposed to the broader governance issues.},
	keywords={School administration; Education},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=746388991&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

