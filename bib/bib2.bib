@phdthesis{RefWorks:259,
	author={Holbrook Passmore Hunt},
	year={1980},
	title={An Inductive Approach to the Dissatisfaction Theory in the Governance of Local School Districts: Predicting Incumbent School Board Member Defeat},
  school={Pennsylvania State University},
	pages={241},
	abstract={The purpose of this study was to take an inductive approach to one aspect of the dissatisfaction theory by attempting to predict incumbent school board member defeat. Central to this study was the investigation of whether or not social, economic and political indicators of community conditions, demonstrated in previous verificational studies as useful in accounting for the variance in school board member defeat, would be able to predict an election event. Two questions have dominated the study of local school governance: (1) Who governs? and (2) Is it democratic? In the politics of education, three schools of thought have emerged, each unique in its perspective on these questions. The main difference among them is their interpretability of the key element in the democratic process, i.e., participation, representation or dissatisfaction. Whereas the first two express some doubt that democracy is a viable political concept, the dissatisfaction theory leaves little question that a local school district is a successful democratic government. The beginning conceptualization of the dissatisfaction theory can be attributed to the development of the Lutz-Iannaccone explanatory model. The model describes the road to incumbent defeat as influenced by the societal dimension of the community. Over a period of time political systems, including school boards, have a tendency to drift toward an elitist posture. As the two dimensions move farther apart, a divergence is likely to occur. To reduce this gap and maintain the needed equilibrium, the concept of democratic control is activated. Citizen dissatisfaction with political man will prompt the use of the electoral process. Thus, democratic control enables civic man to initiate a chain of events that culminates with an adjustment of educational policy to reflect the community's new value orientation. The verificational research of Kirkendall, LeDoux and Garberina were deductive approaches to the investigation of the relationship between citizen dissatisfaction and incumbent defeat, and have thus far discovered and tested the ability of indicators of community conditions to account for an election outcome. The next logical step to further verify the explanatory model was to take an inductive approach by applying several regression models against a set of school board election data. A significant outcome in the model-building phase was that (1) several predictor models were generated from three data subsets, representing downward, moderate and upward community trends, and (2) the models were able to account for a significant degree of the variance in the response variable index. Cross-validation was the part in the prediction attempt where the inductive approach was used. Would these predictor models possess the ability to generalize to a corresponding population parameter? Using both uncontrolled and controlled division procedures, the inferential statistical application showed little predictability due to the following reasons: (1) Failure to include the local dimension. (2) Failure to include the personal dimension. (3) The instability of the variable emphasis from one election to another. Thus, it can be concluded that the predictor models generated from this set of indicators did not possess universality. As a result, it would be highly improbable for a regression model of this type to predict an election event on a randomly selected set of school districts. The prediction of incumbent school board member defeat may be accomplished if the concept of locality is substituted for the concept of universality. The investigation of a single school district or a regionalized approach may prove to be the vehicle to predict a school district election outcome and substantiate the assertion that the local school district is a successful democratic government.},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=749703591&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

