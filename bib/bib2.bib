@phdthesis{RefWorks:260,
	author={Alexander Uche {Ikejiaku Jr.}},
	year={2000},
	title={An analysis of school board policy-making styles, and their potential impact on student achievement},
	pages={215},
  school={Lynn S. State University of New York at Buffalo},
	abstract={There is ample evidence in the education literature that the policy-making style of school boards varies from school district to school district, and that this variation affects the way each district is managed. With this as a premise, it becomes critically important to investigate whether these variations in style affect district governance in ways that ultimately impact educational objectives and outcomes. The purpose of the study was to classify school boards as either "professional" or "political," and to subsequently compare the student achievement indicators of the two groups to see if there are differences that might be associated with board style. The study was largely exploratory and descriptive in nature, and therefore would benefit from further research into the major concepts, methodology, and findings. A total of 258 board presidents from New York State's public school districts were surveyed to gather information about the educational beliefs and actions of their respective boards. This information was in turn used in the style classification process. The performance indicators of the two groups (which were excerpted from NYSED's 1998 Report Card) were subsequently compared to see if there are statistically significant differences between them. Of the 258 districts that were surveyed, 159 or 61.6% responded. The classification process yielded a split of 63% professional and 37% political in the statewide sample. The comparison of the performance indicators revealed small gains by the professional districts, occurring almost exclusively in the Regents component. In addition to the statistically significant differences that were observed, several other professional indicators tended to be generally higher than those of the political indicators. Within the various district categories, however, the classification and performance outcomes were mixed: (1)Â the urban sample had a preponderance of political boards with performance indicators that were generally lower than those of the professional boards; (2)Â the suburban sample had more professional boards with no statistically significant differences in performance between the two styles, but the political indicators were numerically higher than those of the professional group; and (3)Â the rural sample had more professional boards with higher performance indicators than the political group.},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=732003551&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

@article{RefWorks:226,
	author={M. Kent Jennings and Harmon Zeigler},
	year={1971},
	month={May},
	title={Response Styles and Politics: The Case of School Boards},
	journal={Midwest Journal of Political Science},
	volume={15},
	number={2},
	pages={pp. 290-321},
	abstract={Representation is conceptualized as the positive response of public bodies to constituency preferences. Interviews with members from a national sample of 88 school boards are used to explore two modes of responsiveness. Group responsiveness refers to articulated demands from organized interests; individualized responsiveness refers to informal, less structured preference expressions. Group responsiveness is positively affected by the district's social complexity and negatively by mass support for the board. Individualized responsiveness is negatively affected by social complexity and positively by mass support. Electoral factors mediate the effects of complexity and support. The bi-dimensional modes of responsiveness present different implications for theories of representation.},
	isbn={00263397},
