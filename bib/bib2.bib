@phdthesis{RefWorks:249,
	author={Russell Gordon Wiebe},
	year={1981},
	title={Teacher Involvement in School Board Elections},
	pages={189},
  school={University of Oregon},
	abstract={The purpose of this study was to investigate the political behavior of teachers in school board elections. Political action programs had been organized by teachers' associations in conjunction with the 1980 school board elections. The political action programs had three objectives: increase teacher voter turnout, encourage teacher political participation, and direct teacher votes to sympathetic candidates. Data were collected by questionnaire from 288 teachers located in two large, two medium, and two small school districts in the Province of Alberta. The stratified samples were representative of their populations with respect to sex, grade level, and teaching experience. Research Findings. The main political activity of teachers was persuading people to vote for preferred school board candidates. Some teachers displayed candidates' signs or campaigned on their behalf. A few donated money to candidates. Teacher political participation in school board elections did not appear related to: (1) teacher cohesiveness with their professional association; (2) teachers' perceived political role for the provincial teachers' association; (3) teachers' perceptions of community and administrative support for teacher political action; (4) school district size. Teacher political participation in school board elections appeared to be significantly related to six study variables. These findings suggested that politically active teachers were: (1) involved in their professional association; (2) involved in partisan politics; (3) more likely to be male teachers than female teachers; (4) above average in years of in-district teaching experience; (5) in strong agreement that members should undertake political action in school board elections; (6) more apt to be politically alienated toward their school board than politically neutral. Teacher voter turnout in school board elections was over ninety percent, a rate two to three times higher than the public-at-large. In five of the six districts surveyed the voting preferences of teachers and non-teachers were not different. Teachers in these districts appeared to have lacked direction from political leaders on how to vote. The voting preferences of teachers in one small district were significantly different than the voting preferences of nonteachers. Teachers in this district seemed cohesive with their association and appeared to have voted for candidates recommended by their political leaders.},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=751692711&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

@phdthesis{RefWorks:238,
	author={Barbara Klaymeier Wills},
	year={2003},
	title={The effect of the school board electoral system on demographic representation, election and service, community participation, school board member roles, and choice and achievement},
	pages={376},
  school={Florida State University},
	abstract={The primary purpose of this research study was to determine the effect of school board electoral system on demographic representation, election and service issues, community participation, school board member roles, choice opportunities, and the use of student achievement data. The data used for this research study is the result of a survey developed by University of Virginia researchers in coordination with the National School Board Association. The survey was mailed to approximately 2,000 of the nation's 14,890 school boards and 41% were returned (n = 827). This provided for a good representation of school boards and district governance across the country. State governments are becoming increasingly powerful in governing education and in leading reform efforts. Schools are also gaining more governing authority as school advisory committees and school based management maxims are spreading. Consequently, school boards find themselves losing in this shift of power, yet simultaneously being held accountable for student achievement and operational costs. As accountability becomes more important, it is increasingly imperative that the role of school boards in the education system be understood. The electoral system of school districts included in this study impacted the racial composition of school boards and superintendents. The use of single-member districts showed increased representation for African-Americans while at-large districts increased representation for Hispanics, women and other minorities. The researcher also found that efforts to address racial issues were increased in single-member districts. The electoral system effected training offered to school board members and the value of community student achievement data. Single-member districts offered more opportunities for school board member training, and value community survey data on student achievement more than board members from other electoral systems. Regarding whether committees were created to address various issues, and whether these committees included community participants, findings were mixed. Because of the variety of issues covered, from budgets to school closings, no pattern could be discerned. The level of concern over student performance was not effected by electoral system in this study. The school boards decision to offer school choice opportunities was not effected. However, single-member districts in this study did offer more types of school choice.},
	keywords={School administration; Political science},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=765247011&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

