@phdthesis{RefWorks:253,
	author={T. Pierce},
	year={2009},
  school={The Ohio State University},
	title={Political leadership and policy preferences: A case study of the Columbus City School District and its Board of Education},
	pages={355},
	abstract={The enduring debate over who governs schools continues largely because of methodological and analytical limitations related to the lack of accessible and relevant district level data. Informed by the literature on school governance, representation, and David Easton's (1965) systems analysis framework this dissertation explores the nature of school governance in the Columbus City School District located in Columbus, Ohio. This study sheds light on the historical evolution of school governance in the Columbus City School District, the structure of district governmental power, key actors in the governance process, the role of the Columbus Board of Education, the scope and character of board decision-making, and the impact of school governance decisions. This dissertation poses four primary research questions. Firstly, how do the Columbus Board of Education and its members learn the policy preferences of the community? Secondly, what type of representation do the Columbus Board of Education and its members provide the community? Thirdly, is the Columbus Board of Education responsive to the community? Fourthly, how does the structure of school governance processes affect decisions? The hypotheses are as follows. Hypothesis 1: In the Columbus City School District, the governance processes of the Columbus Board of Education limit local community governance of schools by decreasing and constraining opportunities for community engagement in school board governance processes. Hypothesis 2: The Columbus Board of Education and its members employ a trustee and symbolic style of representation and are not responsive to the local community because the structure of the decision-making process undermines the effective linkage between the school board and the community. This dissertation uses qualitative and quantitative methods of investigation to create a unique district level data set that captures the behaviors of key actors and the conditions of political environments surrounding school governance. It analyzes primary data from public and private documents of the Columbus Board of Education and the Columbus City School District; personal one-on-one interviews with Columbus Board of Education members, Columbus City School District staff members, and community leaders and activists; and secondary data from the content of newspaper articles. Data analysis methods include trend table analyses of inputs and outputs; descriptive and content analyses of personal interviews; descriptive and content analyses of documents from the Columbus Board of Education and the Columbus City School District; and policy analyses of the Win-Win Agreement and the Policy Governance Model. 1 Results indicate that the Columbus Board of Education and its members provide opportunities and ways for the community to participate in school governance. However, community inputs and feedback do not transfer into school board decisions. There is a historical and contemporary pattern of trustee and symbolic representation on the part of the Columbus Board of Education. This pattern of representation emanates from (1) inconsistent substantive communication between the Columbus Board of Education and the community and (2) the board's dependence on recommendations and information from superintendents. 1 The Win-Win Agreement is an annexation agreement between the Columbus Board of Education and surrounding school boards. Policy Governance is a detailed governance model the Columbus Board of Education uses to structure its governance processes and meetings.},
	keywords={School administration; Political science},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=1944488001&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

@phdthesis{RefWorks:228,
	author={R. Pittman},
	year={2011},
	title={Building a mosaic of trust: Identifying key antecedents of public trust toward improving school board performance},
	pages={176},
  school={Tennessee State University},
	abstract={The purpose of this mixed method study is to identify antecedents of trust building behavior toward establishing effective school board governance practices. The research question in this paper seeks to determine if there are differences in the way constituents perceive the trusteeship role in achieving the board's value proposition. This analytical case study focuses on a set of key reform strategies identified in literature as critical factors outside the school that support and sustain quality public education. The Civic Index, developed by Public Education Network, was used as the conceptual framework for the study. The selected key reform strategies were: (a) Education Leadership of Local Elected Officials, (b) Commitment to the Values of Tolerance and Inclusiveness, (c) Active Parents, (d) Strong Civic Organizations, (e) Utilization of School Performance Data to Improve School Quality, and (f) Media Coverage (Public Education Network, 2008a). Surveys administered to constituent citizens provided a focus for evaluating which areas were identified as antecedents of public trust. The study describes the value proposition formulated by the district at the time of the superintendent's arrival and the steps identified in the district's strategic plan that correlate to achievement of the board's vision. This work aimed to provide the district studied with useful findings that could be leveraged by the school board toward evaluating its own practice. This research adds to growing body of literature linking citizen participation to performance management among public agencies. School boards have not previously been addressed in trust theory literature; therefore, the study contributes to the broad body of knowledge by seeking to empirically measure levels of public trust that might explain motives for citizen engagement or disengagement from the nation's most ubiquitous government body. Results indicated that there was significant correlation between perceived levels of quality civic engagement and trust of the school board. Statistical analyses conducted using ANOVA to compare sampled populations showed that respondents differed in their trust levels of board members to listen to diverse stakeholders about providing public school options for all families.},
	keywords={School administration; Public administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=2365430451&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

@phdthesis{RefWorks:244,
	author={Rochelle Poyourow-Ripple},
	year={1990},
	title={A descriptive survey of school board member turnover and superintendent turnover in Pennsylvania, 1973-1987},
	pages={148},
  school={Temple University},
	abstract={The primary purpose of this study was to acertain if turnover rates for school board members in Pennsylvania significantly increased in the six years directly after implementation of PA Act 105 of 1978. Act 105 decreased the length of school board members' terms of office from six to four year terms. Another purpose of this study was to acertain if turnover rates for superintendents significantly increased as well after implementation of Act 105. In addition, this study compared differences between school board member turnover and superintendent turnover during the period under study, 1973 through 1987. This was a descriptive survey of existing records, providing information to the Pennsylvania School Boards Association (PSBA) to assess a policy change regarding length of school board term of office. In order to address the issue, average turnover rates for school board members and for superintendents were analyzed at each election year from 1973 through 1987, and tests of significant differences were made of turnover rates during those years. This encompassed four election cycles prior to and after implementation of Act 105. Turnover rates of school board members and superintendents corresponding to before and after implementation of the act were tested for significant differences. The population for this study consisted of nine school board members and one superintendent from each of the school districts in Pennsylvania (currently there are 501, prior to 1981, there were 504). Findings of the study were based on data collected by the PSBA after each school board election, (school board elections occur in odd-numbered years) and on a survey about superintendent turnover done by PSBA in 1988. The findings revealed no significant differences in turnover rates of school board members or of superintendents prior to or after implementation of Act 105. Length of term of office did not appear to affect the turnover rates of school board members or superintendents during that period. The second part of the study, dealing with differences between school board member and superintendent turnover indicated that school board members turned over at much greater rate than did superintendents between 1973 and 1987. A suggestion is made for future research to focus on reasons for school board member and superintendent turnover.},
	keywords={School administration},
