@phdthesis{RefWorks:237,
	author={Anita Schultz Bieler},
	year={1988},
	title={Effectiveness of Pennsylvania school boards, as perceived by board members and superintendents},
	pages={342},
  school={Lehigh University},
	abstract={The purpose of this study was to show whether specifically identified effective school board behaviors were present significantly more often in "effective" school boards than in "randomly selected" school boards. The school boards selected for this study were 10 "effective" boards and 10 "randomly selected" boards from various geographic areas of Pennsylvania. The nine board members and the superintendent from each board were asked to respond to the questionnaire. There were 131 respondents--69 "effective" board members and 62 "randomly selected" board members. An instrument was composed of statements from the literature and field tested with two pilot school boards. It was divided into three sections: (I) 14 inquiries about demographic data (II) 9 policy questions (III) 116 behaviors grouped in 10 performance categories. Results of the questionnaire were analyzed using a t-test to show significance at the.05 level. Several conclusions were inferred from the data of the study. There was a significant difference in the perceptions of performance between "effective" boards and "randomly selected" boards in: (1) Their orientation and continuing development functions; (2) The conduct of the meetings of their boards; (3) Their relationships with their superintendent; (4) Their legislative leadership functions; and (5) Their functions in all ten defined categories. There was no significant difference in the perceptions of performance between "effective" boards and "randomly selected" boards in: (1) Their fiscal management functions; (2) Their school-community relations and communications functions; (3) Their instructional management functions; (4) Their planning and goal setting functions; (5) Their staff relations functions; and (6) Their policy-making functions. There was no significant difference in: (1) The demography of the "effective" boards and the demography of all other Pennsylvania school boards. (2) The demography of the "randomly selected" boards and the demography of all other Pennsylvania school boards. (3) The demography of the "effective" boards and the demography of the "randomly selected" boards.},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=743953301&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

