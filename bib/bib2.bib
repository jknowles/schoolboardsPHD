@phdthesis{RefWorks:240,
	author={Melissa M. Deckman},
	year={1999},
  school={The American University},
	title={Christian soldiers on local battlefields: Campaigning for control of America's school boards},
	pages={362},
	abstract={This dissertation explores the impact of the Christian Right on school board elections by conducting a national survey and two case studies. This study considers how elements from the four major political participation models--the socioeconomic status (SES) model, the rational choice model, the contextual model, and the mobilization model--help to explain why, when, and how conservative Christians run for school board. The major political participation models used by political scientists tend to overlook the contributions that religion makes toward explaining the political behavior of certain individuals. By considering how certain religious variables often neglected by political scientists relate to each of the models, this study sheds new light on how religion inspires citizens to participate in politics and when and how they do it. The study finds that in at least two of the political participation models, religion enhances their explanatory power when it comes to the case of Christian Right school board candidates. The study finds that Christian Right candidates are significantly more likely than non-Christian Right candidates to link their religious convictions to their decision to become school board candidates. In this sense, conservative Christians are more likely to derive religious "purposive benefits" from their participation, as the rational choice model would argue. Religion also relates to the contextual model of political participation if one is willing to consider the church as a social "context." This study finds that the church plays a more important role in the lives of Christian Right candidates than non-Christian Right candidates. From a contextual model perspective, the church life of Christian Right candidates facilitates an environment that both raises awareness about local issues and offers support for those members who wish to address these issues in the political arena. Religion adds little to the two remaining models of political participation. Particularly disappointing is the performance of the mobilization model. This study finds that Christian Right organizations play little role in motivating or assisting conservative Christians in their bids for school board office.},
	keywords={Political science; School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=730341171&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

@phdthesis{RefWorks:233,
	author={K. DeKoninck},
	year={2009},
	title={A study of the factors contributing to long-term relationships between school boards and superintendents},
	pages={83},
  school={Indiana State University},
	abstract={The purpose of the research study was to identify those factors contributing to long-term-relationships between school boards and superintendents. The primary focus of the study was about how conflict is resolved between superintendents and school boards. There were school districts where superintendents have chosen to and were allowed to lead for a long period of time. What factors led to this long term relationship? Other districts can use this information to help their school boards form a philosophy to sustain long-term relationships with the primary educational leader in the school community. School boards, communities, and superintendents can look at these factors and use them as the blueprint to positively impact the educational system in their school community. Five of the longest serving superintendents in Marion County, Indiana and the immediate surrounding counties were identified. Those five superintendents were then asked to choose a long-serving board member who would have a level perspective on the school board-superintendent relationship. Once identified, board members and superintendents were interviewed to determine those factors leading to the long-term relationship. After researching the current literature and then corroborating the literature review results with interview questions, the researcher was able to assess those factors leading to long-term relationships between school boards and superintendents. Those factors can be found in the following statements: (1) There were common reasons why relationships between school boards and superintendents endured. (2) When conflict happened, there were common reasons why a positive resolution occurred. (3) Conflict was usually resolved, leaving little or no underlying conflict as a foundation for future discord. (4) The informal evaluation of the superintendent was an agreed upon process that promoted a common understanding of the board's direction to the superintendent. There was also a formal evaluation process utilized but both superintendents and board members agreed that it was not as effective and helpful as the informal formative evaluation. (5) There were common personality and work qualities that school boards sought out and expected superintendents to possess. The literature review and accompanying interviews also helped answer the Grand Tour questions that ultimately prompted the research to determine those factors leading to long-term relationships between school boards and superintendents. The answers to the Grand Tour questions follow: (1) School boards and superintendents have similar views of conflict. (2) When conflict occurs, school boards and superintendents have similar views on how to resolve them.},
	keywords={Educational leadership; School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=1970012911&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

@phdthesis{RefWorks:248,
	author={Richard Byam {Dunn Jr.}},
	year={1981},
	title={Voter Registration and Turnout in School Board Elections: Theoretical Bases},
	pages={129},
  school={Stanford University},
	abstract={The behavior of voters has attracted the interest of researchers for many years. Until recently, however, research into voter behavior was limited to empirical findings, and lacked theoretical bases. Also until recently, this research treated voting as a single behavior, instead of regarding the act of registration as being separate from the act of casting a ballot. One purpose of this study was to start to rectify these deficiencies. The second purpose of this study was to examine voter behavior in school board elections. Since almost all studies of voter behavior have focused on national or state level elections, little is known about voter behavior in low saliency, local level school elections. In this study, two theoretical models of registration and voting behavior were developed and tested, through multiple regression analysis, to see which model best predicted variations in registration and turnout rates in the 1971 school board elections in 119 California unified school districts. An economic rationality model was derived from the theory developed by Anthony Downs in 1957, which based on the assumption that a person registers or votes when he perceives that the costs outweight the benefits in each act. The variables which were entered into the regression equations to test this model were those which were situational in nature and which would affect this cost-benefit equation. In contrast, a social conditioning model was developed which was based on the assumption that a person registers or votes because of long-term social conditioning, and that costs and benefits are not considered in making a decision to register or vote. It was hypothesized that people tend to register more on the basis of social conditioning than on the basis of economic rationality; but that they tended to actually vote more on the basis of economic rationality than on social conditioning. Since the data used in this study were aggregated by school district, definite conclusions could not be drawn about these hypotheses of individual behavior. However, assuming the aggregate data approximated individual behavior, it was found that the social conditioning model explained about half of the variation in registration rates, while the economic rationality model did not seem to be of any practical use in explaining variations in voter registration. The conclusions with regard to voter turnout in school board elections were less definite. In support of the second hypothesis, the social conditioning model was useless in predicting variations in voter turnout. The economic rationality model did a better job of predicting variations in voter turnout rates, but even this model explained only a quarter of the variation. Thus, it cannot be asserted that this is a particularly useful prediction model. The findings of this study seem to lend further support to other recent research which indicates that variations in voter registration can be explained to a significant degree by social conditioning factors, while variations in voter turnout rates in elections at all levels remain more elusive to explanation by social scientists. The findings of this study, even though based on aggregate data, also seem to cast futher doubt on the validity of earlier voting research which, by neglecting to separate the act of registering from the act of voting itself, concluded that socioeconomic factors such as education, income, or racial-ethnic background influenced voter turnout. Instead, this study seems to reinforce the findings of more recent researchers who conclude that these socioeconomic factors may affect voter registration but not whether people vote once they are registered.},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=751631061&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

@article{RefWorks:224,
	author={Thomas R. Dye},
	year={1967},
	month={Aug.},
	title={Governmental Structure, Urban Environment, and Educational Policy},
	journal={Midwest Journal of Political Science},
	volume={11},
	number={3},
	pages={pp. 353-380},
	abstract={Research on 67 large cities assesses the impact of the structure of city school systems on educational outcomes, and compares the effect of structural variables on educational outcomes with the effect of urban environmental variables. Structural variables include the method of selecting school board members and school tax assessors, the degree of city government control over school budgets, and the structure of city government. Educational outcomes include school expenditures and taxes; local financial support; teachers' salaries, turnover, and qualifications; teacher-pupil ratios; drop-out rates, and private school enrollment. In general, environmental variables, including wealth, white collar employment size, property value, and racial composition, were more closely associated with educational policies than structural variables.},
	isbn={00263397},
	language={English},
	url={http://www.jstor.org/stable/2108617}
}

