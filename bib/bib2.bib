@phdthesis{RefWorks:241,
	author={William D. Barr},
	year={2000},
	title={School board elections: An assessment of voting models for achieving representational equality in school districts of Monterey County},
	pages={158},
  school={University of La Verne},
	abstract={Problem and purpose . Since the birth of this nation, the principles of representation and the parameters of suffrage have been subjects of close and heated examination. The expansion of the right to vote and accordingly, the right of equal representation, have been a continuous and often acrimonious proposition. Minority citizens can experience a form of voter discrimination as a result of underrepresentation on elected bodies. The purpose of this study was to assess legally permitted voting models for achieving equitable representation on school boards in Monterey County. Methodology . Using policy analysis and a multiple inquiry approach, a panel of experts developed criteria that determine equitable representation. Using a five-round Delphi process the panel rated, ranked, and then force ranked the criteria. A qualitative trade-off analysis was used to assess which legally permitted voting model best achieves the highest-ranked criteria that determine representational opportunities in school board elections. Findings . The Delphi panel established fourteen criteria as the most important criteria in determining equitable representation. It also validated that there are three legally permitted voting models for California public school districts. When comparing which voting model best achieves the established criteria, voting model "B" (lives in trustee area--elected by trustee area) received the highest number of choices. Closer analysis, however, identified that two distinct clusters of criteria had emerged, one being a set best describing effective leadership and one being a set best describing representational equality. The set best described as effective leadership clearly had a preponderance of choices for no particular voting model advantage. The set best describing representational equality clearly had a preponderance of choices for voting model "B." Conclusions and recommendations . The study found that when a group of voters is seeking to achieve equitable representation, it is best accomplished through a broad-based community group using a reliable process of multiple inquiry to identify the criteria that the entire jurisdiction determines as equitable representation. All legally available voting models should then be assessed against the criteria to determine which model best achieves representational equality.},
	keywords={School administration; Political science},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=728358931&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

@phdthesis{RefWorks:254,
	author={Lisa Varney Beckwith},
	year={1994},
	title={An analysis of the perceptions of school board members and community influentials toward school policy},
	pages={197},
  school={Northern Illinois University},
	abstract={The current system of school governance is designed to enable school board members to serve as the policy-making agency and provide governance to school districts. The trend in school governance has been away from the effective management role boards of education are charged with, which is policy making, toward a role of involvement in administering and implementing policy. The importance of this study was to analyze the desired levels of involvement of community and parent committees, public hearings, administrators, superintendents, and boards of education in school district decision making in Illinois public schools. The school district decision making was examined in two main management areas: (a) the internal management issues of curriculum, personnel, and student services; and (b) the external management issues of community relations, finance, and buildings. This research was descriptive in nature. The sample of the study consisted of influential community members across the state of Illinois and board of education members from randomly selected public school districts in the State of Illinois. The study indicated that board of education members want to micromanage school district decisions. Board members desired involvement in school district decisions at the same level as the superintendent and certainly more than the administration in the district. Influential community members also believed the board should be involved in decision making but at a lower level than board members. Board members and influential members rejected the involvement of public committees, parent committees, and public hearings. Exceptions to the desired lack of involvement included decisions relating to overt educational philosophy, discontinuing an inter-scholastic sport, student dress code, school closing, and internal boundary adjustments. These exceptions, however, indicated only a moderate interest over the other decisions. The demographic data showed that when compared by district type, elementary school board members expressed a stronger desire than unit or high school district board members to involve public committees, parent committees, and public hearings. There were no differences found in desired involvement between male and female board members and influentials. Influentials from small towns indicated that the superintendent and board members should be less involved in decision making than the large town respondents.},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=741365361&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

