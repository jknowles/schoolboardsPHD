@phdthesis{RefWorks:252,
	author={Kate Steuart Woodward},
	year={1986},
	title={The Impact of Reorganization on School District Governance and Political Participation in a Centralized, Rural, New York State School District},
  school={Cornell University},
	pages={267},
	abstract={This case study examines a New York State central school district from the time of reorganization in the late 1960's until 1985. The focus of the research was the evolution of the style of governance and the community's participation in the processes of governance. Citizens in the school district community rejected a referendum for reorganization in the early 1960's before narrowly approving a second referendum in 1968. With the narrow margin of approval came a legal challenge to the reorganization vote. This is a study of political activity surrounding and following the period of reorganization. It examines the period of intense controversy during which time the community residents became deeply embroiled in the challenge to the formation of the new school district. The research traces the pattern of governance and the level of political activity from the time of centralization until the present. It seeks to determine relationships between the decision to reorganize, the challenge to that decision, and the subsequent mode of governance adopted by school boards and administrators. The study also examines the level and type of political participation in the school district over the eighteen year period. The evolution of the pattern of governance was examined against the framework of two theoretical models of governance: dissatisfaction theory and universal continuous competition theory. The findings of the research lead to the conclusion that the process of reorganization does have an impact on the style of governance adopted by the administration and the boards of education. The findings further support the conclusion that the level and type of political participation are affected by the particular style of governance. The site studied in this research does not fit the pattern of governance suggested by dissatisfaction theory. Several factors support this conclusion and are discussed in the final chapter. Continuous competition theory provides a more complete explanation of what occurred in this particular school district, but there are some significant differences between what competition theorists contend should be evident and what, in fact, was evident. These differences are discussed in the final chapter.},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=749116151&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

@phdthesis{RefWorks:257,
	author={M. Susan Workman},
	year={2003},
	title={An analysis of the perceptions of superintendents and school board members regarding the ability of the school board to effectively govern in local districts},
  school={Northern Illinois University},
	pages={108},
	abstract={The purpose of this study was to examine the perceptions of superintendents and school board members regarding the ability of the board to effectively govern their local school district. The study examined specifically six areas of effectiveness: making decisions, functioning as a group, exercising authority, connecting to the community, working toward board improvement, and acting strategically. Data were collected from a survey distributed to 59 school districts in the Illinois School Board Divisions of Blackhawk, Central Valley, Kishwaukee, Starved Rock, and Three Rivers. Demographic information was collected on gender, level of education, length of service on the board, other superintendent or board positions held, whether board members were elected or appointed, and enrollment of the district. The findings of this study suggested that the perceptions of superintendents and boards were in agreement with each other's responses for 55 questions and significantly disagreed on 16 questions. The board and superintendents showed more significant disagreement on questions that addressed decision making, functioning cohesively as a group, exercising authority, and working toward board improvement. The findings showed that superintendents and board members agreed more on connecting to the community and acting strategically. Consistent with the literature, these results supported the major efforts that are needed for school boards and superintendents to develop a positive working relationship. Communication and information sharing must occur for this relationship to be effective. Clearly defining roles and responsibilities allows both the board and the superintendent to perform their duties in order to serve the school district effectively. The ability of the board and superintendent to engage in self-evaluation of current governance practices, to have deliberate dialogue regarding governance, to identify the strengths and needs, to develop in implement an action plan and then finally self-evaluate the plan is critical to the success of the district.},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=764817481&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

@phdthesis{RefWorks:243,
	author={Abraham Hua-Chung Wu},
	year={1995},
  school={Stanford University},
	title={Lobbyists, legislators, and voters: Models and tests of strategic behavior},
	pages={100},
	abstract={The nature of American politics raises intriguing questions about the mechanisms and extent of interest-group and voter influence in the policymaking process. The relationships among lobbyists, legislators, and voters are often complicated by informational asymmetries and the exchange of resources--legislators rely on contributions and information supplied by self-interested groups to run for reelection and make policy decisions that affect the welfare of group members, and voters decide the political futures of incumbent officeholders when information about their prior performance is limited or unavailable. This dissertation examines these issues in three essays. Two of these essays model phenomena observed in the diverse worlds of lobbyist-legislator interactions and local school board elections, and a third empirically tests alternative theories of interest group influence. Recent literature has focused on both campaign contributions and lobbying as instruments of interest group influence over public policy. Some works argue that contributions buy votes or influence legislators' participation decisions during the policymaking process, while others suggest that lobbying efforts are the primary mechanism of group influence. The essay "Contributions, Lobbying, and Participation" examines the importance of contributions and lobbying in legislators' participation decisions during markup sessions of the 1985 Farm Bill. If legislators use information supplied by lobbyists in making policy decisions, then self-interested groups have incentives to distort that information. Legislators might limit such manipulation by rewarding groups who prove themselves to be trustworthy providers of information today with opportunities to influence policies tomorrow, and conversely punishing groups who abuse their current positions of access by removing the possibility of future interactions. The essay "Which Horse to Ride" examines the complications associated with using the conditional granting of future rewards as a means of controlling groups' short-term incentives to distort information by modeling the interaction between lobbyists and legislators in a two-period game of incomplete information. Similarly, "The Electoral Control of School Boards" develops a game-theoretic perspective on control under conditions of limited information. It examines the mechanisms by which voters incompletely informed about board member preferences exert control over school board policy.},
	keywords={Business community; Political science; Public administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=741750911&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

