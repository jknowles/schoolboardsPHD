@phdthesis{RefWorks:251,
	author={Richard George Hess},
	year={1994},
	title={A study of school board/community organizational structures and superintendent leadership styles},
	pages={147},
  school={The University of Wisconsin - Madison},
	abstract={Little research has been conducted since the mid-1960's and early-1970's regarding relationships among community power structures, school board power structures, and superintendent leadership styles as inter-related depending upon the roles of the community and school board. School boards, communities, and superintendent leadership styles are compared in isolation of one another. Superintendent leadership styles, in particular, are limited to analysis in relation to size of the school district, type of communities, or situations facing the school district. The intent of this study is to determine the role of the superintendent, school board, and community in the current educational environment. Analysis of the relationships between these three units in the State of Wisconsin will determine the extent to which the behavior of the superintendent is matched with the school board and community power structures. In addition, demographic information provides the basis for additional analysis and comparisons. An instrument has been designed which will attempt to define relationships between community power structures, school board power structures, and superintendents' leadership styles. Behavior questions assigned to four categories of each unit were sent to the superintendent of each school district in the State of Wisconsin. The superintendent was asked to react to these behaviors according to observations over time. The population to be surveyed in the study consisted of all superintendents in the State of Wisconsin. A pre-test was given to eight superintendents who represent each of four separate community groups--large urban, small urban, suburban, and rural. Reliability was checked by using University of Wisconsin professors, superintendents, and school board members as a panel of experts. The significance of the study lies in verifying whether and what kinds of statistically significant relationships exist among communities, school boards, and superintendents. No current studies have attempted to explain relationships in this manner. While this study replicates previous research, it attempts to verify through quantitative rather than qualitative analysis relationship behaviors of community leaders, school board members, and superintendents. Analysis of this data will provide prospective school superintendents with the ability to analyze their leadership styles. The data will also indicate whether current superintendents' leadership roles are compatible with the power structures of their school districts and communities.},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=746564101&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

