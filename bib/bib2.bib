@phdthesis{RefWorks:235,
	author={Rebecca Ann Silverman Howard},
	year={1982},
  school={University of Minnesota},
	title={A Comparison of City Councils and School Boards on Selected Dimensions of Governance Processes},
	pages={301},
	abstract={The literature on school politics contains two opposing views on the political performance of school boards. Critics argue that because school boards have failed to be responsive, accountable, political institutions, professional educators have too much control over educational decisions. The opposing view is that school boards perform their political function adequately and at least as well as any other unit of government. This dissertation attempts to provide insight into this dilemma by studying political relations between school boards and the public and between boards and administrators. The dissertation's central problem is to define dimensions which permit an evaluation of the political performance of school boards, to rank school boards on these dimensions, to interpret the meanings of the rankings, and to offer possible explanations for the rankings. The eight dimensions on which the evaluation is based are responsiveness, accountability, partisanship, professionalization, contentiousness, visibility, influence distribution, and autonomy. Since there is no standard of democratic performance against which to measure school boards' performance on these dimensions, the design of this study is a comparison of the rankings of school boards and city councils on the eight dimensions. Two midwestern cities of comparable size and complexity, Weston and Easton, provide the setting for the study. In each city, the areas served by the school board and the city council are coterminous. The first step in the design of the study was to develop the dimensions based on literature in school and city politics, especially that of Zeigler (1974) and Eulau (1972). Next, interview questions for each dimension were developed and pilot tested. Interviews were conducted in June 1979 with council members and board members. Data analysis involved tabulating closed ended responses and developing coding categories for open ended responses. Data were grouped according to analytic dimensions and variables and presented in data tables for each question. Summaries of variables, with relative rankings of each political unit on each variable, made possible comparisons across dimensions and across institutions. Councils ranked higher than boards on the responsiveness variables of accessibility, participation, responsiveness norms, and responsive behavior. . . . (Author's abstract exceeds stipulated maximum length. Discontinued here with permission of author.) UMI},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=751734591&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

