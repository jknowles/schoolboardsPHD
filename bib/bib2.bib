@article{RefWorks:189,
	author={Deborah A. Verstegen and Richard A. King},
	year={1998},
	month={Fall},
	title={The relationship between school spending and student achievement: a review and analysis of 35 years of production function research},
	journal={Journal of Education Finance},
	volume={24},
	number={2},
	pages={243-262},
	note={PD: Bibliography},
	abstract={A study examined the relationship between school spending and student achievement. Data were obtained from a review of production function research since the 1960s. Positive relationships were found among teachers' verbal ability, experience, salary, and student achievement. Therefore, school improvement could be facilitated by using mechanisms to recruit, retain, and develop those teachers with strong verbal abilities and to help teachers to improve their skills in communicating their subject fields with students. The results also showed a positive relationship between class size and student achievement, suggesting that efficiency may be enhanced by reductions in student-teacher ratios and by heterogeneous grouping. The results provided a clear indication of the relationship between school funding and achievement, as the factors that improve achievement are those that increase the cost of instruction. Implications of the results are discussed.},
	keywords={School finance/Research; Student achievements/Research; Education},
