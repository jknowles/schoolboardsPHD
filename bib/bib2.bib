@phdthesis{RefWorks:262,
	author={Stanley George Terzopolos},
	year={1996},
	title={Preferences of Pennsylvania school board presidents toward local control and activities boards initiate to influence legislation and manage interest group issues},
  school={Lehigh University},
	pages={163},
	abstract={The purpose of this study was to determine if Pennsylvania school board presidents were concerned over issues of governance and/or local control, and, if such concern existed, to identify the political actions boards used to protect or advocate their particular interests. Four dependent variables were examined: local control, interest group pressure, political activities, and preferences for a future state/school board relationship. The population of Pennsylvania school board presidents was surveyed. One-hundred-fifty-five returns were received providing a response rate of 31% of the population and 62% of the intended sample. The dependent variables were matched to seven independent variables using the chi-square $(X\sp2)$ statistic. The independent variables were: district type, district enrollment, district aid ratio; board president age, gender, years as a board member and years as a board president. Board presidents were also asked to list the top three mandates from which their boards desired relief and to list the political activities their boards used to communicate their positions. One of the major findings of this study was that a statistically significant relationship was observed between the variables of future state/board relationship and district type. Suburban districts were more supportive of increased state control than were other district types. A second major finding was that a strong statistical relationship was observed between the variables of interest group pressure and board president age. Among respondents over 50 years of age, fewer disagreed their boards were affected by interest groups than did those respondents who were less than 50 years old. Generally, among the four dependent variables, political activism received a mean indicating the highest level of support among all respondents. However, when the frequency and success indicators for the respective political activities were examined, it was learned that Pennsylvania school boards, despite their strong interest in political activism, were not engaging in political activities beyond those which would be considered typical for most school districts in general. Support for local control received a mean value that was second highest among the four research variables. Finally, an examination of those state mandates from which local boards desired relief revealed that two of the three mandates board presidents identified for relief (Prevailing Wage Act and Sabbatical Leave) were included in the Pennsylvania School Boards Association's list of four legislative priorities for 1996. Those priorities were: (a) relief from the impact of the Prevailing Wage Act, (b) opposition to compulsory binding arbitration during contract negotiations, (c) abolition of the statutory entitlement to sabbatical leaves, and (d) opposition to tuition tax credits or vouchers to non-public schools.},
	keywords={School administration},
	url={http://ezproxy.library.wisc.edu/login?url=http://proquest.umi.com/pqdweb?did=739420661&Fmt=7&clientId=12286&RQT=309&VName=PQD}
}

