@ARTICLE{1964,
  author = {Norman D. Kerr},
  title = {The School Board as an Agency of Legitimation},
  journal = {Sociology of Education},
  year = {1964},
  volume = {38},
  pages = {pp. 34-59},
  number = {1},
  abstract = {Although school boards are elected to represent the community to the
	school administration, there is a variety of circumstances which
	convert the school board into an agency which legitimates the goals
	of the school administration. The conditions which promote this displacement
	of goals are described by reference to survey studies of school boards
	and, particularly, to observations and interviews conducted by the
	author in two suburban school systems over a period of a year. School
	board politics, the process of socialization onto the board, and
	community pressures are the main sources of goal displacement which
	are discussed in detail. A flow-chart (Figure 1) summarizes the influences
	found to be most critical. The conversion of school boards into legitimating
	agencies is viewed as a mechanism for reducing the threats to the
	institutional security of school systems which come from this environment.},
  copyright = {Copyright ? 1964 American Sociological Association},
  issn = {00380407},
  jstor_articletype = {research-article},
  jstor_formatteddate = {Autumn, 1964},
  language = {English},
  publisher = {American Sociological Association},
  url = {http://www.jstor.org/stable/2111817}
}

@ARTICLE{Krebs01111999,
  author = {Timothy B. Krebs},
  title = {The Political and Demographic Predictors of Candidate Emergence in
	City Council Elections},
  journal = {Urban Affairs Review},
  year = {1999},
  volume = {35},
  pages = {279-300},
  number = {2},
  abstract = {Legislative scholars have shown that candidates emerge when political
	conditions are most favorable. The topic of candidate emergence in
	city council elections is addressed using data collected on all 50
	of Chicago?s wards from 1979 to 1995. The results show that wards
	with open seats or vulnerable incumbents on the ballot generally
	have a larger and more politically experienced crop of candidates
	than other wards. The findings also reveal that wards with higher
	concentrations of black residents have significantly larger and more
	politically experienced candidate pools than wards with fewer blacks.
	Explanations for these findings are discussed.},
  doi = {10.1177/10780879922184383},
  eprint = {http://uar.sagepub.com/content/35/2/279.full.pdf+html},
  url = {http://uar.sagepub.com/content/35/2/279.abstract}
}

