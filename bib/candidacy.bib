@article{2007,
 jstor_articletype = {research-article},
 title = {Black-Brown Coalitions in Local School Board Elections},
 author = {Rocha, Rene R.},
 journal = {Political Research Quarterly},
 jstor_issuetitle = {},
 volume = {60},
 number = {2},
 jstor_formatteddate = {Jun., 2007},
 pages = {pp. 315-327},
 url = {http://www.jstor.org/stable/4623832},
 ISSN = {10659129},
 abstract = {As the racial composition of the United States becomes increasingly diverse, scholars have begun to examine whether interminority, or rainbow, coalitions are feasible. The power thesis suggests that lower levels of social distance between Anglos and Latinos will make the formation of Anglo-Latino coalitions more likely than black-Latino coalitions. This hypothesis is reexamined using fifteen hundred school board election results. The findings offer little evidence for the formation of Anglo-Latino coalitions. There are, however, indications that Anglo-black coalitions form when an area becomes populated by Latino noncitizens, possibly due to the increased social distance this causes between Latinos and other racial/ethnic communities.},
 language = {English},
 year = {2007},
 publisher = {Sage Publications, Inc. on behalf of the University of Utah},
 copyright = {Copyright ? 2007 University of Utah},
}

