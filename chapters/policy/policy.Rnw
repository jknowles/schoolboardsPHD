\subsection{Student Outcomes}

\subsection{Superintendent Turnover}

<<newSup, results='asis'>>=
modeldata <- dist_turn[, c("distid", "year", "incsDefeated", 
                           "MATH_PROFADV_PER", "NEW_SUP", "SUP_EXPERIENCE",
                           "econ_disadv_per", "VAP_adj", "per65o", 
                           "PerBachelorOrAbove", "locale2")]
modeldata$incsDefeatedFac <- ifelse(modeldata$incsDefeated > 0, 1, 0)
modeldata$incsDefeatedFac <- factor(modeldata$incsDefeatedFac)
preTreat <- modeldata[modeldata$year <= 2010,]
preTreat$year <- preTreat$year + 2
names(preTreat) <- paste(names(preTreat), "lag", sep = "_")
modeldata <- modeldata[, c("NEW_SUP", "distid", "year")]
modeldata <- merge(modeldata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))
modeldata <- modeldata[modeldata$year > 2005, ]
modeldata$SUP_EXPERIENCE_lag <- ifelse(is.na(modeldata$SUP_EXPERIENCE_lag), 0, 
                                       modeldata$SUP_EXPERIENCE_lag)

simpModSup <- glm(NEW_SUP ~ incsDefeatedFac_lag + locale2_lag, 
                  data = modeldata, family = "binomial")
simpModSup$se <- sqrt(diag(get_CL_vcov(simpModSup, modeldata$distid)))
fullModSup <- glm(NEW_SUP ~ incsDefeatedFac_lag + econ_disadv_per_lag + 
                   log(VAP_adj_lag) + locale2_lag + PerBachelorOrAbove_lag + 
                   per65o_lag, data = modeldata, family = "binomial")
fullModSup$se <- sqrt(diag(get_CL_vcov(fullModSup, modeldata$distid)))
library(arm)
fullModSupFE <- bayesglm(NEW_SUP ~ incsDefeatedFac_lag + 
                      econ_disadv_per_lag + log(VAP_adj_lag) + 
                      locale2_lag + PerBachelorOrAbove_lag + 
                   per65o_lag + distid, data = modeldata, family = "binomial")
fullModSupFE$se <- sqrt(diag(get_CL_vcov(fullModSupFE, modeldata$distid)))

apsrtable(simpModSup, fullModSup, fullModSupFE, se = "robust", 
          stars = "default", digits = 3, 
          model.names = c("Simple", "Full", "Fixed Effect"), 
          caption = "Incumbent Defeat and Student Scores", 
          label = "tab:readMod", notes = list(stars.note), 
          Sweave = TRUE, 
           omitcoef=list("distid", 
                         expression(grep("distid", coefnames, value=TRUE))))
@


