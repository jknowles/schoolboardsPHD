@


Table \ref{tab:readMod} shows relatively little effect of school board incumbent 
defeat on student proficiency rates. In the simple model, there appears to be a 
slight negative effect on student scores after an incumbent is defeated. However, 
this effect disappears when including a lagged dependent variable or district 
fixed effect, and the sign switches. The model also has a very small $R^{2}$ and 
the inclusion of indicators of district economic disadvantage and fixed effects 
or the lagged dependent variable pushes the $R^{2}$ to 0.85 to 0.9. 

The substantive impact of the most generous estimate in the first model in Table 
\ref{tab:readMod} is equivalent to a reduction in 0.3\% in the percentage of 
students in a school district that are proficient or advanced. This is approximately 
0.036 of a standard deviation. 

Table \ref{tab:mathMod} shows the results for math proficiency rates. Again, 
the effect of incumbent defeat is significant and negative in the first model, 
but that effect is erased in the lagged and fixed effect models. The first model 
has a very small $R^{2}$, but the lagged and FE models have a much higher $R^{2}$ 
with economic and unobservable characteristics explaining most of the variance 
in student performance. 

The substantive impact here is again small, but larger than that found on the reading 
models in Table \ref{tab:readMod}. Here the reduction due to school 
board incumbent defeat is equivalent to a reduction of the percentage proficient 
or advanced at math in the district of 1.4\%. This is a much larger effect than 
that measured in the reading models, about 0.13 of a standard deviation. 

<<testScoresM, results='asis'>>=
modeldata <- dist_turn[, c("distid", "year", "incsDefeated", "servingMembers",
                           "MATH_PROFADV_PER", "NEW_SUP", "SUP_EXPERIENCE",
                           "econ_disadv_per", "VAP_adj", "per65o", "challengRate",
                           "PerBachelorOrAbove", "locale2", "dissatFactor")]
modeldata$MATH_PROFADV_PER <- log(modeldata$MATH_PROFADV_PER*100)
modeldata$incsDefeatedFac <- ifelse(modeldata$incsDefeated > 0, 1, 0)
modeldata$incsDefeatedFac <- factor(modeldata$incsDefeatedFac)
preTreat <- modeldata[modeldata$year <= 2010,]
preTreat$year <- preTreat$year + 2
names(preTreat) <- paste(names(preTreat), "lag", sep = "_")
modeldata <- modeldata[, c("MATH_PROFADV_PER", "distid", "year")]
modeldata <- merge(modeldata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))
modeldata <- modeldata[modeldata$year > 2005, ]
modeldata$SUP_EXPERIENCE_lag <- ifelse(is.na(modeldata$SUP_EXPERIENCE_lag), 0, 
                                       modeldata$SUP_EXPERIENCE_lag)

simpModMath <- lm(MATH_PROFADV_PER ~ incsDefeatedFac_lag + locale2_lag + 
                    servingMembers_lag + log(VAP_adj_lag), 
                  data = modeldata)
simpModMath$se <- sqrt(diag(get_CL_vcov(simpModMath, modeldata$distid)))
lagModMath <- lm(MATH_PROFADV_PER ~ incsDefeatedFac_lag + econ_disadv_per_lag + 
                   MATH_PROFADV_PER_lag +servingMembers_lag+
                   log(VAP_adj_lag) + locale2_lag + PerBachelorOrAbove_lag + 
                   per65o_lag, data = modeldata)
lagModMath$se <- sqrt(diag(get_CL_vcov(lagModMath, 
                   modeldata$distid[!is.na(modeldata$MATH_PROFADV_PER_lag)])))
lagModMathFE <- lm(MATH_PROFADV_PER ~ incsDefeatedFac_lag + econ_disadv_per_lag + 
                   log(VAP_adj_lag) + locale2_lag + PerBachelorOrAbove_lag + 
                  servingMembers_lag+  per65o_lag + distid, data = modeldata)
lagModMathFE$se <- sqrt(diag(get_CL_vcov(lagModMathFE, modeldata$distid)))

prettyNames <- c("Intercept", "Inc. Def. Lag", "Exurb", "Rural", "Board Size",
                 "ln(VAP)",
                 "FRL \\%", "Prof Rate Lag", "\\% Bach. +", 
                 "\\% Over 65")

fe.note <- "District fixed effects not displayed."

apsrtable(simpModMath, lagModMath, lagModMathFE, se = "robust", 
          stars = "default", digits = 3, model.names = c("Simple", "Lag", "FE"), 
          caption = "Incumbent Defeat and Math Proficiency Rates", 
          label = "tab:mathMod", notes = list(stars.note, fe.note), 
          Sweave = FALSE, 
           omitcoef=list("distid", 
                         expression(grep("distid", coefnames, value=TRUE))), 
          coef.names = prettyNames, size = "small")
@


