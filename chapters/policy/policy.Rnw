Table \ref{tab:gradMod} shows the results for graduation rates. Although I expected 
to find a stronger effect of school boards on graduation rates, there is weaker 
evidence here. The estimated effect is consistently negative -- counter to 
expectations -- but is not statistically significant. The effect is substantively 
equivalent to a decrease of 0.18\% in the graduation rate, an effect of 
0.03 standard deviations. 

% HSC 
<<hscModel, results='asis'>>=
modeldata <- dist_turn[, c("distid", "year", "incsDefeated", "servingMembers",
                           "gradRate", "NEW_SUP", "SUP_EXPERIENCE", "challengRate",
                           "econ_disadv_per", "VAP_adj", "per65o", "dissatFactor",
                           "PerBachelorOrAbove", "locale2")]
modeldata <- modeldata[modeldata$gradRate > 0, ]
modeldata$gradRate <- log(modeldata$gradRate)
modeldata$incsDefeatedFac <- ifelse(modeldata$incsDefeated > 0, 1, 0)
modeldata$incsDefeatedFac <- factor(modeldata$incsDefeatedFac)
preTreat <- modeldata[modeldata$year <= 2010,]
preTreat$year <- preTreat$year + 2
names(preTreat) <- paste(names(preTreat), "lag", sep = "_")
modeldata <- modeldata[, c("gradRate", "distid", "year")]
modeldata <- merge(modeldata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))
modeldata <- modeldata[modeldata$year > 2005, ]
modeldata$SUP_EXPERIENCE_lag <- ifelse(is.na(modeldata$SUP_EXPERIENCE_lag), 0, 
                                       modeldata$SUP_EXPERIENCE_lag)

simpModGrad <- lm(gradRate ~ incsDefeatedFac_lag + locale2_lag + 
                    servingMembers_lag + log(VAP_adj_lag), 
                  data = modeldata)
simpModGrad$se <- sqrt(diag(get_CL_vcov(simpModGrad, 
                                        modeldata$distid[!is.na(modeldata$gradRate)])))

lagModGrad <- lm(gradRate ~ gradRate_lag + incsDefeatedFac_lag + servingMembers_lag+
                   log(VAP_adj_lag) + locale2_lag + PerBachelorOrAbove_lag + 
                   per65o_lag, data = modeldata)
lagModGrad$se <- sqrt(diag(get_CL_vcov(lagModGrad, 
                   modeldata$distid[!is.na(modeldata$gradRate_lag) & 
                                      !is.na(modeldata$gradRate)])))

lagModGradFE <- lm(gradRate ~ incsDefeatedFac_lag + econ_disadv_per_lag + 
                   log(VAP_adj_lag) + locale2_lag + PerBachelorOrAbove_lag + 
                   servingMembers_lag + per65o_lag + distid, data = modeldata)

lagModGradFE$se <- sqrt(diag(get_CL_vcov(lagModGradFE, 
                                         modeldata$distid[!is.na(modeldata$gradRate)])))

prettyNames <- c("Intercept", "Inc. Def. Lag", "Exurb", "Rural", "Board Size",
                  "ln(VAP)", "FRL \\%", "Grad Rate Lag", "\\% Bach. +", 
                 "\\% Over 65")

fe.note <- "District fixed effects not displayed."

