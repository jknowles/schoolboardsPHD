\section{Results}

The challenge in the descriptive analysis is to identify systematic contextual 
factors that have influence over school board candidate emergence. In essence, we 
can imagine three types of contextual factors that may influence the local political 
conditions in a school board -- taxation decisions, political conditions, and 
policy decisions. Of particular interest is understanding which of these factors, 
for the sample observed and over the time period of observation, are the most 
predictive of the emergence of contested school board seats. 

Let's look at the demographics of districts and how they affect the likelihood 
of a challenge. 

% 3 modeling strategies
%% model binomial by district, contested or not
%% model beta by district, # of contested out of # of races
%% model nested, races in districts

<<cleanModData, results='asis'>>=
dvs <- c("contestSer", "contestMinor", "contestMinorLag", "contestSerLag")
ids <- c("distid", "year", "districtwide")

moddat <- dist_turn[, c(dvs, ids, demogIdx, fiscalIdx, policyIdx, politicIdx)]

moddat$year <- factor(moddat$year)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$districtwide <- factor(moddat$districtwide)
moddat$contestSer <- factor(moddat$contestSer)
moddat$contestMinor <- factor(moddat$contestMinor)
moddat$contestMinorLag <- factor(moddat$contestMinorLag)
moddat$contestSerLag <- factor(moddat$contestSerLag)
moddat$NEW_SUP <- factor(moddat$NEW_SUP)
moddat$SUP_TURNOVER_PRIOR_YEAR <- factor(moddat$SUP_TURNOVER_PRIOR_YEAR)
moddat$debtPass <- factor(moddat$debtPass)
moddat$overridePass <- factor(moddat$overridePass)
moddat$debtQues <- factor(moddat$debtQues)
moddat$overrideQues <- factor(moddat$overrideQues)
moddat$PerBachelorOrAbove <- moddat$PerBachelorOrAbove * 100
moddat$per_white_all <- moddat$per_white_all * 100
moddat$OOH_share <- moddat$OOH_share * 100
moddat$per65o <- moddat$per65o * 100
moddat$teachShareofVoters <- moddat$teachShareofVoters * 100
#Rescale
library(arm)
nums <- sapply(moddat, is.numeric)
moddat[, nums] <- apply(moddat[, nums], 2, rescale)

get_CL_vcov<-function(model, cluster){
  # from: http://rforpublichealth.blogspot.com/2014/10/easy-clustered-standard-errors-in-r.html
  require(sandwich, quietly = TRUE)
  require(lmtest, quietly = TRUE)
  
  #calculate degree of freedom adjustment
  M <- length(unique(cluster))
  N <- length(cluster)
  K <- model$rank
  dfc <- (M/(M-1))*((N-1)/(N-K))
  
  #calculate the uj's
  uj  <- apply(estfun(model),2, function(x) tapply(x, cluster, sum))
  
  #use sandwich to get the var-covar matrix
  vcovCL <- dfc*sandwich(model, meat=crossprod(uj)/N)
  return(vcovCL)
}

@

\begin{tiny}
<<glmmods, results='asis'>>=
moddat <- moddat[moddat$year != "2002" & moddat$year != "2003", ]

demogs <- glm(contestSer ~ VAP_adjLOG + per65o + median_incomeLOG + per_white_all +
              OOH_share, data = moddat, family = "binomial") #bach and 65o switch?

demogSE <- get_CL_vcov(demogs, moddat$distid)
demogs$se <- sqrt(diag(demogSE))

politic <- update(demogs, . ~ . + incumShare + overrideYesPer +  fallTwoPartyShareDem +
                    teachShareofVoters + fallTurnout + nraces) 
  # partyDivision and fallTwoPartyShareDem lose 2 years

politicSE <- get_CL_vcov(politic, moddat$distid)
politic$se <- sqrt(diag(politicSE))

fiscal <- update(demogs, . ~ . + schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta)

fiscalSE <- get_CL_vcov(fiscal, moddat$distid)
fiscal$se <- sqrt(diag(fiscalSE))

policy <- update(demogs, . ~ . + ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)

policySE <- get_CL_vcov(policy, moddat$distid)
policy$se <- sqrt(diag(policySE))

fullmod <- update(politic, . ~ . +  schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta + 
                    ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)


fullmodSE <- get_CL_vcov(fullmod, moddat$distid)
fullmod$se <- sqrt(diag(fullmodSE))
rescalenote <- "All continuous variables rescaled to center 0 
                and divided by 2 standard deviations."
stars.note <- apsrtable:::stars.note


apsrtable(demogs, politic, fiscal, policy, fullmod, se = "robust", 
          float = "longtable",
          label="tab:glmMods", 
          model.names=c("Demog.", "Politic", 
                        "Fiscal",
                        "Policy", "Full"), 
          caption = "Models of Contestation in School Board Elections",
          notes = list(stars.note, rescalenote),
          Sweave=FALSE, digits = 3)

@
\end{tiny}

\begin{tiny}
<<glmermods, results='asis'>>=
library(optimx)

ctrl2 <- glmerControl(optimizer = "optimx", calc.derivs = FALSE, 
                     optCtrl = list(method = "nlminb", starttests = FALSE, 
                                    kkt = FALSE, maxit = 4000))
ctrl <- glmerControl(optimizer = "Nelder_Mead", calc.derivs = FALSE)



demogsMM <- glmer(contestSer ~ VAP_adjLOG + per65o + median_incomeLOG + per_white_all +
              OOH_share + (1|year) + (1|distid), 
              data = moddat, family = "binomial", control = ctrl) #bach and 65o switch?


demogsMM2 <- glmer(contestSer ~ VAP_adjLOG + per65o + median_incomeLOG + per_white_all +
              OOH_share + (1|distid/year), 
              data = moddat, family = "binomial", control = ctrl) #bach and 65o switch?


demogsMM3 <- glmer(contestSer ~ VAP_adjLOG + per65o + median_incomeLOG + per_white_all +
              OOH_share +  (1|distid), 
              data = moddat, family = "binomial", control = ctrl) #bach and 65o switch?



politicMM <- update(demogsMM, . ~ . + incumShare + overrideYesPer +  fallTwoPartyShareDem +
                    teachShareofVoters + fallTurnout + nraces, control = ctrl) 
  # partyDivision and fallTwoPartyShareDem lose 2 years

fiscalMM <- update(demogsMM, . ~ . + schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta, control = ctrl)

policyMM <- update(demogsMM, . ~ . + ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93, control = ctrl)

fullmodMM <- update(politicMM, . ~ . +  schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta + 
                    ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93, 
                   control = ctrl)

fullmodMM2 <- update(fullmodMM, . ~ . - incumShare, control = ctrl)

apsrtable(demogsMM, politicMM, fiscalMM, policyMM, fullmodMM,
          float = "longtable",
          label="tab:glmerMods", 
          model.names=c("Demog.", "Politic", 
                        "Fiscal",
                        "Policy", "Full"), 
          caption = "Mixed Models of Contestation in School Board Elections",
          notes = list(stars.note, rescalenote),
          Sweave=FALSE, digits = 3)
@

\end{tiny}

