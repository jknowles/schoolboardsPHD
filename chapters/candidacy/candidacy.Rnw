coefnames4 <- c("Intercept", "Electorate Size", "\\% Over 65", "\\% Bachelor +", 
               "\\% White", "\\% Owner Occupied", "Exurb", "Rural",
               "Contest. Lag", "\\% Incumbents", "\\% Yes Rev. Limit", 
