\subsection{Incumbent Defeat}

Table \ref{tab:glmerModsID} shows the results for incumbent defeat. These results 
are less promising than those in Table \ref{tab:glmerModsCon} for candidates emerging. 
Again, population size is strongly positively related with more incumbent defeats. 
However, other demographic variables do not seem to be predictive of incumbents 
being defeated. 

In fact, incumbent defeat proves very difficult to predict. Outside of the 
percentage of incumbents on the ballot -- a control to account for the varying 
opportunity for incumbent defeat election to election -- only the passage of a 
revenue limit maintains its predictive power in the full model. 



% VAP = correct, larger = more defeats, but peters out in fuller models
% No other demographics matter
% %incumbents increases likelihood incumbent is defeated
% Revenue limit passed increasing chance of defeat
% Nothing else matters, damn this is hard to predict

%TODO: Check signs are correct

<<incdefeatGLM, eval=TRUE, results='hide'>>=
moddat3 <- moddat[moddat$incumShare != max(moddat$incumShare) &
                              moddat$incumShare != min(moddat$incumShare),]

demogsD <- glm(incDefeats ~ VAP_adjLOG + per65o + PerBachelorOrAbove + 
                 per_white_all +
              OOH_share + locale2 + year, 
              data = moddat3, 
              family = "binomial") #bach and 65o switch?


demogSE <- get_CL_vcov(demogsD, moddat3$distid)
demogsD$se <- sqrt(diag(demogSE))

politicD <- update(demogsD, . ~ . + incumShare + overrideYesPer +  partyDivisionRecent +
                    teachShareofVoters + fallTurnout + nraces) 

politicSE <- get_CL_vcov(politicD, moddat3$distid)
politicD$se <- sqrt(diag(politicSE))


fiscalD <- update(demogsD, . ~ . + schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta)

fiscalSE <- get_CL_vcov(fiscalD, moddat3$distid)
fiscalD$se <- sqrt(diag(fiscalSE))


policyD <- update(demogsD, . ~ . + ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)


policySE <- get_CL_vcov(policyD, moddat3$distid)
policyD$se <- sqrt(diag(policySE))

fullmodD <- update(politicD, . ~ . +  schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta + 
                    ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)

fullmodSE <- get_CL_vcov(fullmodD, moddat3$distid)
fullmodD$se <- sqrt(diag(fullmodSE))

rescalenote <- "All continuous variables rescaled to center 0 
                and divided by 2 standard deviations."
stars.note <- apsrtable:::stars.note


coefnames3 <- c("Intercept", "VAP", "\\% Over 65", "\\% Bachelor +", 
               "\\% White", "\\% OOH", "Exurb", "Rural", "\\% Incumbents", "\\% Yes Rev. Limit", 
               "\\% Polarized", "\\% Teach. Voters", "Fall Turnout", "Number Seats", 
               "\\% Millrate for Schl.", "\\% Revenue Prop. Tax", "Cost per Pupil", 
               "Balance per Pupil", "Millrate $\\Delta$", "\\% Salary - Admin.", 
               "New Superintendent", "\\% Private School", "Cumul. Bond Att.", 
               "Cumul. Override Att.")

glmDtab <- apsrtable(demogsD, politicD, fiscalD, policyD, fullmodD, se = "robust", 
          float = "longtable",
          label="tab:glmModsD", 
          omitcoef=list("year", 
                        expression(grep("year", coefnames, value = TRUE))), 
          model.names=c("Demog.", "Politic", 
                        "Fiscal",
                        "Policy", "Full"), 
          caption = "Logit Models of Incumbent Defeat in School Board Elections",
          notes = list(stars.note, rescalenote),
          Sweave=FALSE, digits = 3, coef.names = coefnames3)

@

\begin{tiny}
