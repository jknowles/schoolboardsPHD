\subsection{Year Effects Across Models}

Across year effects. There is no consistent pattern between years and the year 
to year variation is a fraction of the IQR of the fitted values for all models - 
represented by the horizontal lines in each panel.

<<fixefSubYear, fig.cap="Substantive Effect on Contestation for Years">>=
seplotdf <- substEffSimFE(fullmodMMni, "year", ncases = 4L, re = TRUE, alpha = 0.1)

p1 <- ggplot(seplotdf, aes(x = year, y = yhat)) +
  geom_line(aes(group = caseID)) + 
    geom_ribbon(aes(ymin=lwr, ymax=upr, group = caseID),
                     alpha=0.4) + 
  geom_hline(yintercept = quantile(fitted(fullmodMMni), prob = 0.25)) + 
  geom_hline(yintercept = quantile(fitted(fullmodMMni), prob = 0.75)) + 
  facet_wrap(~caseID, nrow=1) +
  theme_dpi(base_size=12) + 
  theme(strip.text = element_blank(), strip.background = element_blank()) +  
  labs(x = "Year", y = "Pr(Non-Incumbent)", title= "Year Effect Across Observations")


seplotdf <- substEffSimFE(fullmodMMCon, "year", ncases = 4L, re = TRUE, alpha = 0.1)

p2 <- ggplot(seplotdf, aes(x = year, y = yhat)) +
  geom_line(aes(group = caseID)) + 
    geom_ribbon(aes(ymin=lwr, ymax=upr, group = caseID),
                     alpha=0.4) + 
  geom_hline(yintercept = quantile(fitted(fullmodMMCon), prob = 0.25)) + 
  geom_hline(yintercept = quantile(fitted(fullmodMMCon), prob = 0.75)) + 
  facet_wrap(~caseID, nrow=1) +
  theme_dpi(base_size=12) + 
  theme(strip.text = element_blank(), strip.background = element_blank()) +  
  labs(x = "Year", y = "Pr(Contested)", title= "Year Effect Across Observations")


seplotdf <- substEffSimFE(fullmodMMd, "year", ncases = 4L, re = TRUE, alpha = 0.1)

p3 <- ggplot(seplotdf, aes(x = year, y = yhat)) +
  geom_line(aes(group = caseID)) + 
    geom_ribbon(aes(ymin=lwr, ymax=upr, group = caseID),
                     alpha=0.4) + 
  geom_hline(yintercept = quantile(fitted(fullmodMMd), prob = 0.25)) + 
  geom_hline(yintercept = quantile(fitted(fullmodMMd), prob = 0.75)) + 
  facet_wrap(~caseID, nrow=1) +
  theme_dpi(base_size=12) + 
  theme(strip.text = element_blank(), strip.background = element_blank()) +  
  labs(x = "Year", y = "Pr(Inc. Defeat)", title= "Year Effect Across Observations")

seplotdf <- substEffSimFE(fullmodMMblq, "year", ncases = 4L, re = TRUE, alpha = 0.1)
seplotdf$yhatUnscale <- (seplotdf[, "yhat"] * 2 * moddatScale["minBlaisLago", 2]) + 
  moddatScale["minBlaisLago", 1] # assumes first slot in mod frame is DV
seplotdf$lwrUnscale <- (seplotdf[, "lwr"] * 2 * moddatScale["minBlaisLago", 2]) + 
  moddatScale["minBlaisLago", 1] # assumes first slot in mod frame is DV
seplotdf$uprUnscale <- (seplotdf[, "upr"] * 2 * moddatScale["minBlaisLago", 2]) + 
  moddatScale["minBlaisLago", 1] # assumes first slot in mod frame is DV

lowerBar <- exp((quantile(fitted(fullmodMMblq), prob = 0.25) * 2 * moddatScale["minBlaisLago", 2]) + 
      moddatScale["minBlaisLago", 1])
upperBar <- exp((quantile(fitted(fullmodMMblq), prob = 0.75) * 2 * moddatScale["minBlaisLago", 2]) + 
      moddatScale["minBlaisLago", 1])

p4 <- ggplot(seplotdf, aes(x = year, y = exp(yhatUnscale))) +
  geom_line(aes(group = caseID)) + 
    geom_ribbon(aes(ymin=exp(lwrUnscale), ymax=exp(uprUnscale), group = caseID),
                     alpha=0.4) + 
  geom_hline(yintercept = lowerBar) + 
  geom_hline(yintercept = upperBar) + 
  facet_wrap(~caseID, nrow=1) +
  theme_dpi(base_size=12) + 
  theme(strip.text = element_blank(), strip.background = element_blank()) +  
  labs(x = "Year", y = "Blais-Lago", title= "Year Effect Across Observations")

grid.arrange(p1, p2, p3, p4, ncol = 1)
@


\subsection{Model Specification Tests}

<<hausmantest, eval=TRUE, results='asis', cache=TRUE>>=
phDemog1 <- phtest_glmer(demogsMMd, update(demogsD, . ~. + distid))
phDemog2 <- phtest_glmer(demogsMMni, update(demogsNI, . ~. + distid))
phDemog3 <- phtest_glmer(demogsMMCon, update(demogsCon, . ~. + distid))

phPolicy1 <- phtest_glmer(policyMMd, update(policyD, . ~. + distid))
phPolicy2 <- phtest_glmer(policyMMni, update(policyNI, . ~. + distid))
phPolicy3 <- phtest_glmer(policyMMCon, update(policyCon, . ~. + distid))

phPolitic1 <- phtest_glmer(politicMMd, update(politicD, . ~. + distid))
phPolitic2 <- phtest_glmer(politicMMni, update(politicNI, . ~. + distid))
phPolitic3 <- phtest_glmer(politicMMCon, update(politicCon, . ~. + distid))


phFiscal1 <- phtest_glmer(fiscalMMd, update(fiscalD, . ~. + distid))
phFiscal2 <- phtest_glmer(fiscalMMni, update(fiscalNI, . ~. + distid))
phFiscal3 <- phtest_glmer(fiscalMMCon, update(fiscalCon, . ~. + distid))

phFull1 <- phtest_glmer(fullmodMMd, update(fullmodD, . ~. + distid ))
phFull2 <- phtest_glmer(fullmodMMni, update(fullmodNI, . ~. + distid ))
phFull3 <- phtest_glmer(fullmodMMCon, update(fullmodCon, . ~. + distid))

results_grid <- expand.grid(spec = c("Demog", "Fiscal", "Policy", "Politic", "Full"), 
                            var = c("Non-Incumbent", "Contestation", "Defeat"))

pval.ph <- function(x) x$p.value
ts.ph <- function(x) x$statistic
df.ph <- function(x) x$parameter

mods <- list(phDemog2, phFiscal2, phPolicy2, phPolitic2, phFull2, 
             phDemog3, phFiscal3, phPolicy3, phPolitic3, phFull3, 
             phDemog1, phFiscal1, phPolicy1, phPolitic1, phFull1)

results_grid$pval <- lapply(mods, pval.ph)
results_grid$test.stat <- lapply(mods, ts.ph)
results_grid$degfree <- lapply(mods, df.ph)
names(results_grid) <- c("Model", "Dependent Variable", "Hausman P Value", 
                         "Chi-Square", "Degrees of Freedom")

print(xtable(results_grid, digits = c(0,0, 0, 3, 3, 1),
      caption = "Hausman Specification Test Results for All Models"))

@

<<modTestRuns, results='hide', eval=FALSE, cache=TRUE>>=
library(pbkrtest)
library(doParallel)
cl <- makePSOCKcluster(detectCores())

modTestDemog1 <- PBmodcomp(demogsMM, demogsMM2, nsim = 200, 
          cl = cl)

modTestDemog2 <- PBmodcomp(demogsMM, demogsMM3, nsim = 200, 
          cl = cl)

stopCluster(cl)

cl <- makePSOCKcluster(detectCores())

fiscalMM2 <- update(fiscalMM, .~. - (1|distid) - (1|year) + (1|year/distid))
fiscalMM3 <- update(fiscalMM, . ~ . - (1|year))

modTestFiscal1 <- PBmodcomp(fiscalMM, fiscalMM2, nsim = 200, 
          cl = cl)

modTestFiscal2 <- PBmodcomp(fiscalMM, fiscalMM3, nsim = 200, 
          cl = cl)


stopCluster(cl)

cl <- makePSOCKcluster(detectCores())


politicMM2 <- update(politicMM, .~. - (1|distid) - (1|year) + (1|year/distid))
politicMM3 <- update(politicMM, . ~ . - (1|year))

modTestPolitic1 <- PBmodcomp(politicMM, politicMM2, nsim = 200, 
          cl = cl)

modTestPolitic2 <- PBmodcomp(politicMM, politicMM3, nsim = 200, 
          cl = cl)


stopCluster(cl)

cl <- makePSOCKcluster(detectCores())


policyMM2 <- update(policyMM, .~. - (1|distid) - (1|year) + (1|year/distid))
policyMM3 <- update(policyMM, . ~ . - (1|year))

modTestPolicy1 <- PBmodcomp(policyMM, policyMM2, nsim = 200, 
          cl = cl)

modTestPolicy2 <- PBmodcomp(policyMM, policyMM3, nsim = 200, 
          cl = cl)


stopCluster(cl)

