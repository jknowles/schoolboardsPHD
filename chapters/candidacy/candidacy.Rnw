demogsBLQ$se <- sqrt(diag(demogSE))

politicBLQ <- update(demogsBLQ, . ~ . + incumShare + overrideYesPer +  partyDivisionRecent +
                    teachShareofVoters + fallTurnout + nraces) 

politicSE <- get_CL_vcov(politicBLQ, moddat4$distid)
politicBLQ$se <- sqrt(diag(politicSE))


fiscalBLQ <- update(demogsBLQ, . ~ . + schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta)

fiscalSE <- get_CL_vcov(fiscalBLQ, moddat4$distid)
fiscalBLQ$se <- sqrt(diag(fiscalSE))

policyBLQ <- update(demogsBLQ, . ~ . + ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)

policySE <- get_CL_vcov(policyBLQ, moddat4$distid)
policyBLQ$se <- sqrt(diag(policySE))

fullmodBLQ <- update(politicBLQ, . ~ . +  schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta + 
                    ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)
