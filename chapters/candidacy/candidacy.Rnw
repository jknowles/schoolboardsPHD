              data = moddat, family = "binomial", control = ctrl) #bach and 65o switch?


demogsMM3 <- glmer(contestSer ~ VAP_adjLOG + per65o + median_incomeLOG + per_white_all +
              OOH_share +  (1|distid), 
              data = moddat, family = "binomial", control = ctrl) #bach and 65o switch?



politicMM <- update(demogsMM, . ~ . + incumShare + overrideYesPer +  fallTwoPartyShareDem +
                    teachShareofVoters + fallTurnout + nraces, control = ctrl) 
  # partyDivision and fallTwoPartyShareDem lose 2 years

fiscalMM <- update(demogsMM, . ~ . + schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta, control = ctrl)

policyMM <- update(demogsMM, . ~ . + ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93, control = ctrl)

fullmodMM <- update(politicMM, . ~ . +  schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta + 
                    ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93, 
                   control = ctrl)

fullmodMM2 <- update(fullmodMM, . ~ . - incumShare, control = ctrl)

apsrtable(demogsMM, politicMM, fiscalMM, policyMM, fullmodMM,
          float = "longtable",
          label="tab:glmerMods", 
          model.names=c("Demog.", "Politic", 
                        "Fiscal",
                        "Policy", "Full"), 
          caption = "Mixed Models of Contestation in School Board Elections",
          notes = list(stars.note, rescalenote),
          Sweave=FALSE, digits = 3)
