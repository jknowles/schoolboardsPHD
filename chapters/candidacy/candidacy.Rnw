                        expression(grep("year", coefnames, value = TRUE))), 
          model.names=c("Demog.", "Politic", 
                        "Fiscal",
                        "Policy", "Full"), 
          caption = "Linear Models of Blais-Lago Quotient of Competitiveness in School Board Elections",
          notes = list(stars.note, rescalenote),
