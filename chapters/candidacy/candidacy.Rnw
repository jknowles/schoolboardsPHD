nopanel <- theme(panel.background=element_blank(),
                 panel.grid.minor=element_blank(),
                 panel.grid.major=element_blank(),
                 axis.text.x = element_text(angle = -90, hjust = 0), 
                               axis.text = element_text(colour = "black"))
@

<<demog1, fig.cap="Correlations of Demographic Variables", fig.height=5.5, fig.width=7.5>>=
cormat <- melt(round(cor(dist_turn[!is.na(dist_turn$turnout), 
              which(names(dist_turn) %in% demogIdx)], use = "pairwise"), 3)) 

cormat$value2 <- cut(cormat$value, 
                     breaks=c(-1,-0.75,-0.5,-0.25,0,0.25,0.5,0.75,1), 
                     include.lowest=TRUE, 
            label=c("(-0.75,-1)","(-0.5,-0.75)","(-0.25,-0.5)","(0,-0.25)",
                    "(0,0.25)","(0.25,0.5)","(0.5,0.75)","(0.75,1)")) 

qplot(x=Var1, y=Var2, data=cormat, fill=value2, geom="tile", color = I("gray40")) + 
  scale_fill_brewer(palette = "RdYlGn",name="Correlation", 
                    breaks = levels(cormat$value2), drop =FALSE)+
  geom_text(aes(label = value), size = 2) + nopanel + 
  labs(x = "", y = "")
@

In Figure \ref{fig:demog1} we see a depiction of the correlations between key 
demographic variables with dark red and green representing the highest negative 
and positive correlations respectively.\footnote{These figures represent the correlation 
matrix for the complete pooled dataset across years and school districts. Correlations 
for individual years follow similar patterns, but are not shown.} The most problematic correlations are 
between the median household income and percentage of pupils in the school district 
eligible for free and reduced price lunch -- quite obviously strongly negatively 
correlated. The other largest correlation is between the number of pupils in the 
district and the VAP -- a strong positive correlation. This means that in the 
models below, I choose one variable from each of these pairs. Household median 
income is also strongly correlated with the proportion of the population with a 
BA or above and with the proportion of owner-occupied housing. As a result, 
it may be necessary to drop median income in favor of these two variables in the 
models below. 

<<fiscal1, fig.cap="Correlations of Fiscal Variables", fig.height=5.5, fig.width=7.5>>=

cormat <- melt(round(cor(dist_turn[!is.na(dist_turn$turnout), 
              which(names(dist_turn) %in% fiscalIdx)], 
              use = "pairwise"), 3)) 

cormat$value2 <- cut(cormat$value, 
                     breaks=c(-1,-0.75,-0.5,-0.25,0,0.25,0.5,0.75,1), 
                     include.lowest=TRUE, 
            label=c("(-0.75,-1)","(-0.5,-0.75)","(-0.25,-0.5)","(0,-0.25)",
                    "(0,0.25)","(0.25,0.5)","(0.5,0.75)","(0.75,1)")) 

qplot(x=Var1, y=Var2, data=cormat, fill=value2, geom="tile", color = I("gray70")) + 
  scale_fill_brewer(palette = "RdYlGn",name="Correlation", 
                    breaks = levels(cormat$value2), drop =FALSE)+
  geom_text(aes(label = value), size = 3)  + nopanel + 
  labs(x = "", y = "")

@

Figure \ref{fig:fiscal1} shows the correlations among the fiscal measures for school 
districts. Here there are fewer extermely high correlations. The largest correlations 
belong to two pairs of four variables. Understandably, our two measures of equalized 
district costs, \texttt{TDC\_MEMBER} (Total district cost per member) and 
\texttt{TEC\_MEMBER} (Total Complete Educational Cost per member), are very highly 
correlated with the only differences being relative spending on transportation and 
food services. In the models below, only one of these will ever be included. The 
next set of high correlations have to do with property tax rates and population. 
The share of the millrate within the school district attributable to school district 
taxation is highly correlated with the tax rate set by the school district. 
Additionally, the amount of property value per tax filer in the community is 
highly correlated with the millrate in a negative direction. 


