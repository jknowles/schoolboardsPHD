tax_model <- glm(contested2 ~  millrate + cum_attptsD + overlevy_ind_lag +
                    perwhite + levy_chg + log(Population18O) +
                   balance_member_lag +  median_income + fyear, 
                 data=SBELEC[!is.na(SBELEC$contested2.lag1), ], 
                 family=binomial("logit"))

