replotdf$uprUnscale <- replotdf[, "upr"] * 2 * moddatScale["minBlaisLago", 2] + 
  moddatScale["minBlaisLago", 1] # assumes first slot in mod frame is DV
replotdf <- replotdf[replotdf$uprUnscale < 100,]
lowerBar <- quantile(fitted(fullmodMMblq), prob = 0.25) * 2 * moddatScale["minBlaisLago", 2] + 
      moddatScale["minBlaisLago", 1]
