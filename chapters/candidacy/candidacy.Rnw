\subsection{Model Specification Tests}

<<modTestRuns, results='hide', eval=TRUE, cache=TRUE>>=
library(pbkrtest)
library(doParallel)
cl <- makePSOCKcluster(detectCores())

modTestDemog1 <- PBmodcomp(demogsMM, demogsMM2, nsim = 200, 
          cl = cl)

modTestDemog2 <- PBmodcomp(demogsMM, demogsMM3, nsim = 200, 
          cl = cl)

stopCluster(cl)

cl <- makePSOCKcluster(detectCores())

fiscalMM2 <- update(fiscalMM, .~. - (1|distid) - (1|year) + (1|year/distid))
fiscalMM3 <- update(fiscalMM, . ~ . - (1|year))

modTestFiscal1 <- PBmodcomp(fiscalMM, fiscalMM2, nsim = 200, 
          cl = cl)

modTestFiscal2 <- PBmodcomp(fiscalMM, fiscalMM3, nsim = 200, 
          cl = cl)


stopCluster(cl)

cl <- makePSOCKcluster(detectCores())


politicMM2 <- update(politicMM, .~. - (1|distid) - (1|year) + (1|year/distid))
politicMM3 <- update(politicMM, . ~ . - (1|year))

modTestPolitic1 <- PBmodcomp(politicMM, politicMM2, nsim = 200, 
          cl = cl)

modTestPolitic2 <- PBmodcomp(politicMM, politicMM3, nsim = 200, 
          cl = cl)


stopCluster(cl)

cl <- makePSOCKcluster(detectCores())


policyMM2 <- update(policyMM, .~. - (1|distid) - (1|year) + (1|year/distid))
policyMM3 <- update(policyMM, . ~ . - (1|year))

modTestPolicy1 <- PBmodcomp(policyMM, policyMM2, nsim = 200, 
          cl = cl)

modTestPolicy2 <- PBmodcomp(policyMM, policyMM3, nsim = 200, 
          cl = cl)


stopCluster(cl)

