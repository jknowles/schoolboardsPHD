<<pbtestresults, results='asis', eval=TRUE>>=
#print parametric bootstrap
printPB <- function(pbobj, names=NULL){
   require(xtable)
   if(missing(names)){
     names <- c("model 1", "model 2")
   }
   mycap <- paste0("Parametric bootstrap specification test results using ", pbobj$samples[[1]], 
                   " simulations. Between ", names[1], " and ", names[2], ".")
   print(xtable(modTestDemog1$test, caption = mycap), include.rownames=TRUE)
}

nams1 <- c("district and year effects", "districts nested in years")
nams2 <-  c("districts nested in years", "district effects alone")

printPB(modTestDemog1, names = nams1)
printPB(modTestDemog2, names = nams2)

printPB(modTestFiscal1, names = nams1)
