            geom='bar', stat='identity', fill=Var2, position='stack', color = I("black")) + 
  labs(x= "Year", y = "Percent of Races", title = "Excluding Minor Candidates", 
       fill = "Contested") + theme_bw() + scale_y_continuous(label = percent)


a <- table(races$contested, races$year)
a.tmp <- prop.table(a, margin = 2) 
a <- t(a)
a.tmp <- t(a.tmp)
a <- as.data.frame(a)
a.tmp <- as.data.frame(a.tmp)
a$Var1 <- as.numeric(as.character(a$Var1))
a.tmp$Var1 <- as.numeric(as.character(a.tmp$Var1))


p2 <- qplot(factor(Var1), Freq, data=a[a$Var1 > 2002 & a$Var1 < 2013,], geom='bar', stat='identity', fill=Var2, position='stack', color = I("black")) + 
  labs(x= "Year", y = "Races", title = "Including Minor Candidates", 
       fill = "Contested")+ theme_bw()

p2 <- qplot(factor(Var1), Freq, data=a.tmp[a.tmp$Var1 > 2002 & a.tmp$Var1 < 2013,], 
            geom='bar', stat='identity', fill=Var2, position='stack', color = I("black")) + 
