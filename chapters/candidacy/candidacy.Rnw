<<pbtestresults, results='asis', eval=TRUE, cache=TRUE>>=
#print parametric bootstrap
printPB <- function(pbobj, names=NULL, label = NULL){
   require(xtable)
   if(missing(names)){
     names <- c("model 1", "model 2")
   }
   mycap <- paste0("Parametric bootstrap specification test results for ", 
                   label, " using ", pbobj$samples[[1]], 
                   " simulations. Between ", names[1], " and ", names[2], ".")
   print(xtable(pbobj$test, caption = mycap), include.rownames=TRUE)
}

nams1 <- c("district and year effects", "districts nested in years")
nams2 <-  c("district and year effects", "district effects alone")

printPB(modTestDemog1, names = nams1, label = "demographic models")
printPB(modTestDemog2, names = nams2, label = "demographic models")

printPB(modTestFiscal1, names = nams1, label = "fiscal models")
printPB(modTestFiscal2, names = nams2, label = "fiscal models")

printPB(modTestPolitic1, names = nams1, label = "political models")
printPB(modTestPolitic2, names = nams2, label = "political models")

printPB(modTestPolicy1, names = nams1, label = "policy models")
printPB(modTestPolicy2, names = nams2, label = "policy models")

@

<<pbresults, results='markup', eval=TRUE, cache=TRUE>>=
modTestDemog1
modTestDemog2
modTestFiscal1
modTestFiscal2
modTestPolitic1
modTestPolitic2
modTestPolicy1
modTestPolicy2
@


