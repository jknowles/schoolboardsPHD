\section{Results}

I present results across four dependent variables for each of the four models. I begin by 
discussing the results for each dependent variable separately. In the text, I 
report the results for of the mixed-effect models and I leave the results of the 
fixed effect models for the appendix \ref{sec:appendix}. I prefer the mixed-effect 
models for reasons stated above, and because they represent a closer estimation 
of the impact of the variables of interest by eliminating the variance attributable 
to unobservable time-invariant characteristics of school districts. 

Next, I explore some substantive interpretations of the findings in the models. I do this by producing simulated observations and showing the prediction across the range 
of the variable of interest. This allows me to explore the marginal effect of 
changes in a predictor in the probability space of the predicted values of the 
model. This is more intuitive than discussing the coefficient values or 
interpreting effect sizes. 

Finally, I close by comparing the four groups of models to one another in an effort 
to understand which variables jointly explain the dependent variables best. In this 
section, I also compare the models to null models consisting merely of year and 
group factors. Thus, I explore how much additional classification power the school 
district annual attributes provide in explaining the likelihood candidates emerge 
or incumbents are defeated in a school board race. 

<<distTransform, results='hide'>>=
dist_turn$nonincumbRun <- ifelse(dist_turn$onlyIncum == 1, 0, 1)
dist_turn$partyDivisionRecent <- log(dist_turn$partyDivisionRecent)
@

<<cleanModData, results='hide'>>=
demogIdx <- c(demogIdx, "locale2")
dvs <- c("contestSer", "contestMinor", "contestMinorLag", 
         "contestSerLag", "incDefeats", "onlyIncum", "incumShare", "nonincumbRun", 
         "minBlaisLago", "turnout", "turnoutLag1", "turnoutLag2", "dissatFactor_fw", 
         "dissatFactor")
ids <- c("distid", "year", "districtwide")
moddat <- dist_turn[, c(dvs, ids, demogIdx, fiscalIdx, policyIdx, politicIdx)]

moddat$year <- factor(moddat$year)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$districtwide <- factor(moddat$districtwide)
moddat$contestSer <- factor(moddat$contestSer)
moddat$contestMinor <- factor(moddat$contestMinor)
moddat$contestMinorLag <- factor(moddat$contestMinorLag)
moddat$contestSerLag <- factor(moddat$contestSerLag)
moddat$onlyIncum <- factor(moddat$onlyIncum)
moddat$nonincumbRun <- factor(moddat$nonincumbRun)
moddat$locale2 <- factor(moddat$locale2)
moddat$incDefeats <- factor(moddat$incDefeats)
moddat$NEW_SUP <- factor(moddat$NEW_SUP)
moddat$SUP_TURNOVER_PRIOR_YEAR <- factor(moddat$SUP_TURNOVER_PRIOR_YEAR)
moddat$debtPass <- factor(moddat$debtPass)
moddat$overridePass <- factor(moddat$overridePass)
moddat$debtQues <- factor(moddat$debtQues)
moddat$overrideQues <- factor(moddat$overrideQues)
moddat$PerBachelorOrAbove <- moddat$PerBachelorOrAbove * 100
moddat$per_white_all <- moddat$per_white_all * 100
moddat$OOH_share <- moddat$OOH_share * 100
moddat$per65o <- moddat$per65o * 100
moddat$teachShareofVoters <- moddat$teachShareofVoters * 100

# Save scale parameters 
nums <- sapply(moddat, is.numeric)
ScaleMeans <- apply(moddat[, nums], 2, mean, na.rm=TRUE)
ScaleSD <- apply(moddat[, nums], 2, sd, na.rm=TRUE)
moddatScale <- cbind(ScaleMeans, ScaleSD); rm(ScaleMeans, ScaleSD)
#Rescale
library(arm)
nums <- sapply(moddat, is.numeric)
moddat[, nums] <- apply(moddat[, nums], 2, rescale)
@

\subsection{Dissatisfaction}

<<glmmodsDF, results='hide'>>=
moddat2 <- moddat[!is.na(moddat$dissatFactor_fw) & 
                    !is.na(moddat$dissatFactor), ]

demogsDF <- lm(dissatFactor_fw ~ VAP_adjLOG + per65o + PerBachelorOrAbove + per_white_all +
              OOH_share + locale2 + dissatFactor + year, 
              data = moddat2) #bach and 65o switch?

demogSE <- get_CL_vcov(demogsDF, moddat2$distid)
demogsDF$se <- sqrt(diag(demogSE))

politicDF <- update(demogsDF, . ~ . + overrideQues + overridePass + 
                      debtQues + debtPass +  partyDivisionRecent +
                    teachShareofVoters + fallTurnout + nraces) 

politicSE <- get_CL_vcov(politicDF, moddat2$distid)
politicDF$se <- sqrt(diag(politicSE))

fiscalDF <- update(demogsDF, . ~ . + schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta)

fiscalSE <- get_CL_vcov(fiscalDF, moddat2$distid)
fiscalDF$se <- sqrt(diag(fiscalSE))

policyDF <- update(demogsDF, . ~ . + ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)

policySE <- get_CL_vcov(policyDF, moddat2$distid)
policyDF$se <- sqrt(diag(policySE))

fullmodDF <- update(politicDF, . ~ . +  schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta + 
                    ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)
fullmodSE <- get_CL_vcov(fullmodDF, moddat2$distid)
fullmodDF$se <- sqrt(diag(fullmodSE))
rescalenote <- "All continuous variables mean centered and 
divided by 2 standard deviations"
stars.note <- apsrtable:::stars.note
coef.note <- "Year fixed effect coefficients excluded"

coefnames1 <- c("Intercept", "Electorate Size", "\\% Over 65", "\\% Bachelor +", 
               "\\% White", "\\% Owner Occupied",  "Exurb", "Rural", "Dissat. Lag", 
               "Rev. Lim. Attpt.", "Rev. Lim. Pass", "Bond Attpt.", "Bond Pass", 
               "\\% Polarized", "\\% Teach. Voters", "Fall Turnout", "Number Seats", 
               "\\% Tax for Schl.", "\\% Rev. Prop. Tax", "Cost per Pupil", 
               "Bal. per Pupil", "Millrate $\\Delta$", "\\% Salary Admin.", 
               "New Sup.", "\\% Private School", "Cumul. Bond Att.", 
               "Cumul. Ref Att.")

glmDFtab <- apsrtable(demogsDF, politicDF, fiscalDF, policyDF, fullmodDF, 
                     se = "robust", 
          float = "longtable",
          label="tab:glmModsDF", 
          omitcoef=list("year", 
                        expression(grep("year", coefnames, value = TRUE))), 
          model.names=c("Demog.", "Politic", 
                        "Fiscal",
                        "Policy", "Full"), 
          caption = "Models of Dissatisfaction Factor in School Board Elections",
          notes = list(stars.note, rescalenote, coef.note),
          Sweave=FALSE, digits = 3, coef.names = coefnames1, size="scriptsize", 
          stars = "default")
@

<<lmermodsDF, results='hide'>>=
demogsMMdf <- lmer(dissatFactor_fw ~ VAP_adjLOG + per65o + PerBachelorOrAbove + per_white_all +
              OOH_share + locale2 + dissatFactor + year + (1|distid), 
              data = moddat) 

politicMMdf <- update(demogsMMdf, . ~ . + overrideQues + overridePass + 
                      debtQues + debtPass +   partyDivisionRecent +
                    teachShareofVoters + fallTurnout + nwins) 

fiscalMMdf <- update(demogsMMdf, . ~ . + schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta)

policyMMdf <- update(demogsMMdf, . ~ . + ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)

fullmodMMdf <- update(politicMMdf, . ~ . +  schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta + 
                    ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)


lmerDFtab <- apsrtable(demogsMMdf, politicMMdf, fiscalMMdf, policyMMdf, fullmodMMdf,
          float = "longtable",
          label="tab:glmerModsDF", 
          omitcoef=list("year", 
                        expression(grep("year", coefnames, value = TRUE))), 
          model.names=c("Demog.", "Politic", 
                        "Fiscal",
                        "Policy", "Full"), 
          caption = "Mixed Models of Dissatisfaction Factor in School Board Elections",
          notes = list(stars.note, rescalenote),
          Sweave=FALSE, digits = 3, coef.names = coefnames1, size="scriptsize", 
          stars = "default")

@
\subsection{Presence of Non-incumbents}

<<glmmodsNI, results='hide'>>=
# moddat <- moddat[moddat$year != "2002" & moddat$year != "2003", ]
moddat2 <- moddat[!is.na(moddat$contestSerLag), ]

demogsNI <- glm(nonincumbRun ~ VAP_adjLOG + per65o + PerBachelorOrAbove + per_white_all +
              OOH_share + locale2 + contestSerLag + year, 
              data = moddat2, family = "binomial") #bach and 65o switch?

demogSE <- get_CL_vcov(demogsNI, moddat2$distid)
demogsNI$se <- sqrt(diag(demogSE))

politicNI <- update(demogsNI, . ~ . + overrideQues + overridePass + 
                      debtQues + debtPass +  partyDivisionRecent +
                    teachShareofVoters + fallTurnout + nraces) 
  # partyDivision and fallTwoPartyShareDem lose 2 years

politicSE <- get_CL_vcov(politicNI, moddat2$distid)
politicNI$se <- sqrt(diag(politicSE))

fiscalNI <- update(demogsNI, . ~ . + schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta)

fiscalSE <- get_CL_vcov(fiscalNI, moddat2$distid)
fiscalNI$se <- sqrt(diag(fiscalSE))

policyNI <- update(demogsNI, . ~ . + ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)

policySE <- get_CL_vcov(policyNI, moddat2$distid)
policyNI$se <- sqrt(diag(policySE))

fullmodNI <- update(politicNI, . ~ . +  schoolMillShare + PROPERTYTAX_REV_SHARE + 
                   TCEC_MEMBER + balance_member_lag + millrate_delta + 
                    ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)


fullmodSE <- get_CL_vcov(fullmodNI, moddat2$distid)
fullmodNI$se <- sqrt(diag(fullmodSE))
rescalenote <- "All continuous variables mean centered and 
divided by 2 standard deviations"
stars.note <- apsrtable:::stars.note
coef.note <- "Year fixed effect coefficients excluded"

coefnames1 <- c("Intercept", "Electorate Size", "\\% Over 65", "\\% Bachelor +", 
               "\\% White", "\\% Owner Occupied",  "Exurb", "Rural", "Contest. Lag", 
               "Rev. Lim. Attpt.", "Rev. Lim. Pass", "Bond Attpt.", "Bond Pass", 
               "\\% Polarized", "\\% Teach. Voters", "Fall Turnout", "Number Seats", 
               "\\% Tax for Schl.", "\\% Rev. Prop. Tax", "Cost per Pupil", 
               "Bal. per Pupil", "Millrate $\\Delta$", "\\% Salary Admin.", 
               "New Sup.", "\\% Priv. School", "Cumul. Bond Att.", 
               "Cumul. Ref Att.")

glmNItab <-apsrtable(demogsNI, politicNI, fiscalNI, policyNI, fullmodNI, se = "robust", 
          float = "longtable",
          label="tab:glmModsNI", 
          omitcoef=list("year", 
                        expression(grep("year", coefnames, value = TRUE))), 
          model.names=c("Demog.", "Politic", 
                        "Fiscal",
                        "Policy", "Full"), 
          caption = "Models of Incumbent Lockout in School Board Elections",
          notes = list(stars.note, rescalenote, coef.note),
          Sweave=FALSE, digits = 3, coef.names = coefnames1, size="scriptsize", 
          stars = "default")

@

