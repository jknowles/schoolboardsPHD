                   median_incomeLOG + districtwide + RecallPolarization*treatment +
                   (1|distid),
              data = moddat3, family = 'binomial', control = ctrl2)

library(blme)
IncDef1mm <-bglmer(incDefeats ~ turnoutLag2 + VAP_adjLOG + VAP_adjLOG_sq + 
                 per_white_all + per65o + PerBachelorOrAbove + OOH_share + 
                   median_incomeLOG + districtwide + 
                   treatment*RecallPolarization + 
                 (1|distid),
              data = moddat3, family = 'binomial', control = ctrl2)

IncDef2mm <- glmer(incDefeats ~ turnoutLag2 + VAP_adjLOG + VAP_adjLOG_sq + 
                 per_white_all + per65o + PerBachelorOrAbove + OOH_share + 
                   median_incomeLOG + districtwide + 
                   treatment*GovTurnout_recall + 
                 (1|distid),
              data = moddat3, family = 'binomial')

IncDef3mm <- glmer(incDefeats ~ turnoutLag2 + VAP_adjLOG + VAP_adjLOG_sq + 
                 per_white_all + per65o + PerBachelorOrAbove + OOH_share + 
                   median_incomeLOG + districtwide + 
                   treatment*GovTurnout_recall + RecallPolarization*treatment +
                 (1|distid), 
              data = moddat3, family = 'binomial', 
              control = ctrl2)


IncDef3mm <- bglmer(incDefeats ~ turnoutLag2 + VAP_adjLOG + VAP_adjLOG_sq + 
                 per_white_all + per65o + PerBachelorOrAbove + OOH_share + 
                   median_incomeLOG + districtwide + 
                   treatment*GovTurnout_recall + RecallPolarization*treatment +
                 (1|distid), 
              data = moddat3, family = 'binomial', 
              control = ctrl2)

IncDef4mm <- bglmer(incDefeats ~ turnoutLag2 + VAP_adjLOG + VAP_adjLOG_sq + 
                  per_white_all + 
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
               districtwide + turnout_overall_werc*treatment + WERC_elec + 
                 RecallPolarization +
                 GovTurnout_recall + (1|distid), 
              data = moddat3, family = 'binomial', 
              control = ctrl2)

class(IncDef3mm) <- "merMod"
class(IncDef1mm) <- "merMod"
class(IncDef4mm) <- "merMod"

apsrtable(IncDef1mm, IncDef2mm, IncDef3mm, IncDef4mm,
          caption = "Partial Pooling Model of Incumbent Defeat",
          model.names = c("Polar.", "Turnout", "Both", "WERC"), 
            label = "tab:meIncDef",  
           notes = list("All variables scaled and mean centered by year.", 
                       stars.note), 
          Sweave = TRUE, digits = 3)
@
\end{tiny}

The results in table \ref{tab:meIncDef} show a consistent negative effect of 
post-recall years on incumbent defeat, but this effect is not statistically 
significant. This is counter to expectations, but is perhaps offset by the 
specific effects of the recall results. Recall polarization is associated with 
greater incumbent defeat post-recall and recall turnout is as well -- but these 
effects are also not statistically significant. Turnout in union certification 
elections is positively related with incumbent defeat post-recall -- exactly as 
expected. This effect is statistically significnt, providing some evidence that 
union activity post-recall was active in both organizing union members and participating 
in school board elections. This effect can be attributed to a state-level policy 
decision, which has a clear impact on the behavior and results of local officials. 

% Note models built on a smaller subset
% Problems with convergence
% incumbent defeat seems to go down post recall
% Recall polarization negatively related to incumbent defeat
% incumbent defeat increases with polarization post election
% recall turnout negatively related to incumbent defeat
% recall turnout post recall positively related with incumbent defeat

\subsection{Competitiveness}

Looking at incumbent defeat as a binary measure of competitiveness downplays 
the significance of challenges that result in a narrow defeat by a challenger 
to an incumbent -- which would be coded as a 0 in Table \ref{meIncDef}. Using 
a consistent measure of competitiveness, 

<<blqLM, eval=TRUE, results='hide'>>=
moddat4 <- moddat[moddat$minBlaisLago < max(moddat$minBlaisLago), ]

demogsLMblq <- lm(minBlaisLago ~ VAP_adjLOG + VAP_adjLOG_sq + 
                      per65o + PerBachelorOrAbove + 
                      per_white_all + OOH_share + locale2 +  
                       RecallPolarization*treatment + treatment*GovTurnout_recall, 
                    data = moddat) 
demogsLMblqSE <- get_CL_vcov(demogsLMblq, moddat$distid)
demogsLMblq$se <- sqrt(diag(demogsLMblqSE))

politicLMblq <- update(demogsLMblq, . ~ . + incumShare +  overrideYesPer +  
                       partyDivisionRecent +
                    teachShareofVoters + fallTurnout + nraces) 
politicLMblqSE <- get_CL_vcov(politicLMblq, moddat$distid)
politicLMblq$se <- sqrt(diag(politicLMblqSE))

policyLMblq <- update(demogsLMblq, . ~ . + ADMIN_SHARE_COMP + NEW_SUP + 
                        NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)
policyLMblqSE <- get_CL_vcov(policyLMblq, moddat$distid)
policyLMblq$se <- sqrt(diag(policyLMblqSE))
fullmodLMblq <- update(politicLMblq, . ~ . +  schoolMillShare + 
                         PROPERTYTAX_REV_SHARE + TCEC_MEMBER + 
                         balance_member_lag + millrate_delta + 
                    ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93)
fullmodLMblqSE <- get_CL_vcov(fullmodLMblq, moddat$distid)
fullmodLMblq$se <- sqrt(diag(fullmodLMblqSE))

# coefnamesLag3 <- c("Intercept","Lagged Turnout (2)", "ln(VAP)", 
#                  "\\% White", 
#                   "\\% Over 65", "\\% Bach. +", "\\% OOH", 
#                   "ln(MedianIncome)", "District-wide", "Blais-Lago", 
#                   "Fall Turnout",  "$ln(VAP)^{2}$")

lmBLQtable <- apsrtable(demogsLMblq, politicLMblq, policyLMblq, fullmodLMblq, 
                        se="robust",
          caption = "Linear Models of Competitiveness",
          model.names = c("Demog.", "Politic", "Policy", "Full"), 
            label = "tab:lmBLQ",  
           notes = list("All variables scaled and mean centered by sample.", 
                       stars.note), 
          Sweave = TRUE, digits = 3) #, coef.names = coefnamesLag3)

@


\begin{tiny}
