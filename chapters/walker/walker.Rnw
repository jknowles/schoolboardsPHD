<<glmincDefeatmods, eval=TRUE, results='hide'>>=
moddat3 <- moddat[moddat$incumShare != max(moddat$incumShare) &
                              moddat$incumShare != min(moddat$incumShare) & 
                    !is.na(moddat$contestSerLag),]

glmIncDef1 <- glm(incDefeats ~ turnoutLag2 + VAP_adjLOG + VAP_adjLOG_sq + 
                 per_white_all + 
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
               districtwide + 
                 RecallPolarization*treatment + treatment*GovTurnout_recall,
              data = moddat3, family = 'binomial')

glmIncDef1SE <- get_CL_vcov(glmIncDef1, moddat3$distid)
glmIncDef1$se <- sqrt(diag(glmIncDef1SE))

glmIncDef2 <- glm(incDefeats ~ turnoutLag2 + VAP_adjLOG + VAP_adjLOG_sq + 
                  per_white_all + per65o + PerBachelorOrAbove +  
                    median_incomeLOG +
               districtwide + 
                 RecallPolarization*treatment + treatment*GovTurnout_recall,
              data = moddat3, family = 'binomial')

glmIncDef2SE <- get_CL_vcov(glmIncDef2, moddat3$distid)
glmIncDef2$se <- sqrt(diag(glmIncDef2SE))

moddat3$distid <- factor(as.character(moddat3$distid))
glmIncDef3 <- glm(incDefeats ~ contestSerLag + VAP_adjLOG + VAP_adjLOG_sq + 
                  per_white_all + 
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
               districtwide + RecallPolarization*treatment + 
                 treatment*GovTurnout_recall, 
              data = moddat3, family = 'binomial', 
              control = glm.control(maxit = 4000))

glmIncDef3SE <- get_CL_vcov(glmIncDef3, moddat3$distid)
glmIncDef3$se <- sqrt(diag(glmIncDef3SE))

incDefGLMtable <- apsrtable(glmIncDef1, glmIncDef2, glmIncDef3, 
          se = "robust", label="tab:incDefMod", 
          model.names=c("Naive Causal Model", "Overvote Model"), 
          caption = "Model of Causal Impact of Act 10 on Incumbent Defeat",
          omitcoef=list("year", 
                        expression(grep("year", coefnames, value = TRUE)), 
                        "distid", expression(grep("distid", coefnames, 
                                                  value = TRUE))), 
          Sweave=TRUE)

glmIncDefpolitic <- glm(incDefeats ~ contestSerLag + VAP_adjLOG + VAP_adjLOG_sq + 
                  per_white_all + 
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
                incumShare + overrideYesPer +  partyDivisionRecent +
                    teachShareofVoters + fallTurnout + nraces +
               districtwide + RecallPolarization*treatment + WERC_elec + 
                 treatment*GovTurnout_recall, 
              data = moddat3, family = 'binomial', 
              control = glm.control(maxit = 4000))

glmIncDefpoliticSE <- get_CL_vcov(glmIncDefpolitic, moddat3$distid)
glmIncDefpolitic$se <- sqrt(diag(glmIncDefpoliticSE))

glmIncDeffisc <- glm(incDefeats ~ contestSerLag + VAP_adjLOG + VAP_adjLOG_sq + 
                  per_white_all + 
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
               schoolMillShare + PROPERTYTAX_REV_SHARE + 
                TCEC_MEMBER + balance_member_lag + millrate_delta +
               districtwide + RecallPolarization*treatment + 
                 treatment*GovTurnout_recall, 
              data = moddat3, family = 'binomial', 
            control = glm.control(maxit = 4000))

glmIncDeffiscSE <- get_CL_vcov(glmIncDeffisc, moddat3$distid)
glmIncDeffisc$se <- sqrt(diag(glmIncDeffiscSE))

glmIncDefPoly <- glm(incDefeats ~ contestSerLag + VAP_adjLOG + VAP_adjLOG_sq + 
                  per_white_all + 
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + 
                 ADMIN_SHARE_COMP + NEW_SUP + NonPublicPupilPer + 
                   DEBT_ATTEMPT_CUMUL93 + OVERRIDE_ATTEMPT_CUMUL93 + 
               districtwide + RecallPolarization*treatment + 
                 treatment*GovTurnout_recall, 
              data = moddat3, family = 'binomial', 
            control = glm.control(maxit = 4000))

glmIncDefPolySE <- get_CL_vcov(glmIncDefPoly, moddat3$distid)
glmIncDefPoly$se <- sqrt(diag(glmIncDefPolySE))

rescalenote <- "All continuous variables rescaled to center 0 
                and divided by 2 standard deviations."
stars.note <- apsrtable:::stars.note

# coefnames3 <- c("Intercept", "VAP", "\\% Over 65", "\\% Bachelor +", 
#                "\\% White", "\\% OOH", "Exurb", "Rural", "Lagged Contestation", 
