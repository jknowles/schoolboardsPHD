<<walkerMixedMod, results='asis'>>=
library(optimx)
ctrl2 <- glmerControl(optimizer = "optimx", calc.derivs = FALSE, 
                     optCtrl = list(method = "nlminb", starttests = FALSE, 
                                    kkt = FALSE, maxit = 10000))
ctrl <- glmerControl(optimizer = "Nelder_Mead", calc.derivs = FALSE)
moddat2 <- moddat[moddat$incumShare != max(moddat$incumShare) & 
                    !is.na(moddat$contestSerLag), ]

mod1MMserBIN <- glmer(contestSer ~ VAP_adjLOG + VAP_adjLOG_sq + 
                      per65o + PerBachelorOrAbove + 
                      per_white_all + OOH_share + locale2 + PROPERTYTAX_REV_SHARE + 
                        incumShare + nraces + 
                       RecallPolarization*treatment +
                       (1|distid), data = moddat2, family = "binomial", 
                      control = ctrl2) 

mod2MMserBIN <-  glmer(contestSer ~ VAP_adjLOG + VAP_adjLOG_sq + 
                      per65o + PerBachelorOrAbove + 
                      per_white_all + OOH_share + locale2 + PROPERTYTAX_REV_SHARE + 
                        incumShare + nraces + treatment*GovTurnout_recall + 
                        (1|distid), data = moddat2, family = "binomial", 
                      control = ctrl2)

mod3MMserBIN <- update(mod2MMserBIN, . ~ . +  RecallPolarization*treatment)

mod4MMserBIN <-  glmer(contestSer ~ VAP_adjLOG + VAP_adjLOG_sq + 
                      per65o + PerBachelorOrAbove + 
                      per_white_all + OOH_share + locale2 + PROPERTYTAX_REV_SHARE + 
                        incumShare + nraces + 
                       turnout_overall_werc*treatment + WERC_elec + 
                       (1|distid), data = moddat2, family = "binomial", 
                      control = ctrl2)
