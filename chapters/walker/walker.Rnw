simp1 <- glm(contestSer ~ contestSer_lag + treatment * RecallTurnout_lag, 
             data = outdata, family = 'binomial')
simp1$se <- sqrt(diag(get_CL_vcov(simp1, outdata$distid)))

simp2 <- glm(contestMinor ~ contestMinor_lag + treatment * RecallTurnout_lag, 
             data = outdata, family = 'binomial')
simp2$se <- sqrt(diag(get_CL_vcov(simp2, outdata$distid)))

simp3 <- lm(minBlaisLago ~ minBlaisLago_lag + treatment * RecallTurnout_lag, 
             data = outdata)
