               median_incomeLOG_lag+ ImputedFlag + distWidemix + 
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag, 
             data = outdata)
DIDmodrollSE <- get_CL_vcov(DIDmodroll, outdata$distid)
DIDmodroll$se <- sqrt(diag(DIDmodrollSE))

merModroll <- lmer(turnoutDiff ~ turnoutDiff_lag * treatmentDiff + 
                  VAP_adjLOG_lag + VAP_adjLOG_sq_lag + 
              per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag+ ImputedFlag + distWidemix +
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag + 
