outdata$turnoutDiff <- outdata$turnoutDiff^2 * 10
outdata$turnoutDiff_lag <- outdata$turnoutDiff_lag^2 * 10

lagModroll <- lm(turnoutDiff ~ turnoutDiff_lag + treatmentDiff + 
                   VAP_adjLOG_lag + VAP_adjLOG_sq_lag + 
