             data = outdata, family = "binomial")

coefNames1 <- c("Intercept", "Spring 2011", "Spring 2012", "Recall Polarization", 
                "Districtwide", "Contest Lag", "Spring 2011 x Polar.", 
                "Spring 2012 x Polar.", "Blais-Lago lag", "Imputed", 
                "Turnout Lag", "Rolloff Lag", "Inc. Def. Lag")

apsrtable(simp1, simp3, simp4, simp5, simp6, se = "robust", digits = 3, 
          model.names = c("Ser. Cont.", "Compet.", 
