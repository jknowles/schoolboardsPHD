%tab:causTurn

<<turnoutDIDandLag, eval=TRUE, results = 'asis'>>=
outdata <- dist_turn[, c("distid", "year", "turnout", "VAP_adjLOG_sq", 
                         "VAP_adjLOG", "distWidemix", 
                         "PerBachelorOrAbove", "median_incomeLOG", 
                         "per65o", "NonPublicPupilPer", "incumShare", 
                         "teachShareofVoters", 
                         "fallTurnout", "nraces", "schoolMillShare", "OOH_share",
                         "PROPERTYTAX_REV_SHARE", "per_white_all",
                         "GovTurnout_recall", "RecallPolarization", "locale2", 
                         "econ_disadv_per")]

outdata$distWidemix <- ifelse(outdata$distWidemix == 1, "Yes", "No")
preTreat <- outdata[outdata$year <= 2010,]
preTreat$year <- preTreat$year + 2
names(preTreat) <- paste(names(preTreat), "lag", sep = "_")

# Repeat 2010 data as pre-treatment for 2012
# tmp <- preTreat[preTreat$year_lag == 2011,]
# tmp$year_lag <- 2012
# preTreat <- rbind(preTreat, tmp)
# rm(tmp)

outdata <- outdata[, c("turnout", "distWidemix", "distid", "year")]
outdata <- merge(outdata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))
outdata$treatmentDose <- ifelse(outdata$year >= 2011, abs(outdata$year - 2013), 0)
outdata$treatmentFactor <- ifelse(outdata$year >= 2011, 1, 0)
outdata$treatmentDiff <- ifelse(outdata$year >= 2011, abs(outdata$year - 2010), 0)
outdata$treatmentDiff <- factor(outdata$treatmentDiff)
outdata <- outdata[!is.na(outdata$turnout_lag), ]
outdata <- outdata[!is.na(outdata$turnout), ]
outdata <- outdata[outdata$turnout > 0,]
outdata <- outdata[outdata$turnout_lag > 0,]
centr <- mean(outdata$turnout)
stddev <- sd(outdata$turnout)
outdata$outflag <- (outdata$turnout - centr) / stddev
outdata$outflag2 <- (outdata$turnout_lag - centr) / stddev
outdata <- outdata[outdata$outflag <= 5 & outdata$outflag >= -5,]
outdata <- outdata[outdata$outflag2 <= 5 & outdata$outflag2 >= -5,]
# outdata <- outdata[outdata$year > 2007, ]
outdata$turnout <- log(outdata$turnout)
outdata$turnout_lag <- log(outdata$turnout_lag)
partialPanel <- names(table(outdata$distid)[table(outdata$distid) == 1])
outdata <- outdata[!outdata$distid %in% partialPanel, ]


lagModturn <- lm(turnout ~ turnout_lag + treatmentDiff + VAP_adjLOG_lag + 
                   VAP_adjLOG_sq_lag + 
              per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag + distWidemix + 
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag, 
             data = outdata)
lagModturnSE <- get_CL_vcov(lagModturn, outdata$distid)
lagModturn$se <- sqrt(diag(lagModturnSE))

DIDmodturn <- lm(turnout ~ turnout_lag * treatmentDiff + VAP_adjLOG_lag +
                   VAP_adjLOG_sq_lag + 
              per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag+ distWidemix +
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag, 
             data = outdata)
DIDmodturnSE <- get_CL_vcov(DIDmodturn, outdata$distid)
DIDmodturn$se <- sqrt(diag(DIDmodturnSE))

merModturn <- lmer(turnout ~ turnout_lag * treatmentDiff + VAP_adjLOG_lag +
                     VAP_adjLOG_sq_lag + 
              per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag + distWidemix +
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag + 
               (1|distid), data = outdata)

FEmodTurn <- lm(turnout ~ treatmentDiff + nraces_lag + distWidemix +
                  fallTurnout_lag + distid, data = outdata)
FEmodTurn$se <- sqrt(diag(get_CL_vcov(FEmodTurn, outdata$distid)))


coefNames <- c("Intercept", "Lag SB Turnout", "Spring 2011", "Spring 2012", 
               "ln(VAP)", "$ln(VAP)^{2}$", "\\% Over 65", 
               "n races", "\\% OOH", "ln(Median Income)",
               "Exurb", "Rural", "\\% Bach. +", "Fall Turnout", 
               "Lag x 2011", "Lag x 2012")


 apsrtable(lagModturn, DIDmodturn, FEmodTurn, se = "robust", stars = "default", 
          digits = 3, model.names = c("Lag", "DnD", "FE"), 
          caption = "Causal Estimates of Act 10 Period on Turnout", 
          label = "tab:causTurn", notes = list(stars.note, omitNote), 
          Sweave = FALSE, coef.names = coefNames, 
           omitcoef=list("distid", 
                         expression(grep("distid", coefnames, value=TRUE)), 
                         "ImputedFlagYes", "distWidemixYes"), 
          size="scriptsize")

@

