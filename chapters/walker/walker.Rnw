<<blDIDandLag, eval=TRUE, results = 'asis'>>=
outdata <- dist_turn[, c("distid", "year", "turnout", "VAP_adjLOG_sq", "VAP_adjLOG", 
                         "per65o", "NonPublicPupilPer", "incumShare", 
                         "teachShareofVoters", 
                         "fallTurnout", "nraces", "schoolMillShare", "OOH_share",
                         "PerBachelorOrAbove", 
                         "PROPERTYTAX_REV_SHARE", "minBlaisLago", "per_white_all",
                         "GovTurnout_recall", "RecallPolarization", "locale2", 
                         "econ_disadv_per")]

preTreat <- outdata[outdata$year <= 2010,]
preTreat$year <- preTreat$year + 1
names(preTreat) <- paste(names(preTreat), "lag", sep = "_")

# Repeat 2010 data as pre-treatment for 2012
tmp <- preTreat[preTreat$year_lag == 2011,]
tmp$year_lag <- 2012
preTreat <- rbind(preTreat, tmp)
rm(tmp)

outdata <- outdata[, c("minBlaisLago", "distid", "year")]
outdata <- merge(outdata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))

outdata$treatment <- ifelse(outdata$year >= 2011, abs(outdata$year - 2013), 0)

outdata$minBlaisLago <- ifelse(outdata$minBlaisLago == 0, 0.003, outdata$minBlaisLago)
outdata$minBlaisLago_lag <- ifelse(outdata$minBlaisLago_lag == 0, 0.003, 
                                   outdata$minBlaisLago_lag)
outdata$minBlaisLago <- log(outdata$minBlaisLago)
outdata$minBlaisLago_lag <- log(outdata$minBlaisLago_lag)

# outdata <- outdata[outdata$year > 2007, ]

lagModBL <- lm(minBlaisLago ~ minBlaisLago_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               PerBachelorOrAbove_lag + 
             locale2_lag, data = outdata)
lagModBLSE <- get_CL_vcov(lagModBL, outdata$distid)
lagModBL$se <- sqrt(diag(lagModBLSE))

DIDmodBL <- lm(minBlaisLago ~ minBlaisLago_lag * treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag +  
               PerBachelorOrAbove_lag +
             locale2_lag, data = outdata)
DIDmodBLSE <- get_CL_vcov(DIDmodBL, outdata$distid)
DIDmodBL$se <- sqrt(diag(DIDmodBLSE))

merModBL <- lmer(minBlaisLago ~ minBlaisLago_lag * treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag +  
               PerBachelorOrAbove_lag +
             locale2_lag + (1|distid), data = outdata)

apsrtable(lagModBL, DIDmodBL, merModBL, se = "robust", 
          model.names = c("Lag", "Diff in Diff"), stars = "default", 
          caption = "Causal Estimates of Act 10 Period on Competitiveness", 
          label = "tab:causBL", notes = list(stars.note), digits = 3, 
          Sweave = FALSE)

plotPred <- predict(DIDmodBL, newdata = outdata, type = "response")
plotdf2 <- cbind(outdata, plotPred)

@

<<incdefDIDandLag, eval = TRUE, results = 'asis'>>=
outdata <- dist_turn[, c("distid", "year", "incDefeats", "VAP_adjLOG_sq", 
                         "VAP_adjLOG", 
                         "per65o", "NonPublicPupilPer", "incumShare", 
                         "teachShareofVoters", "fallTurnout", "nraces", 
                         "schoolMillShare", "OOH_share", "PerBachelorOrAbove", 
                         "PROPERTYTAX_REV_SHARE", "per_white_all",
                         "GovTurnout_recall", "RecallPolarization", "locale2", 
                         "econ_disadv_per")]

preTreat <- outdata[outdata$year <= 2010,]
preTreat$year <- preTreat$year + 1
names(preTreat) <- paste(names(preTreat), "lag", sep = "_")

# Repeat 2010 data as pre-treatment for 2012
tmp <- preTreat[preTreat$year_lag == 2011,]
tmp$year_lag <- 2012
preTreat <- rbind(preTreat, tmp)
rm(tmp)

outdata <- outdata[, c("incDefeats", "distid", "year")]
outdata <- merge(outdata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))

outdata$treatment <- ifelse(outdata$year >= 2011, abs(outdata$year - 2013), 0)
outdata2 <- outdata[outdata$incumShare != max(outdata$incumShare) & 
                      outdata$incumShare != min(outdata$incumShare) & 
                      !is.na(outdata$incumShare_lag), ]

lagModID <- glm(incDefeats ~ incDefeats_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               PerBachelorOrAbove_lag + incumShare_lag + 
             locale2_lag, data = outdata, family = "binomial")

lagModIDSE <- get_CL_vcov(lagModID, outdata$distid)
lagModID$se <- sqrt(diag(lagModIDSE))

DIDmodID <- glm(incDefeats ~ incDefeats_lag * treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag +  
               PerBachelorOrAbove_lag + incumShare_lag +
             locale2_lag, data = outdata, family = "binomial")
DIDmodIDSE <- get_CL_vcov(DIDmodID, outdata$distid)
DIDmodID$se <- sqrt(diag(DIDmodIDSE))

merModID <- glmer(incDefeats ~ incDefeats_lag * treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag +  
               PerBachelorOrAbove_lag + incumShare_lag +
             locale2_lag + (1|distid), data = outdata, family = "binomial")

apsrtable(lagModID, DIDmodID, merModID, se = "robust", 
          model.names = c("Lag", "Diff in Diff", "Multilevel"), stars = "default", 
          caption = "Causal Estimates of Act 10 Period on Incumbent Defeat", 
          label = "tab:causID", notes = list(stars.note), digits = 3, 
          Sweave = FALSE)
@

<<turnoutDIDandLag, eval=TRUE, results = 'asis'>>=
outdata <- dist_turn[, c("distid", "year", "turnout", "VAP_adjLOG_sq", 
                         "VAP_adjLOG", 
                         "PerBachelorOrAbove", "ImputedFlag", "median_incomeLOG", 
                         "per65o", "NonPublicPupilPer", "incumShare", 
                         "teachShareofVoters", 
                         "fallTurnout", "nraces", "schoolMillShare", "OOH_share",
                         "PROPERTYTAX_REV_SHARE", "per_white_all",
                         "GovTurnout_recall", "RecallPolarization", "locale2", 
                         "econ_disadv_per")]

outdata$ImputedFlag[is.na(outdata$ImputedFlag)] <- "No"
outdata$ImputedFlag <- ifelse(outdata$ImputedFlag == "Imputed2010", "Yes", "No")

preTreat <- outdata[outdata$year <= 2010,]
preTreat$year <- preTreat$year + 1
names(preTreat) <- paste(names(preTreat), "lag", sep = "_")

# Repeat 2010 data as pre-treatment for 2012
tmp <- preTreat[preTreat$year_lag == 2011,]
tmp$year_lag <- 2012
preTreat <- rbind(preTreat, tmp)
rm(tmp)

outdata <- outdata[, c("turnout", "ImputedFlag", "distid", "year")]
outdata <- merge(outdata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))
outdata$treatment <- ifelse(outdata$year >= 2011, abs(outdata$year - 2013), 0)

outdata <- outdata[!is.na(outdata$turnout_lag), ]
outdata <- outdata[!is.na(outdata$turnout), ]
outdata <- outdata[outdata$turnout > 0,]
outdata <- outdata[outdata$turnout_lag > 0,]
centr <- mean(outdata$turnout)
stddev <- sd(outdata$turnout)
outdata$outflag <- (outdata$turnout - centr) / stddev
outdata$outflag2 <- (outdata$turnout_lag - centr) / stddev
outdata <- outdata[outdata$outflag <= 5 & outdata$outflag >= -5,]
outdata <- outdata[outdata$outflag2 <= 5 & outdata$outflag2 >= -5,]
# outdata <- outdata[outdata$year > 2007, ]
outdata$turnout <- log(outdata$turnout)
outdata$turnout_lag <- log(outdata$turnout_lag)


lagModturn <- lm(turnout ~ turnout_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag + ImputedFlag +
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag, 
             data = outdata)
lagModturnSE <- get_CL_vcov(lagModturn, outdata$distid)
lagModturn$se <- sqrt(diag(lagModturnSE))

DIDmodturn <- lm(turnout ~ turnout_lag * treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag+ ImputedFlag + 
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag, 
             data = outdata)
DIDmodturnSE <- get_CL_vcov(DIDmodturn, outdata$distid)
DIDmodturn$se <- sqrt(diag(DIDmodturnSE))

merModturn <- lmer(turnout ~ turnout_lag * treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag + ImputedFlag +
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag + 
               (1|distid), data = outdata)

apsrtable(lagModturn, DIDmodturn, merModturn, se = "robust", 
          model.names = c("Lag", "Diff in Diff", "Multilevel"), 
          stars = "default", 
          caption = "Causal Estimates of Act 10 Period on Turnout", 
          label = "tab:causTurn", notes = list(stars.note), digits = 3, 
          Sweave = FALSE)
@

<<rolloffDIDandLag, eval=TRUE, results = 'asis'>>=
outdata <- dist_turn[, c("distid", "year", "turnoutDiff", "VAP_adjLOG_sq", 
                         "VAP_adjLOG", 
                         "PerBachelorOrAbove", "ImputedFlag", 
                         "median_incomeLOG", "per65o", "NonPublicPupilPer", 
                         "incumShare", "teachShareofVoters", 
                         "fallTurnout", "nraces", "schoolMillShare", "OOH_share",
                         "PROPERTYTAX_REV_SHARE", "per_white_all", "turnout", 
                         "GovTurnout_recall", "RecallPolarization", "locale2", 
                         "econ_disadv_per")]

outdata$ImputedFlag[is.na(outdata$ImputedFlag)] <- "No"
outdata$ImputedFlag <- ifelse(outdata$ImputedFlag == "Imputed2010", "Yes", "No")

preTreat <- outdata[outdata$year <= 2010,]
preTreat$year <- preTreat$year + 1
names(preTreat) <- paste(names(preTreat), "lag", sep = "_")

# Repeat 2010 data as pre-treatment for 2012
tmp <- preTreat[preTreat$year_lag == 2011,]
tmp$year_lag <- 2012
preTreat <- rbind(preTreat, tmp)
rm(tmp)

outdata <- outdata[, c("turnoutDiff", "ImputedFlag", "distid", "year")]
outdata <- merge(outdata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))

outdata$treatment <- ifelse(outdata$year >= 2011, abs(outdata$year - 2013), 0)
outdata <- outdata[!is.na(outdata$turnoutDiff), ]
outdata <- outdata[!is.na(outdata$turnoutDiff_lag), ]
centr <- mean(outdata$turnoutDiff)
stddev <- sd(outdata$turnoutDiff)
outdata$outflag <- (outdata$turnoutDiff - centr) / stddev
outdata$outflag2 <- (outdata$turnoutDiff_lag - centr) / stddev
outdata <- outdata[outdata$outflag <= 5 & outdata$outflag >= -5,]
outdata <- outdata[outdata$outflag2 <= 5 & outdata$outflag2 >= -5,]
# outdata <- outdata[outdata$year > 2007, ]

lagModroll <- lm(turnoutDiff ~ turnoutDiff_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag + ImputedFlag + 
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag, 
             data = outdata)
lagModrollSE <- get_CL_vcov(lagModroll, outdata$distid)
lagModroll$se <- sqrt(diag(lagModrollSE))

DIDmodroll <- lm(turnoutDiff ~ turnoutDiff_lag * treatment + 
                   VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag+ ImputedFlag +
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag, 
             data = outdata)
DIDmodrollSE <- get_CL_vcov(DIDmodroll, outdata$distid)
DIDmodroll$se <- sqrt(diag(DIDmodrollSE))

merModroll <- lmer(turnoutDiff ~ turnoutDiff_lag * treatment + 
                   VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag+ ImputedFlag +
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag + 
               (1|distid), data = outdata)

apsrtable(lagModroll, DIDmodroll, merModroll, se = "robust", 
          model.names = c("Lag", "Diff in Diff", "Multilevel"), 
          stars = "default", 
          caption = "Causal Estimates of Act 10 Period on Rolloff", 
          label = "tab:causTurn", notes = list(stars.note), digits = 3, 
          Sweave = FALSE)
@

