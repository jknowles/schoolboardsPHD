               PerBachelorOrAbove_lag + locale2_lag + 
               treatment * RecallTurnout_lag + (1|distid), 
             data = outdata, family = "binomial")

apsrtable(simp1, simp3, simp4, simp5, simp6, se = "robust", digits = 3, 
          model.names = c("Ser. Cont.", "Compet.", 
