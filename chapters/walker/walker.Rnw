\begin{table}[h!]
\begin{center}
\begin{small}
\caption{Summary of Causal Relationship of Act 10 Reforms on Board Elections}
\label{tab:act10resSummary}
\begin{tabular}{| p{.24\textwidth} | p{.12\textwidth} | p{.12\textwidth} | 
      p{.24\textwidth} |} \hline
DV / Variable & expected & observed & evidence \\ \hline
Contested Race & + & null & no statistical significance, correct sign \\ \hline
Contesed Race (ser) & + & null & no statistical significance, correct sign on interaction \\ \hline
Incumbent Defeat & + & - & weakly negative, positive effect in diff-in-diff  \\ \hline 
Competitiveness & + & +  & weakly positive, weakly statistically significant \\ \hline
Turnout & + & - & diff in diff weakly negative, overall effect positive \\ \hline
Rolloff & - & null & correct sign, no statistical significance \\ \hline
\end{tabular}
\end{small}
\end{center}
\end{table}

Table \ref{tab:act10resSummary} summarizes the results in comparison to the 
expectations from Table \ref{tab:act10hypo}. Overall, there is some evidence 
of an effect of Act 10 on school board election activity. Specifically, the 
post-Act 10 period showed evidence of an increase in competitiveness, a 
decrease in turnout, and an increase in rolloff. 

<<bldiffindiff, fig.cap="Average Fitted Value over Realistic Value">>=
summPlot <- ddply(plotdf2, .(year), summarize, 
                  meanEff = mean(plotPred))

qplot(factor(year), exp(plotPred), data = plotdf2, geom = 'boxplot') + 
  geom_line(data = summPlot, aes(x = factor(year), y = exp(meanEff), group = 1)) + 
  theme_dpi() + 
  scale_y_sqrt(limits = c(0, 100)) + 
  labs(x = "Year", y = "Blais-Lago")
@

\clearpage

\subsection{Mediation Analysis}

While the results above can be interpreted as the causal estimate of the political 
upheaval surrounding Act 10 on democratic activity in school boards, questions 
remain. Most importantly, it is important to explore the potential for mediating 
factors on the causal estimate. To do this, I fit longitudinal models as above, 
but I include mediating factors as interactions with the treatment indicator. 

These mediating measures were observed post-treatment, but I argue that they 
can be interpreted as a consistent measure of school district attributes that 
existed pre-treatment. There is no empirical way to validate this assumption, but 
using this assumption allows me to explore a rich set of potential mediating 
factors to understand what conditions exacerbated or attenuated the actualization 
of political activity in school boards. 

I now analyze the impact of each mediating factor. 

\subsubsection{Polarization}

Polarization should matter. 

%tab:polarMed
\begin{small}
<<polarizationMediation, results = 'asis'>>=
outdata <- dist_turn[, c("distid", "year", "contestMinor", "contestSer", 
                         "VAP_adjLOG_sq", "turnout", "turnoutDiff", 
                         "RecallPolarization", "incDefeats", "ImputedFlag", 
                         "VAP_adjLOG", "per65o", "NonPublicPupilPer", 
                         "incumShare", "teachShareofVoters", 
                         "fallTurnout", "nraces", "schoolMillShare", "OOH_share",
                         "PerBachelorOrAbove", 
                         "PROPERTYTAX_REV_SHARE", "minBlaisLago", "per_white_all",
                         "GovTurnout_recall", "locale2", 
                         "econ_disadv_per")]

outdata$ImputedFlag[is.na(outdata$ImputedFlag)] <- "No"
outdata$ImputedFlag <- ifelse(outdata$ImputedFlag == "Imputed2010", "Yes", "No")

preTreat <- outdata[outdata$year <= 2010,]
preTreat$year <- preTreat$year + 1
names(preTreat) <- paste(names(preTreat), "lag", sep = "_")

# Repeat 2010 data as pre-treatment for 2012
tmp <- preTreat[preTreat$year_lag == 2011,]
tmp$year_lag <- 2012
preTreat <- rbind(preTreat, tmp)
rm(tmp)
outdata <- outdata[, c("contestMinor", "contestSer", "turnout", "turnoutDiff", 
                       "minBlaisLago", "incDefeats", "ImputedFlag", 
                       "distid", "year")]
outdata <- merge(outdata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))

outdata$treatment <- ifelse(outdata$year >= 2011, abs(outdata$year - 2013), 0)
outdata <- outdata[outdata$year > 2007, ]
outdata <- na.omit(outdata)
outdata <- outdata[!is.na(outdata$turnout_lag), ]
outdata <- outdata[!is.na(outdata$turnout), ]
outdata <- outdata[outdata$turnout > 0,]
outdata <- outdata[outdata$turnout_lag > 0,]
centr <- mean(outdata$turnout)
stddev <- sd(outdata$turnout)
outdata$outflag <- (outdata$turnout - centr) / stddev
outdata$outflag2 <- (outdata$turnout_lag - centr) / stddev
outdata <- outdata[outdata$outflag <= 5 & outdata$outflag >= -5,]
outdata <- outdata[outdata$outflag2 <= 5 & outdata$outflag2 >= -5,]
# outdata <- outdata[outdata$year > 2007, ]
outdata$turnout <- log(outdata$turnout)
outdata$turnout_lag <- log(outdata$turnout_lag)
outdata$minBlaisLago <- ifelse(outdata$minBlaisLago == 0, 0.003, outdata$minBlaisLago)
outdata$minBlaisLago_lag <- ifelse(outdata$minBlaisLago_lag == 0, 0.003, 
                                   outdata$minBlaisLago_lag)
outdata$minBlaisLago <- log(outdata$minBlaisLago)
outdata$minBlaisLago_lag <- log(outdata$minBlaisLago_lag)
outdata$incDefeats <- factor(outdata$incDefeats)
outdata$incDefeats_lag <- factor(outdata$incDefeats_lag)
library(arm)
nums <- sapply(outdata, is.numeric)
# nums["treatment"] <- FALSE
outdata[, nums] <- apply(outdata[, nums], 2, rescale)

simp1 <- glm(contestSer ~ contestSer_lag + treatment * RecallPolarization_lag, 
             data = outdata, family = 'binomial')
simp1$se <- sqrt(diag(get_CL_vcov(simp1, outdata$distid)))

simp2 <- glm(contestMinor ~ contestMinor_lag + treatment * RecallPolarization_lag, 
             data = outdata, family = 'binomial')
simp2$se <- sqrt(diag(get_CL_vcov(simp2, outdata$distid)))

simp3 <- lm(minBlaisLago ~ minBlaisLago_lag + treatment * RecallPolarization_lag, 
             data = outdata)
simp3$se <- sqrt(diag(get_CL_vcov(simp3, outdata$distid)))

simp4 <- lm(turnout ~ turnout_lag + treatment * RecallPolarization_lag + 
              ImputedFlag, 
             data = outdata)
simp4$se <- sqrt(diag(get_CL_vcov(simp4, outdata$distid)))

simp5 <- lm(turnoutDiff ~ turnoutDiff_lag + treatment * RecallPolarization_lag + 
              ImputedFlag, 
             data = outdata)
simp5$se <- sqrt(diag(get_CL_vcov(simp5, outdata$distid)))

simp6 <- glm(incDefeats ~ incDefeats_lag + treatment * RecallPolarization_lag, 
             data = outdata, family = "binomial")
simp6$se <- sqrt(diag(get_CL_vcov(simp6, outdata$distid)))

full1 <- glmer(contestMinor ~ contestMinor_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag +  
               PerBachelorOrAbove_lag + locale2_lag + 
               treatment * RecallPolarization_lag + (1|distid), 
             data = outdata, family = "binomial", control = ctrl)

full2 <- glmer(contestSer ~ contestSer_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag +  
               PerBachelorOrAbove_lag + locale2_lag + 
               treatment * RecallPolarization_lag + (1|distid), 
             data = outdata, family = "binomial", control = ctrl)

full3 <- lmer(minBlaisLago ~ minBlaisLago_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + OOH_share_lag +  nraces_lag +
               PerBachelorOrAbove_lag + locale2_lag + 
               treatment * RecallPolarization_lag + (1|distid), 
             data = outdata)

full4 <- lmer(turnout ~ turnout_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + OOH_share_lag +  nraces_lag +
               PerBachelorOrAbove_lag + locale2_lag + ImputedFlag +
               treatment * RecallPolarization_lag + (1|distid), 
             data = outdata)

full5 <- lmer(turnoutDiff ~ turnoutDiff_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + OOH_share_lag +  nraces_lag +
               PerBachelorOrAbove_lag + locale2_lag + ImputedFlag +
               treatment * RecallPolarization_lag + (1|distid), 
             data = outdata)

full6 <- glmer(incDefeats ~ incDefeats_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + OOH_share_lag +  nraces_lag +
               PerBachelorOrAbove_lag + locale2_lag + 
               treatment * RecallPolarization_lag + (1|distid), 
             data = outdata, family = "binomial")

apsrtable(simp1, simp3, simp4, simp5, simp6, se = "robust", digits = 3, 
          model.names = c("Ser. Cont.", "Compet.", 
                          "Turnout", "Rolloff", "Inc. Def."), 
          stars = "default", 
          caption = "Mediation Estimates of Polarization on Board Elections", 
          label = "tab:polarMed", notes = list(stars.note), Sweave = TRUE)

polarMedTable <- apsrtable(full1, full3, full4, full5, full6, 
                           se = "robust", digits = 3, 
          model.names = c("Ser. Cont.", "Compet.", 
                          "Turnout", "Rolloff", "Inc. Def."), 
caption = "Mediation Estimates of Polarization on Board Elections - Multilevel Models",           label = "tab:polarMedHLM", notes = list(stars.note), Sweave = TRUE, 
          stars = "default")
@
\end{small}

% Only evidence of mediation on turnout, where higher polarization attenuates the 
% turnout boost post-recall

\subsubsection{Union Strength}

%tab:unionMed
\begin{small}
<<unionStrength>>=
outdata <- dist_turn[, c("distid", "year", "contestMinor", "contestSer", 
                         "VAP_adjLOG_sq", "turnout", "turnoutDiff", 
                         "RecallPolarization", "incDefeats", "ImputedFlag", 
                         "VAP_adjLOG", "per65o", "NonPublicPupilPer", 
                         "incumShare", "teachShareofVoters", 
                         "fallTurnout", "nraces", "schoolMillShare", "OOH_share",
                         "PerBachelorOrAbove", "WERC_elec", 
                         "turnout_overall_werc", 
                         "PROPERTYTAX_REV_SHARE", "minBlaisLago", "per_white_all",
                         "GovTurnout_recall", "locale2", 
                         "econ_disadv_per")]
outdata$WERC_str <- outdata$turnout_overall_werc
outdata$turnout_overall_werc <- NULL

outdata$ImputedFlag[is.na(outdata$ImputedFlag)] <- "No"
outdata$ImputedFlag <- ifelse(outdata$ImputedFlag == "Imputed2010", "Yes", "No")

preTreat <- outdata[outdata$year <= 2010,]
preTreat$year <- preTreat$year + 1
names(preTreat) <- paste(names(preTreat), "lag", sep = "_")

# Repeat 2010 data as pre-treatment for 2012
tmp <- preTreat[preTreat$year_lag == 2011,]
tmp$year_lag <- 2012
preTreat <- rbind(preTreat, tmp)
rm(tmp)
outdata <- outdata[, c("contestMinor", "contestSer", "turnout", "turnoutDiff", 
                       "minBlaisLago", "incDefeats", "ImputedFlag", 
                       "distid", "year")]
outdata <- merge(outdata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))

outdata$treatment <- ifelse(outdata$year >= 2011, abs(outdata$year - 2013), 0)
outdata <- outdata[outdata$year > 2007, ]
outdata <- na.omit(outdata)
outdata <- outdata[!is.na(outdata$turnout_lag), ]
outdata <- outdata[!is.na(outdata$turnout), ]
outdata <- outdata[outdata$turnout > 0,]
outdata <- outdata[outdata$turnout_lag > 0,]
centr <- mean(outdata$turnout)
stddev <- sd(outdata$turnout)
outdata$outflag <- (outdata$turnout - centr) / stddev
outdata$outflag2 <- (outdata$turnout_lag - centr) / stddev
outdata <- outdata[outdata$outflag <= 5 & outdata$outflag >= -5,]
outdata <- outdata[outdata$outflag2 <= 5 & outdata$outflag2 >= -5,]
# outdata <- outdata[outdata$year > 2007, ]
outdata$turnout <- log(outdata$turnout)
outdata$turnout_lag <- log(outdata$turnout_lag)
outdata$minBlaisLago <- ifelse(outdata$minBlaisLago == 0, 0.003, outdata$minBlaisLago)
outdata$minBlaisLago_lag <- ifelse(outdata$minBlaisLago_lag == 0, 0.003, 
                                   outdata$minBlaisLago_lag)
outdata$minBlaisLago <- log(outdata$minBlaisLago)
outdata$minBlaisLago_lag <- log(outdata$minBlaisLago_lag)
outdata$incDefeats <- factor(outdata$incDefeats)
outdata$incDefeats_lag <- factor(outdata$incDefeats_lag)
library(arm)
nums <- sapply(outdata, is.numeric)
# nums["treatment"] <- FALSE
outdata[, nums] <- apply(outdata[, nums], 2, rescale)

simp1 <- glm(contestSer ~ contestSer_lag + treatment * WERC_str_lag+ 
              WERC_elec_lag, 
             data = outdata, family = 'binomial')
simp1$se <- sqrt(diag(get_CL_vcov(simp1, outdata$distid)))

simp2 <- glm(contestMinor ~ contestMinor_lag + treatment * WERC_str_lag+ 
              WERC_elec_lag, 
             data = outdata, family = 'binomial')
simp2$se <- sqrt(diag(get_CL_vcov(simp2, outdata$distid)))

simp3 <- lm(minBlaisLago ~ minBlaisLago_lag + treatment * WERC_str_lag + 
              WERC_elec_lag, 
             data = outdata)
simp3$se <- sqrt(diag(get_CL_vcov(simp3, outdata$distid)))

simp4 <- lm(turnout ~ turnout_lag + treatment * WERC_str_lag+ 
              WERC_elec_lag + ImputedFlag, 
             data = outdata)
simp4$se <- sqrt(diag(get_CL_vcov(simp4, outdata$distid)))

simp5 <- lm(turnoutDiff ~ turnoutDiff_lag + treatment * WERC_str_lag+ 
              WERC_elec_lag + ImputedFlag,  
             data = outdata)
simp5$se <- sqrt(diag(get_CL_vcov(simp5, outdata$distid)))

simp6 <- glm(incDefeats ~ incDefeats_lag + treatment * WERC_str_lag + 
               WERC_elec_lag, 
             data = outdata, family = "binomial")
simp6$se <- sqrt(diag(get_CL_vcov(simp6, outdata$distid)))


full1 <- glmer(contestMinor ~ contestMinor_lag + treatment + 
                 VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag +  
               PerBachelorOrAbove_lag + locale2_lag + WERC_elec_lag +
               treatment * WERC_str_lag + (1|distid), 
             data = outdata, family = "binomial", control = ctrl)

full2 <- glmer(contestSer ~ contestSer_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag +  
               PerBachelorOrAbove_lag + locale2_lag + WERC_elec_lag +
               treatment * WERC_str_lag + (1|distid), 
             data = outdata, family = "binomial", control = ctrl)

full3 <- lmer(minBlaisLago ~ minBlaisLago_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + OOH_share_lag +  nraces_lag +
               PerBachelorOrAbove_lag + locale2_lag + WERC_elec_lag +
               treatment * WERC_str_lag + (1|distid), 
             data = outdata)

full4 <- lmer(turnout ~ turnout_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + OOH_share_lag +  nraces_lag +
               PerBachelorOrAbove_lag + locale2_lag + WERC_elec_lag +
               ImputedFlag + 
               treatment * WERC_str_lag + (1|distid), 
             data = outdata)

full5 <- lmer(turnoutDiff ~ turnoutDiff_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + OOH_share_lag +  nraces_lag +
               PerBachelorOrAbove_lag + locale2_lag + WERC_elec_lag +
               ImputedFlag + 
               treatment * WERC_str_lag + (1|distid), 
             data = outdata)

full6 <- glmer(incDefeats ~ incDefeats_lag + treatment + VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + OOH_share_lag +  nraces_lag +
               PerBachelorOrAbove_lag + locale2_lag + WERC_elec_lag +
               treatment * WERC_str_lag + (1|distid), 
             data = outdata, family = "binomial")

apsrtable(simp1, simp3, simp4, simp5, simp6, se = "robust", digits = 3, 
          model.names = c("Ser. Cont.", "Compet.", 
                          "Turnout", "Rolloff", "Inc. Def."), 
           stars = "default", 
          caption = "Mediation Estimates of Union Strength on Board Elections", 
          label = "tab:unionMed", notes = list(stars.note), Sweave = TRUE)

unionMedtable <- apsrtable(full1, full3, full4, full5, full6, 
                           se = "robust", digits = 3, 
                  model.names = c("Ser. Cont.", "Compet.", 
                          "Turnout", "Rolloff", "Inc. Def."), 
          caption = "Mediation Estimates of Union Strength on Board Elections - Multilevel Models",           
          label = "tab:unionMedHLM", notes = list(stars.note), Sweave = TRUE, 
          stars = "default")
@
\end{small}

% Some evidence of union strength mediating turnout and incumbent defeat


