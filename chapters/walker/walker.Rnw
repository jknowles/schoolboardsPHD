                       "minBlaisLago", "incDefeats", "ImputedFlag", "distWidemix",
                       "distid", "year")]
outdata <- merge(outdata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))


outdata$treatmentDose <- ifelse(outdata$year >= 2011, abs(outdata$year - 2013), 0)
outdata$treatmentFactor <- ifelse(outdata$year >= 2011, 1, 0)
outdata$treatmentDiff <- ifelse(outdata$year >= 2011, abs(outdata$year - 2010), 0)
outdata$treatmentDiff <- factor(outdata$treatmentDiff)
outdata <- outdata[outdata$year > 2007, ]
outdata <- na.omit(outdata)
outdata <- outdata[!is.na(outdata$turnout_lag), ]
outdata <- outdata[!is.na(outdata$turnout), ]
outdata <- outdata[outdata$turnout > 0,]
outdata <- outdata[outdata$turnout_lag > 0,]
centr <- mean(outdata$turnout)
stddev <- sd(outdata$turnout)
outdata$outflag <- (outdata$turnout - centr) / stddev
outdata$outflag2 <- (outdata$turnout_lag - centr) / stddev
outdata <- outdata[outdata$outflag <= 5 & outdata$outflag >= -5,]
outdata <- outdata[outdata$outflag2 <= 5 & outdata$outflag2 >= -5,]
# outdata <- outdata[outdata$year > 2007, ]
outdata$turnout <- log(outdata$turnout)
outdata$turnout_lag <- log(outdata$turnout_lag)
outdata$minBlaisLago <- ifelse(outdata$minBlaisLago < 1, 1, outdata$minBlaisLago)
outdata$minBlaisLago_lag <- ifelse(outdata$minBlaisLago_lag < 1, 1, 
                                   outdata$minBlaisLago_lag)
outdata$minBlaisLago <- log(outdata$minBlaisLago)
outdata$minBlaisLago_lag <- log(outdata$minBlaisLago_lag)
outdata$incDefeats <- factor(outdata$incDefeats)
outdata$incDefeats_lag <- factor(outdata$incDefeats_lag)
library(arm)
nums <- sapply(outdata, is.numeric)
# nums["treatment"] <- FALSE
outdata[, nums] <- apply(outdata[, nums], 2, rescale)
outdata$VAP_adjLOG_sq_lag <- outdata$VAP_adjLOG_lag^2
simp1 <- glm(contestSer ~ contestSer_lag + treatmentDiff * WERC_str_lag+ 
              WERC_elec_lag + distWidemix, 
             data = outdata, family = 'binomial')
simp1$se <- sqrt(diag(get_CL_vcov(simp1, outdata$distid)))

simp2 <- glm(contestMinor ~ contestMinor_lag + treatmentDiff * WERC_str_lag+ 
              WERC_elec_lag + distWidemix, 
             data = outdata, family = 'binomial')
simp2$se <- sqrt(diag(get_CL_vcov(simp2, outdata$distid)))

simp3 <- lm(minBlaisLago ~ minBlaisLago_lag + treatmentDiff * WERC_str_lag + 
