full1 <- glmer(contestMinor ~ contestMinor_lag + treatmentDiff + 
                 VAP_adjLOG_lag + 
             VAP_adjLOG_sq_lag + per65o_lag + nraces_lag + OOH_share_lag +  
               PerBachelorOrAbove_lag + locale2_lag + WERC_elec_lag +
               treatmentDiff * WERC_str_lag + distWidemix + (1|distid), 
