\subsection{Turnout}

Using the election of Governor Walker and passage of Act 10 as an exogenous shock that 
increased the relevance and power of school boards, the following models seek to 
test the causal impact on turnout. In Figure \ref{fig:walkerplot} I examine the 
relationship between partisan polarization and turnout before and after the passage 
of Act 10. To test this relationship I restrict the sample to the two spring 
elections prior to the passage of Act 10 -- 2009 and 2010 -- and the two elections 
immediately after the passage of Act 10 -- 2011 and 2012. I code these latter 
years with a dummy variable indicating they are in the post-Act 10 era. The key 
theoretical contribution is that the polarization of the electorate should matter 
more after the passage of Act 10, when party lines for education issues became 
clear. 

<<walkerDataPrep2, results='asis', echo = FALSE, eval=FALSE>>=
## Grab Walker recall results
moddat <- dist_turn[, c("contestSer", "contestMinor", "distid","year", 
                        "balance_member_lag", "turnout", "VAP_adjLOG_sq",
                        "PerBachelorOrAbove", "VAP_adjLOG", "per_white_all", 
                        "districtwide", "turnoutLag1", "topTicketTurnoutSpring",
                        "OOH_share", "median_incomeLOG", "per65o", 
                        "NonWhitePublicPupilPer", "NonPublicPupilPer", 
                         "locale2", "incumShare", "contestMinorLag", 
                        "contestSerLag", "incDefeats", "nonincumbRun", 
                        "onlyIncum",
                        "overrideYesPer", "partyDivisionRecent", "turnoutLag2",
                        "teachShareofVoters", "fallTurnout", 
                        "nraces", "schoolMillShare", "PROPERTYTAX_REV_SHARE", 
                        "TCEC_MEMBER", "millrate_delta", 
                        "ADMIN_SHARE_COMP", "NEW_SUP", 
                        "DEBT_ATTEMPT_CUMUL93", "OVERRIDE_ATTEMPT_CUMUL93", 
                        "member_delta_per", "RecallPolarization",
                        "turnout_overall_werc", "minBlaisLago",
                        "eligvoters_werc", "fallTwoPartyShareDem",
                        "loss_werc", "worst_margin_werc", "WERC_elec", 
                        "GovTurnout_recall")]

moddat <- na.omit(moddat)
moddat <- moddat[moddat$year >= 2007,]
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$treatment <- ifelse(moddat$year > 2010, 1, 0)
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat$turnout <- moddat$turnout * 100
moddat$districtwide <- factor(moddat$districtwide)
moddat$treatment <- factor(moddat$treatment)
# moddat$turnoutLag2 <- moddat$turnoutLag2 * 100
# moddat$turnoutLag1 <- moddat$turnoutLag1 * 100
# moddat$per_white_all <- moddat$per_white_all * 100
# moddat$per65o <- moddat$per65o * 100
# moddat$PerBachelorOrAbove <- moddat$PerBachelorOrAbove * 100
# moddat$OOH_share <- moddat$OOH_share * 100
# moddat$fallTurnout <- moddat$fallTurnout * 100
# moddat$VAP_adj <- log(moddat$VAP_adj)
# moddat$median_income <- log(moddat$median_income)
moddat$WERC_elec <- factor(moddat$WERC_elec)
centr <- mean(moddat$turnout)
stddev <- sd(moddat$turnout)
moddat$outflag <- (moddat$turnout - centr) / stddev
moddat <- moddat[moddat$outflag <= 5 & moddat$outflag >= -5,]

library(rms)
dd <<- datadist(moddat)
options(datadist="dd")

nums <- sapply(moddat, is.numeric)
#   for(i in unique(moddat$year)){
#     moddat[moddat$year == i, nums] <- 
#       apply(moddat[moddat$year == i, nums], 2, rescale)
#   }
moddat[, nums] <- apply(moddat[, nums], 2, rescale)
@

<<walkerTurnMod, results='hide', eval=TRUE>>=
demogsMod1 <- lm(turnout ~ turnoutLag2 + fallTurnout + VAP_adjLOG + 
                   VAP_adjLOG_sq + per_white_all + per65o + PerBachelorOrAbove + 
                   OOH_share + median_incomeLOG + minBlaisLago + 
                   districtwide + RecallPolarization * treatment + 
                   turnout_overall_werc, data = moddat)
demogsMod1SE <- get_CL_vcov(demogsMod1, moddat$distid)
demogsMod1$se <- sqrt(diag(demogsMod1SE))
demogsMod2 <- lm(turnout ~ turnoutLag2 + fallTurnout + VAP_adjLOG + 
                   VAP_adjLOG_sq + per_white_all + per65o + PerBachelorOrAbove + 
                   OOH_share + median_incomeLOG + minBlaisLago + 
                   districtwide + GovTurnout_recall * treatment + 
                   turnout_overall_werc, data = moddat)
demogsMod2SE <- get_CL_vcov(demogsMod2, moddat$distid)
demogsMod2$se <- sqrt(diag(demogsMod2SE))
demogsMod3 <- lm(turnout ~ turnoutLag2 + fallTurnout + VAP_adjLOG + 
                   VAP_adjLOG_sq + per_white_all + per65o + PerBachelorOrAbove + 
                   OOH_share + median_incomeLOG + minBlaisLago + 
                   districtwide + GovTurnout_recall * treatment + 
                    RecallPolarization * treatment + 
                   turnout_overall_werc, data = moddat)
demogsMod3SE <- get_CL_vcov(demogsMod3, moddat$distid)
demogsMod3$se <- sqrt(diag(demogsMod3SE))
demogsMod4 <- lm(turnout ~ turnoutLag2 + fallTurnout + VAP_adjLOG + 
                   VAP_adjLOG_sq + per_white_all + per65o + PerBachelorOrAbove + 
                   OOH_share + median_incomeLOG + minBlaisLago + 
                   districtwide + GovTurnout_recall +
                    RecallPolarization + 
                   turnout_overall_werc*treatment, data = moddat)
demogsMod4SE <- get_CL_vcov(demogsMod4, moddat$distid)
demogsMod4$se <- sqrt(diag(demogsMod4SE))

lmTurnoutTable <- apsrtable(demogsMod1, demogsMod2, demogsMod3, demogsMod4, 
          se = "robust", label="tab:lmTurnoutmod", 
          caption = "Model of Causal Impact of Act 10 on School Board Turnout",
          Sweave=FALSE, digits = 3)
@

Table \ref{tab:meTurnout} shows good things. 

\begin{tiny}
<<turnoutMM, results='asis', echo = FALSE, eval=TRUE>>=
demogsMod1mm <- lmer(turnout ~ turnoutLag2 + fallTurnout + VAP_adjLOG + 
                   VAP_adjLOG_sq + per_white_all + per65o + PerBachelorOrAbove + 
                   OOH_share + median_incomeLOG + minBlaisLago + 
                   districtwide + RecallPolarization * treatment + 
                   turnout_overall_werc + (1|distid), data = moddat)
demogsMod2mm <- lmer(turnout ~ turnoutLag2 + fallTurnout + VAP_adjLOG + 
                   VAP_adjLOG_sq + per_white_all + per65o + PerBachelorOrAbove + 
                   OOH_share + median_incomeLOG + minBlaisLago + 
                   districtwide + GovTurnout_recall * treatment + 
                   turnout_overall_werc+ (1|distid), data = moddat)
demogsMod3mm <- lmer(turnout ~ turnoutLag2 + fallTurnout + VAP_adjLOG + 
                   VAP_adjLOG_sq + per_white_all + per65o + PerBachelorOrAbove + 
                   OOH_share + median_incomeLOG + minBlaisLago + 
