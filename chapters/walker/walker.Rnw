#                "Balance per Pupil", "Millrate $\\Delta$", "\\% Salary - Admin.", 
#                "New Superintendent", "\\% Private School", "Cumul. Bond Att.", 
#                "Cumul. Override Att.")

incDefGLMtable2 <- apsrtable(glmIncDeffisc, glmIncDefpolitic, glmIncDefPoly, 
                     se = "robust", float = "longtable", label="tab:glmModsD", 
                     model.names=c("Fiscal", "Politic", "Policy"), 
          caption = "Logit Models of Incumbent Defeat in School Board Elections",
          notes = list(stars.note, rescalenote),
          Sweave=FALSE, digits = 3)#, coef.names = coefnames3)
@

