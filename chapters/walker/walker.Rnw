plotdf$minBlaisLago <- log(plotdf$minBlaisLago)
plotdf$blaisLagoLag2 <- log(plotdf$blaisLagoLag2)
plotdf$blaisLagoLag2[!is.finite(plotdf$blaisLagoLag2)] <- -4
plotdf$minBlaisLago[!is.finite(plotdf$minBlaisLago)] <- -4
plotdf <- as.data.frame(plotdf)
plotdf <- na.omit(plotdf[, c("blaisLagoLag2", "minBlaisLago", "year")])
