outdata$incDefeats_lag <- factor(outdata$incDefeats_lag)
library(arm)
nums <- sapply(outdata, is.numeric)
# nums["treatment"] <- FALSE
outdata[, nums] <- apply(outdata[, nums], 2, rescale)
outdata$VAP_adjLOG_sq_lag <- outdata$VAP_adjLOG_lag^2
simp1 <- glm(contestSer ~ treatmentDiff * RecallPolarization_lag + 
               distWidemix + contestSer_lag  , 
             data = outdata, family = 'binomial')
simp1$se <- sqrt(diag(get_CL_vcov(simp1, outdata$distid)))

simp2 <- glm(contestMinor ~ treatmentDiff * RecallPolarization_lag +
               distWidemix + contestMinor_lag, 
             data = outdata, family = 'binomial')
