                  per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
               districtwide + 
                 RecallPolarization*treatment + treatment*GovTurnout_recall + 
                 distid, 
              data = moddat, family = 'binomial')

glmContestMinor3SE <- get_CL_vcov(glmContestMinor3, moddat$distid)
glmContestMinor3$se <- sqrt(diag(glmContestMinor3SE))

minorGLMtable <- apsrtable(glmContestMinor1, glmContestMinor2, glmContestMinor3, 
          se = "robust", label="tab:minMod", 
            caption = "Model of Causal Impact of Act 10 on School Board Candidacy",
          omitcoef=list("year", 
                        expression(grep("year", coefnames, value = TRUE)), 
                        "distid", expression(grep("distid", coefnames, 
                                                  value = TRUE))), 
          Sweave=TRUE)
@

