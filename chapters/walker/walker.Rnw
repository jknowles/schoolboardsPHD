\subsection{Contestation}

To test the effect of the passage of Act 10 on participation in school board elections, 
we fit a simple longitudinal model of school districts. In this model, school district 
elections are treated as repeated measures, nested within the school districts 
themselves. Using this repeated measures framework allows us to estimate cross 
district and within district effects. Act 10 represented a statewide intervention 
in the relative power of school boards in Wisconsin by giving school boards much 
more authority and control over the compensation of teachers and staff, and by 
dramatically restricting the ability of the districts' employees to bargain over 
wages, working conditions, and benefits. This shift in power, in essence, raised 
the stakes for school board elections substantially and should have increased the 
overall contestation of school board elections. 

To evaluate this, a series of models of school board election contestation over 
time are fit to attempt to detect changes in contestation levels relative to the 
levels of contestation observed in school districts prior to the passage of 
Act 10. If levels of contestation increase after the introduction of Act 10, even 
after controlling for the factors that influenced this above, it would be strong 
evidence that the statewide policy lever pulled by Act 10 did spur a response 
from candidates in terms of increasing the attractiveness of school board seats. 

<<walkerDataPrep, results='asis', echo = FALSE>>=
load("../../data/cache/springElectionVotes.rda")
# load("data/cache/springElectionVotes.rda")
springVotes$votesTopTicketSpring <- springVotes$VotesCast
springVotes$VotesCast <- NULL
dist_turn <- merge(dist_turn, springVotes, 
                   by = c("distid", "year"), all.x = TRUE)

dist_turn$topTicketTurnoutSpring <- dist_turn$votesTopTicketSpring / dist_turn$VAP_adj
dist_turn$turnoutDiff <- dist_turn$topTicketTurnoutSpring - dist_turn$turnout
## Grab Walker recall results
load("../../data/cache/WalkerRecall.rda")
# load("data/cache/WalkerRecall.rda")
## Bolt them on
distvotes12r <- distvotes12r[, -2]
distvotes12r$GovTwoPartyShareDem <- distvotes12r$GOVDEM / (distvotes12r$GOVDEM + 
                                                             distvotes12r$GOVREP)

names(distvotes12r) <- paste(names(distvotes12r), "recall", sep ="_")

dist_turn <- merge(dist_turn, distvotes12r, by.x = "distid", 
                   by.y = "distid_recall")

load("../../data/cache/WERC.rda")
# load("data/cache/WERC.rda")
names(wercDatTeachers) <- paste(names(wercDatTeachers), "werc", sep = "_")

dist_turn <- merge(dist_turn, wercDatTeachers, by.x = "distid", by.y = "distid_werc", 
                   all.x = TRUE)

NAzero <- function(x){
  x <- as.numeric(x)
  x[is.na(x)] <- 0 
  return(x)
}

dist_turn$WERC_elec <- ifelse(is.na(dist_turn$eligvoters_werc), 0, 1)
dist_turn$eligvoters_werc <- NAzero(dist_turn$eligvoters_werc)
dist_turn$voters_werc <- NAzero(dist_turn$voters_werc)
dist_turn$turnout_overall_werc <- NAzero(dist_turn$turnout_overall_werc)
dist_turn$tries_werc <- NAzero(dist_turn$tries_werc)
dist_turn$wins_werc <- NAzero(dist_turn$wins_werc)
dist_turn$loss_werc <- NAzero(dist_turn$loss_werc)
dist_turn$yes_votes_tot_werc <- NAzero(dist_turn$yes_votes_tot_werc)
dist_turn$no_votes_tot_werc <- NAzero(dist_turn$no_votes_tot_werc)
dist_turn$abst_votes_tot_werc <- NAzero(dist_turn$abst_votes_tot_werc)
dist_turn$yes_votes_avg_werc <- NAzero(dist_turn$yes_votes_avg_werc)
dist_turn$no_votes_avg_werc <- NAzero(dist_turn$no_votes_avg_werc)
dist_turn$abst_votes_avg_werc <- NAzero(dist_turn$abst_votes_avg_werc)
dist_turn$best_margin_werc <- NAzero(dist_turn$best_margin_werc)
dist_turn$worst_margin_werc <- NAzero(dist_turn$worst_margin_werc)
dist_turn$GovTurnout_recall <- dist_turn$RECTOT_recall / dist_turn$VAP_adj 


moddat <- dist_turn[, c("contestSer", "contestMinor", "distid","year", 
                        "balance_member_lag", "turnout",
                        "PerBachelorOrAbove", "VAP_adjLOG", "per_white_all", 
                        "districtwide", "turnoutLag1", "topTicketTurnoutSpring",
                        "OOH_share", "median_incomeLOG", "per65o", 
                        "NonWhitePublicPupilPer", "NonPublicPupilPer", 
                        "teachShareofVoters", "locale2", 
                        "member_delta_per", "GovTwoPartyShareDem_recall",
                        "turnout_overall_werc", "districtwide",
                        "eligvoters_werc", 
                        "loss_werc", "worst_margin_werc", "WERC_elec", 
                        "GovTurnout_recall")]

moddat <- na.omit(moddat)
moddat <- moddat[moddat$year > 2007,]
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$treatment <- ifelse(moddat$year > 2010, 1, 0)
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$turnoutLag1 <- moddat$turnoutLag1 * 100
moddat$districtwide <- factor(moddat$districtwide)
moddat$per_white_all <- moddat$per_white_all * 100
moddat$per65o <- moddat$per65o * 100
moddat$PerBachelorOrAbove <- moddat$PerBachelorOrAbove * 100
moddat$OOH_share <- moddat$OOH_share * 100
# moddat$fallTurnout <- moddat$fallTurnout * 100
moddat$RecallPolarization <- abs(moddat$GovTwoPartyShareDem_recall - 0.5)
moddat$RecallPolarization <- moddat$RecallPolarization * 100
moddat$turnout_overall_werc <- moddat$turnout_overall_werc * 100
moddat$topTicketTurnoutSpring <- moddat$topTicketTurnoutSpring * 100
moddat$turnout <- moddat$turnout * 100
moddat$GovTurnout_recall <- moddat$GovTurnout_recall * 100
moddat$GovTwoPartyShareDem_recall <- moddat$GovTwoPartyShareDem_recall *100
moddat$member_delta_per <- moddat$member_delta_per * 100
@

<<walkerplot, fig.cap="Polarization and Turnout Before and After Act 10">>=
qplot(contestMinor, RecallPolarization, data = moddat, geom = 'boxplot') + 
  facet_wrap(~year) +
  scale_y_continuous() +
  theme_dpi()

qplot(RecallPolarization, turnout, data = moddat[moddat$turnout < 80,], 
      color = factor(contestSer)) + 
  facet_wrap(~year) + geom_smooth(method = 'lm', aes(group = 1)) +
  scale_y_continuous() +
  theme_dpi()


# qplot(RecallPolarization, turnoutDiff, data = moddat) + geom_smooth(method = "lm") + 
#   facet_wrap(~year) + scale_x_continuous(label = percent) + 
#   scale_y_continuous(label = percent) +
#   theme_dpi()
@


<<walkerGLM, results='asis'>>=
causal1 <- glm(contestMinor ~ turnoutLag1 + VAP_adjLOG + per_white_all + 
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
               districtwide + RecallPolarization*treatment + 
               treatment + turnout_overall_werc, 
              data = moddat, family = 'binomial')

causal2 <- glm(contestMinor ~ turnoutLag1 + VAP_adjLOG + per_white_all + 
                 topTicketTurnoutSpring +
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
               districtwide + RecallPolarization*treatment + 
               treatment + turnout_overall_werc, 
              data = moddat, family = 'binomial')

# causal3 <- glm(contestSer ~ turnoutLag1 + VAP_adjLOG + per_white_all + 
#                per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
#                districtwide + RecallPolarization*treatment + 
#                treatment + turnout_overall_werc + distid, 
#               data = moddat, family = 'binomial')
# 


apsrtable(causal1, causal2, se = "vcov", label="tab:causmod1", 
          model.names=c("Naive Causal Model", "Overvote Model"), 
          caption = "Model of Causal Impact of Act 10 on School Board Candidacy",
          Sweave=FALSE)

# 
# zed1 <- lmer(turnout ~ turnoutLag2 + fallTurnout + VAP_adj + per_white_all + 
#                per65o + PerBachelorOrAbove + OOH_share + PCI + CLOSE + 
