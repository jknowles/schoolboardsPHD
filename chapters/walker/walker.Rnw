outdata <- outdata[outdata$outflag2 <= 5 & outdata$outflag2 >= -5,]
partialPanel <- names(table(outdata$distid)[table(outdata$distid) == 1])
outdata <- outdata[!outdata$distid %in% partialPanel, ]


lagModroll <- lm(turnoutDiff ~ turnoutDiff_lag + treatmentDiff + 
                   VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag + ImputedFlag + 
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag, 
             data = outdata)
lagModrollSE <- get_CL_vcov(lagModroll, outdata$distid)
lagModroll$se <- sqrt(diag(lagModrollSE))

DIDmodroll <- lm(turnoutDiff ~ turnoutDiff_lag * treatmentDiff + 
                   VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag+ ImputedFlag +
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag, 
             data = outdata)
DIDmodrollSE <- get_CL_vcov(DIDmodroll, outdata$distid)
DIDmodroll$se <- sqrt(diag(DIDmodrollSE))

merModroll <- lmer(turnoutDiff ~ turnoutDiff_lag * treatmentDiff + 
                   VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag+ ImputedFlag +
             locale2_lag + PerBachelorOrAbove_lag + fallTurnout_lag + 
               (1|distid), data = outdata)

FEmodRoll <- lm(turnoutDiff ~ treatmentDiff  + 
                   VAP_adjLOG_sq_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               median_incomeLOG_lag + ImputedFlag +
               PerBachelorOrAbove_lag + fallTurnout_lag +
               distid, data = outdata)
FEmodRoll$se <- sqrt(diag(get_CL_vcov(FEmodRoll, outdata$distid)))
