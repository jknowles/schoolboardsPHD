\section{Results}

I organize the results as follows. In the first section, I review the results 
for the models that leverage the years 2011 and 2012 as treated by a causal 
shock and I fit lagged time models and differences-in-differences estimates 
of the impact of Act 10 across five distinct measures of actualized democracy -- 
contestation, competitiveness, incumbent defeat, voter turnout, and voter 
rolloff. In the next section, I then step away from the causal framework and 
fit longitudinal models which seek to explore evidence, if any, that this causal 
impact was mediated. 

\subsection{Causal Estimates}

I provide three sets of results for each dependent variable. The first is a 
regression with a lagged dependent variable and demographic controls, the second 
is a differences in differences estimate, and the third is a difference in 
differences estimate with district level random effects.\footnote{I tested the 
models on a restricted sample with only years after 2007, but this had no 
substantive impact on the results.}

%tab:causMinorCon
<<contestDID, eval=TRUE, results = 'hide'>>=
library(lme4)
library(optimx)
ctrl2 <- glmerControl(optimizer = "optimx", calc.derivs = FALSE, 
                     optCtrl = list(method = "nlminb", starttests = FALSE, 
                                    kkt = FALSE, maxit = 10000))
ctrl <- glmerControl(optimizer = "Nelder_Mead", calc.derivs = FALSE)

outdata <- dist_turn[, c("distid", "year", "contestMinor", "VAP_adjLOG_sq", 
                         "VAP_adjLOG", "per65o", "NonPublicPupilPer", 
                         "incumShare", "teachShareofVoters", 
                         "fallTurnout", "nraces", "schoolMillShare", "OOH_share",
                         "PerBachelorOrAbove", 
                         "PROPERTYTAX_REV_SHARE", "minBlaisLago", "per_white_all",
                         "GovTurnout_recall", "RecallPolarization", "locale2", 
                         "econ_disadv_per")]

preTreat <- outdata[outdata$year <= 2010,]
preTreat$year <- preTreat$year + 1
names(preTreat) <- paste(names(preTreat), "lag", sep = "_")

# Repeat 2010 data as pre-treatment for 2012
tmp <- preTreat[preTreat$year_lag == 2011,]
tmp$year_lag <- 2012
preTreat <- rbind(preTreat, tmp)
rm(tmp)

outdata <- outdata[, c("contestMinor", "distid", "year")]
outdata <- merge(outdata, preTreat, by.y = c("distid_lag", "year_lag"), 
                 by.x = c("distid", "year"))
outdata$treatmentDose <- ifelse(outdata$year >= 2011, abs(outdata$year - 2013), 0)
outdata$treatmentFactor <- ifelse(outdata$year >= 2011, 1, 0)
outdata$treatmentDiff <- ifelse(outdata$year >= 2011, abs(outdata$year - 2010), 0)
outdata$treatmentDiff <- factor(outdata$treatmentDiff)
partialPanel <- names(table(outdata$distid)[table(outdata$distid) == 1])
outdata <- outdata[!outdata$distid %in% partialPanel, ]

lagModcontest <- glm(contestMinor ~ contestMinor_lag + treatmentDiff + 
                       VAP_adjLOG_sq_lag + incumShare_lag +
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag + 
               PerBachelorOrAbove_lag +  locale2_lag, data = outdata, 
             family = "binomial")
lagModcontestSE <- get_CL_vcov(lagModcontest, outdata$distid)
lagModcontest$se <- sqrt(diag(lagModcontestSE))

DIDmodContest <- glm(contestMinor ~ contestMinor_lag * treatmentDiff + 
                       VAP_adjLOG_sq_lag + incumShare_lag + 
             VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag +  
               PerBachelorOrAbove_lag +
             locale2_lag, data = outdata, family = "binomial")
DIDmodContestSE <- get_CL_vcov(DIDmodContest, outdata$distid)
DIDmodContest$se <- sqrt(diag(DIDmodContestSE))

FEmodContest <- glm(contestMinor ~ treatmentDiff + nraces_lag +
                      incumShare_lag + distid, 
                    data = outdata, family = "binomial")
FEmodContest$se <- sqrt(diag(get_CL_vcov(FEmodContest, outdata$distid)))


# 
# MermodContest <- glmer(contestMinor ~ contestMinor_lag * treatmentDiff + 
#                          VAP_adjLOG_sq_lag + incumShare_lag + 
#              VAP_adjLOG_lag + per65o_lag + nraces_lag + OOH_share_lag +  
#                PerBachelorOrAbove_lag + locale2_lag + (1|distid), 
#              data = outdata, family = "binomial", control = ctrl)

# causMinorConTab <- apsrtable(lagModcontest, DIDmodContest, 
#                              MermodContest, se = "robust", 
#           model.names = c("Lag", "Diff in Diff", "Multilevel"), 
#           stars = "default", 
#           caption = "Causal Estimates of Act 10 Period on Minor Contestation", 
#           label = "tab:causMinorCon", notes = list(stars.note), digits = 3, 
#           Sweave = TRUE)

omitNote <- "Fixed effect model includes district fixed effects - not reported."
causMinorConTab <- apsrtable(lagModcontest, DIDmodContest, FEmodContest, 
                             se = "robust", 
          stars = "default", digits = 3, model.names = c("Lag", "DnD", "FE"), 
          caption = "Causal Estimates of Act 10 Period on Contestation", 
          label = "tab:causBL", notes = list(stars.note, omitNote), 
          Sweave = TRUE, 
           omitcoef=list("distid", 
                         expression(grep("distid", coefnames, value=TRUE))))

@


%tab:causSerCon
