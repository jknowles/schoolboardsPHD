summPlot <- ddply(plotdf2, .(year), summarize, 
                  meanEff = mean(plotPred))

qplot(factor(year), exp(plotPred), data = plotdf2, geom = 'boxplot') + 
  geom_line(data = summPlot, aes(x = factor(year), y = exp(meanEff), group = 1)) + 
