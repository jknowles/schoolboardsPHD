#              data = moddat)

@

Table \ref{tab:causmod1} shows good things. 

<<walkerPartialPool, results='asis', echo = FALSE>>=
library(optimx)
ctrl <- glmerControl(optimizer = "optimx", optCtrl = list(method = "nlminb", 
                                                          maxit = 4000))
library(arm)
moddat$turnoutLag1 <- rescale(moddat$turnoutLag1)
moddat$VAP_adjLOG <- rescale(moddat$VAP_adjLOG)
moddat$per_white_all <- rescale(moddat$per_white_all)
moddat$per65o <- rescale(moddat$per65o)
moddat$PerBachelorOrAbove <- rescale(moddat$PerBachelorOrAbove)
moddat$OOH_share <- rescale(moddat$OOH_share)
moddat$median_incomeLOG <- rescale(moddat$median_incomeLOG)
moddat$RecallPolarization <- rescale(moddat$RecallPolarization)
moddat$topTicketTurnoutSpring <- rescale(moddat$topTicketTurnoutSpring)
moddat$turnout_overall_werc <- rescale(moddat$turnout_overall_werc)

mixedModCaus <- glmer(contestSer ~ turnoutLag1 + VAP_adjLOG + per_white_all + 
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
               districtwide + RecallPolarization*treatment + turnout_overall_werc +
               treatment + (1|distid), 
              data = moddat, family = 'binomial', control = ctrl)

mixedModCaus2 <- glmer(contestSer ~ turnoutLag1 + VAP_adjLOG + per_white_all + 
                        topTicketTurnoutSpring +
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
               districtwide + RecallPolarization*treatment + 
               treatment + turnout_overall_werc + (1|distid), 
              data = moddat, family = 'binomial', control = ctrl)

apsrtable(mixedModCaus, se = "vcov", label="tab:causME", 
          model.names=c("Naive Causal Model"), 
          caption = "Partial Pooled Model of Causal Impact of Act 10 on School Board Candidacy",
          Sweave=FALSE)


@
\clearpage

\subsection{Turnout}

Using the election of Governor Walker and passage of Act 10 as an exogenous shock that 
increased the relevance and power of school boards, the following models seek to 
test the causal impact on turnout. In Figure \ref{fig:walkerplot} I examine the 
relationship between partisan polarization and turnout before and after the passage 
of Act 10. To test this relationship I restrict the sample to the two spring 
elections prior to the passage of Act 10 -- 2009 and 2010 -- and the two elections 
immediately after the passage of Act 10 -- 2011 and 2012. I code these latter 
years with a dummy variable indicating they are in the post-Act 10 era. The key 
theoretical contribution is that the polarization of the electorate should matter 
more after the passage of Act 10, when party lines for education issues became 
clear. 

<<walkerDataPrep, results='asis', echo = FALSE>>=
## Grab Walker recall results

load("../../data/cache/WalkerRecall.rda")
# load("data/cache/WalkerRecall.rda")
## Bolt them on
distvotes12r <- distvotes12r[, -2]
distvotes12r$GovTwoPartyShareDem <- distvotes12r$GOVDEM / (distvotes12r$GOVDEM + 
                                                             distvotes12r$GOVREP)

names(distvotes12r) <- paste(names(distvotes12r), "recall", sep ="_")

dist_turn <- merge(dist_turn, distvotes12r, by.x = "distid", 
                   by.y = "distid_recall")

load("../../data/cache/WERC.rda")
# load("data/cache/WERC.rda")
names(wercDatTeachers) <- paste(names(wercDatTeachers), "werc", sep = "_")

dist_turn <- merge(dist_turn, wercDatTeachers, by.x = "distid", by.y = "distid_werc", 
                   all.x = TRUE)

NAzero <- function(x){
  x <- as.numeric(x)
  x[is.na(x)] <- 0 
  return(x)
}

dist_turn$WERC_elec <- ifelse(is.na(dist_turn$eligvoters_werc), 0, 1)
dist_turn$eligvoters_werc <- NAzero(dist_turn$eligvoters_werc)
dist_turn$voters_werc <- NAzero(dist_turn$voters_werc)
dist_turn$turnout_overall_werc <- NAzero(dist_turn$turnout_overall_werc)
dist_turn$tries_werc <- NAzero(dist_turn$tries_werc)
dist_turn$wins_werc <- NAzero(dist_turn$wins_werc)
dist_turn$loss_werc <- NAzero(dist_turn$loss_werc)
dist_turn$yes_votes_tot_werc <- NAzero(dist_turn$yes_votes_tot_werc)
dist_turn$no_votes_tot_werc <- NAzero(dist_turn$no_votes_tot_werc)
dist_turn$abst_votes_tot_werc <- NAzero(dist_turn$abst_votes_tot_werc)
dist_turn$yes_votes_avg_werc <- NAzero(dist_turn$yes_votes_avg_werc)
dist_turn$no_votes_avg_werc <- NAzero(dist_turn$no_votes_avg_werc)
dist_turn$abst_votes_avg_werc <- NAzero(dist_turn$abst_votes_avg_werc)
dist_turn$best_margin_werc <- NAzero(dist_turn$best_margin_werc)
dist_turn$worst_margin_werc <- NAzero(dist_turn$worst_margin_werc)
dist_turn$GovTurnout_recall <- dist_turn$RECTOT_recall / dist_turn$VAP_adj 
# load("../../data/cache/springElectionVotes.rda")
# # load("data/cache/springElectionVotes.rda")
# springVotes$votesTopTicketSpring <- springVotes$VotesCast
# springVotes$VotesCast <- NULL
# dist_turn <- merge(dist_turn, springVotes, by = c("distid", "year"))
# dist_turn$topTicketTurnoutSpring <- dist_turn$votesTopTicketSpring / dist_turn$VAP_adj
moddat <- dist_turn[, c("turnout", "turnoutLag2", "year", "fallTurnout", "VAP_adjLOG", "distid", 
                        "per_white_all", "per65o", "PerBachelorOrAbove", "OOH_share", "median_incomeLOG", 
                        "CLOSE", "districtwide", "contest", "GovTwoPartyShareDem_recall",
                        "teachShareofVoters", "turnout_overall_werc", "eligvoters_werc", 
                        "loss_werc", "worst_margin_werc", "WERC_elec", 
                        "topTicketTurnoutSpring", "turnoutDiff", "GovTurnout_recall")]

moddat <- na.omit(moddat)
moddat <- moddat[moddat$year > 2008,]
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$treatment <- ifelse(moddat$year > 2010, 1, 0)

moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat$turnout <- moddat$turnout * 100
moddat$districtwide <- factor(moddat$districtwide)
# moddat$turnoutLag2 <- moddat$turnoutLag2 * 100
# moddat$turnoutLag1 <- moddat$turnoutLag1 * 100
# moddat$per_white_all <- moddat$per_white_all * 100
# moddat$per65o <- moddat$per65o * 100
# moddat$PerBachelorOrAbove <- moddat$PerBachelorOrAbove * 100
# moddat$OOH_share <- moddat$OOH_share * 100
# moddat$fallTurnout <- moddat$fallTurnout * 100
# moddat$VAP_adj <- log(moddat$VAP_adj)
# moddat$median_income <- log(moddat$median_income)

centr <- mean(moddat$turnout)
stddev <- sd(moddat$turnout)
moddat$outflag <- (moddat$turnout - centr) / stddev
moddat <- moddat[moddat$outflag <= 5 & moddat$outflag >= -5,]
moddat$RecallPolarization <- abs(moddat$GovTwoPartyShareDem_recall - 0.5)

dd <<- datadist(moddat)
options(datadist="dd")

@

<<walkerplot, fig.cap="Polarization and Turnout Before and After Act 10">>=
qplot(RecallPolarization, turnout/100, data = moddat) + geom_smooth(method = "lm") + 
  facet_wrap(~year) + scale_x_continuous(label = percent) + 
  scale_y_continuous(label = percent) +
  theme_dpi()

# qplot(RecallPolarization, turnoutDiff, data = moddat) + geom_smooth(method = "lm") + 
#   facet_wrap(~year) + scale_x_continuous(label = percent) + 
#   scale_y_continuous(label = percent) +
#   theme_dpi()
@


<<walkerOLSmod, results='asis'>>=
causal1 <- ols(turnout ~ turnoutLag2 + fallTurnout + VAP_adjLOG + per_white_all + 
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + CLOSE + 
               districtwide + contest + RecallPolarization*treatment + 
               treatment + turnout_overall_werc, 
              data = moddat, x = TRUE, y = TRUE)

causal1$se <- sqrt(diag(vcov(robcov(causal1, cluster = moddat$distid))))

causal2 <- ols(turnout ~ turnoutLag2 + fallTurnout + VAP_adjLOG + 
                 per_white_all + topTicketTurnoutSpring +
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + CLOSE + 
               districtwide + contest + RecallPolarization*treatment + 
               treatment + turnout_overall_werc, 
              data = moddat, x = TRUE, y = TRUE)

causal2$se <- sqrt(diag(vcov(robcov(causal2, cluster = moddat$distid))))


apsrtable(causal1, causal2, se = "robust", label="tab:causmod1", 
          model.names=c("Naive Causal Model", "Overvote Model"), 
          caption = "Model of Causal Impact of Act 10 on School Board Elections",
          Sweave=FALSE)

# 
# zed1 <- lmer(turnout ~ turnoutLag2 + fallTurnout + VAP_adj + per_white_all + 
#                per65o + PerBachelorOrAbove + OOH_share + median_income + CLOSE + 
#                districtwide + contest + RecallPolarization*treatment + 
#                treatment + turnout_overall_werc + (1|distid), 
#              data = moddat)

@

Table \ref{tab:causmod1} shows good things. 

<<walkerPartialPool, results='asis', echo = FALSE>>=
mixedModCaus <- lmer(turnout ~turnoutLag2 + fallTurnout + VAP_adjLOG + per_white_all + 
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + CLOSE + 
               districtwide + contest + RecallPolarization*treatment + 
               treatment + turnout_overall_werc + (1|distid) + (1|year), 
              data = moddat)

mixedModCaus2 <- lmer(turnoutDiff*100 ~ turnoutLag2 + fallTurnout + VAP_adjLOG + 
                 per_white_all + topTicketTurnoutSpring +
               per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + CLOSE + 
               districtwide + contest + RecallPolarization*treatment + 
               treatment + turnout_overall_werc + (1|distid) + (1|year), 
              data = moddat)

apsrtable(mixedModCaus, caption = "Partial Pooling Model of Post-Election Polarization",
          model.names = c("Partial Pooled"),
            label = "tab:causModme", notes = list(tabnote, stars.note), 
          Sweave = FALSE)
@

Table \ref{tab:causModme} shows the results here.

