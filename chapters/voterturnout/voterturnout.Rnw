\subsection{Rational Voters}

My second empirical question is to examine the relationship between electorate size 
and turnout, and electorate size, margin of victory and turnout.

<<closeModRLM, results ='asis'>>=
moddat <- dist_turn[, c("turnout", "turnoutLag2", "year", "fallTurnout", 
                        "VAP_adjLOG", "distid", "incumShare",
                        "per_white_all", "per65o", "PerBachelorOrAbove", 
                        "OOH_share", "median_incomeLOG", "districtwide", 
                        "contest", "minBlaisLago")]
moddat <- na.omit(moddat)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat$turnout <- moddat$turnout * 100
moddat$districtwide <- factor(moddat$districtwide)
moddat$contest <- factor(moddat$contest)
centr <- mean(moddat$turnout)
stddev <- sd(moddat$turnout)
moddat$outflag <- (moddat$turnout - centr) / stddev
moddat <- moddat[moddat$outflag <= 5 & moddat$outflag >= -5,]

nums <- sapply(moddat, is.numeric)
ScaleMeans <- apply(moddat[, nums], 2, mean, na.rm=TRUE)
ScaleSD <- apply(moddat[, nums], 2, sd, na.rm=TRUE)
moddatScaleClose <- cbind(ScaleMeans, ScaleSD); rm(ScaleMeans, ScaleSD)
nums <- sapply(moddat, is.numeric)
moddat[, nums] <- apply(moddat[, nums], 2, rescale)
moddat$VAP_adjLOG_sq <- moddat$VAP_adjLOG^2
dd <<- datadist(moddat)
options(datadist="dd")

closeRLM <- ols(turnout ~ VAP_adjLOG + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
                  districtwide + minBlaisLago, 
              data = moddat, x = TRUE, y = TRUE)

closeRLM$se <- sqrt(diag(vcov(robcov(closeRLM, cluster = moddat$distid))))
closeRLM2 <- ols(turnout ~ VAP_adjLOG + VAP_adjLOG_sq + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
                   districtwide + incumShare + minBlaisLago + factor(year),
              data = moddat, x= TRUE, y = TRUE)
closeRLM2$se <- sqrt(diag(vcov(robcov(closeRLM2, cluster = moddat$distid))))
closeRLM3 <- ols(turnout ~ VAP_adjLOG + VAP_adjLOG_sq+ per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
                   districtwide + incumShare + contest * VAP_adjLOG + factor(year) + factor(distid), 
              data = moddat, x = TRUE, y = TRUE)
closeRLM3$se <- sqrt(diag(vcov(robcov(closeRLM3, cluster = moddat$distid))))
closeRLM4 <- ols(turnout ~ VAP_adjLOG + VAP_adjLOG_sq+ minBlaisLago*VAP_adjLOG + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
                   districtwide + incumShare + minBlaisLago + factor(year) + factor(distid), 
              data = moddat, x = TRUE, y = TRUE)
closeRLM4$se <- sqrt(diag(vcov(robcov(closeRLM4, cluster = moddat$distid))))


closeCoefs1 <- c("Intercept", "Electorate Size", 
                  "Electorate Size\\textsuperscript{2}", "\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% Owner Occupied", 
                "Median Income", "District-wide", "Incumbent Share",
                 "Competitiveness", "Elec. Size x Competitiveness")

closeModTab <- apsrtable(closeRLM2, closeRLM4, se="robust", 
          label="tab:closemods", 
          model.names=c("No Interact", "Interact + Year FE"), 
          caption = "Models of Competitiveness and Turnout in School Board Elections",
          notes = list(se.note, stars.note, "Year and district fixed effects omitted."),
          omitcoef=list("distid", 
                        expression(grep("distid", coefnames, value=TRUE)), 
                        "year", 
                        expression(grep("year", coefnames, value = TRUE))),
          coef.names = closeCoefs1, digits = 3,
          Sweave=FALSE, stars = "default", size = "scriptsize")
@


<<cleanupa, echo=FALSE,results='hide'>>=
rm(ADMIN, VAP_dist, dist.tmp, dvp, errors, plotdf, presTurn, canInterp,
   canInterpIDX, centr, dumbRLM1, dumbRLM1b, dumbRLM2, dumbRLM2b, dumbRLMbest, 
   dumbRLMbestb, i, j)
@

The key coefficient in Table \ref{tab:meClose} is the measure of competitiveness 
and its interaction with electorate size. I use the continuous measure 
of the Blais-Lago quotient to represent how competitive 
the races are, with a higher values corresponding to more competitive races. The 
control variables are the same from those in Table \ref{tab:meTurnout}. As 
expected, uncontested races have lower turnout than contested races. Also, as the 
share of all candidates in the race who are incumbents increases, not unsurprisingly, 
turnout decreases. However, the expectation that the relationship between 
competitiveness and district size would have an effect on turnout is not confirmed 
here - the interaction term is not statistically significant although it is in the 
right direction.\footnote{The fixed effect models are largely the same.}


<<closeModMM, results='asis'>>=
mixedModclose <- lmer(turnout ~  VAP_adjLOG + VAP_adjLOG_sq +
                     per_white_all + 
                    per65o + PerBachelorOrAbove + OOH_share + 
                    median_incomeLOG + districtwide + incumShare +
                  minBlaisLago  + (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

mixedModcloseB <- lmer(turnout ~  VAP_adjLOG +  VAP_adjLOG_sq + 
                     per_white_all + 
                     per65o + PerBachelorOrAbove + OOH_share + 
                     median_incomeLOG + districtwide + incumShare + 
                       contest * VAP_adjLOG + 
                   (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

mixedModcloseC <- lmer(turnout ~  VAP_adjLOG +  VAP_adjLOG_sq + 
                     per_white_all + 
                     per65o + PerBachelorOrAbove + OOH_share + 
                     median_incomeLOG + districtwide + incumShare + 
                       minBlaisLago * VAP_adjLOG + 
                   (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

closeCoefs2 <- c("Intercept", "Electorate Size", 
                  "Electorate Size\\textsuperscript{2}", "\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% OOH", 
                  "ln(MedianIncome)", "District-wide", "Incumbent Share", 
                   "Blais-Lago", "VAP x Blais-Lago")


# summary(mixedMod2)
apsrtable(mixedModclose, mixedModcloseC, 
          caption = "Partial Pooling Models of Competitiveness",
          model.names = c("No Interaction", "Interaction"),
            label = "tab:meClose", notes = list(tabnote, stars.note), 
          coef.names = closeCoefs2, digits = 3,
          Sweave = FALSE, stars = "default", size = "footnotesize")

# Results with fallTurnout are largely similar but demographic variables are not 
# significant and less impactful due to collinearity with fall turnout
@

