plotInt <- coefficients(lm(yUnscale ~ x1Unscale, data = plotdf))[1]

cases <- sample(unique(plotdf$distid), 12)
plotdf <- plotdf[plotdf$distid %in% cases, ]


ggplot(plotdf, aes(x = x1Unscale, y = yUnscale)) +
         geom_point() + 
  geom_point(aes(x = x1Unscale, y = yhatUnscale), color = I("red")) + 
  geom_point(aes(x = x1Unscale, y = yhatFixed), color = I("purple")) +
  geom_smooth(aes(x = x1Unscale, y = yUnscale), method = "lm", 
              se = FALSE, color = I("black")) + 
  geom_smooth(aes(x = x1Unscale, y = yhatUnscale), method = "lm", 
              se = FALSE, color = I("red")) + 
  geom_smooth(aes(x = x1Unscale, y = yhatFixed), method = "lm", 
              se = FALSE, color = I("purple")) +
  facet_wrap(~distid) + 
  geom_abline(intercept = plotInt, slope = plotSlope, linetype=2) +
  xlim(c(0, max(plotdf$x1Unscale))) + 
  theme_bw()

# Bootstrap the beta coefficients here using bootMer
# http://glmm.wikidot.com/faq
@


<<bootRMSE, results='hide'>>=
library(boot)
RMSE.merMod <- function(mod){
  sqrt(mean(residuals(mod)^2))
}

bootRMSE <- function(data, indx, model){
  moddat <- data[indx, ]
  modb <- eval(model@call)
  RMSE.merMod(modb)
}

sigmaBoot <- boot(mixedModP@frame, bootRMSE, R = 100, model = mixedModP)
out <- cbind(summary(sigmaBoot), mod  = "mixedmodP")
sigmaBoot <- boot(mixedModlags@frame, bootRMSE, R = 100, model = mixedModlags)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedModlags"))
sigmaBoot <- boot(mixedMod1lagsb@frame, bootRMSE, R = 100, model = mixedMod1lagsb)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedMod1lagsb"))
sigmaBoot <- boot(mixedModcloseC@frame, bootRMSE, R = 100, model = mixedModcloseC)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedModcloseC"))
sigmaBoot <- boot(mixedModclose@frame, bootRMSE, R = 100, model = mixedModclose)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedModclose"))
sigmaBoot <- boot(mixedModcloseB@frame, bootRMSE, R = 100, model = mixedModcloseB)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedModcloseB"))
sigmaBoot <- boot(mixedModteach@frame, bootRMSE, R = 100, model = mixedModteach)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedModteach"))
sigmaBoot <- boot(mixedModteachB@frame, bootRMSE, R = 100, model = mixedModteachB)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedModteachB"))
sigmaBoot <- boot(mixedModPb@frame, bootRMSE, R = 100, model = mixedModPb)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedModPb"))

rmsePlot1 <- ggplot(out, aes(x = mod, y = bootMed, ymax = bootMed + (bootSE *2), 
                ymin = bootMed - (bootSE *2))) + 
  geom_pointrange() + geom_point(aes(x = mod, y = original), color = I("red")) + 
  labs(x = "Model Name", y = "Model RMSE", title = "Turnout Models") + 
  coord_flip() + theme_dpi()
@

<<bootRMSE2, results='hide'>>=
sigmaBoot <- boot(undervoteMMclose@frame, bootRMSE, R = 100, model = undervoteMMclose)
out <- cbind(summary(sigmaBoot), mod  = "undervoteMMclose")
sigmaBoot <- boot(undervoteMMcloseB@frame, bootRMSE, R = 100, model = undervoteMMcloseB)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "undervoteMMcloseB"))
