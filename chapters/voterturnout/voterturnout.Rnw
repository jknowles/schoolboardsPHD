<<randomEffectplot1, eval=TRUE, fig.cap="Comparing District Intercepts on Standardized Coefficient Scale">>=
replotdf <- 1
while(class(replotdf) != "data.frame"){
  replotdf <- try(substEffSimRE(mixedModP, "distid", ncases = 3, alpha = 0.1), 
                  silent = TRUE)
}

replotdf$distid <- as.character(replotdf$distid)
replotdf$yhatUnscale <- (replotdf[, "yhat"] * 2 * moddatScaleParty[1, 2]) + moddatScaleParty[1, 1]
replotdf$yhatUnscale <- replotdf$yhatUnscale / 100
replotdf$lwrUnscale <- (replotdf[, "lwr"] * 2 * moddatScaleParty[1, 2]) + moddatScaleParty[1, 1]
replotdf$lwrUnscale <- replotdf$lwrUnscale / 100
replotdf$uprUnscale <- (replotdf[, "upr"] * 2 * moddatScaleParty[1, 2]) + moddatScaleParty[1, 1]
replotdf$uprUnscale <- replotdf$uprUnscale / 100

lowerBar <- ((quantile(fitted(mixedModP), prob = 0.25) * 2 * moddatScaleParty["turnout", 2]) + 
      moddatScaleParty["turnout", 1]) /100
upperBar <- ((quantile(fitted(mixedModP), prob = 0.75) * 2 * moddatScaleParty["turnout", 2]) + 
      moddatScaleParty["turnout", 1]) / 100

p0 <- ggplot(data = replotdf, aes(x = reorder(distid, -yhatUnscale), y = yhatUnscale, 
                            ymin = lwrUnscale, ymax = uprUnscale)) + 
  geom_line(aes(group = caseID)) + 
    geom_ribbon(aes(group = caseID), alpha=0.4) + 
  theme_dpi(base_size=12) + 
  theme(axis.text.x = element_blank(), axis.ticks.x = element_blank(), 
                      strip.text = element_blank(), 
                      strip.background = element_blank(), 
                      panel.grid.minor = element_blank(), 
                      panel.grid.major = element_blank()) + 
  geom_hline(yintercept = lowerBar, linetype = 2) + 
  geom_hline(yintercept = upperBar, linetype = 2) + 
  facet_wrap(~caseID, ncol = 1) + 
  labs(x = "District", y = "Predicted SB Turnout", title = "Party Model") + 
  scale_y_continuous(label = percent)

plotdf <- REsim(mixedModP, nsims = 1000)
plotdf <- plotdf[plotdf$level == "Level 1",]
p1 <- plotMCMCre(plotdf, scale = 1.96, var = "mean", 
               sd = "sd", sigmaScale = sigma(mixedModP)) + 
  labs(title = "Partisan Model", x= "District", y = "Intercept")+ 
  ylim(c(-2, 3.5))
plotdf <- REsim(mixedModclose, nsims = 1000)
plotdf <- plotdf[plotdf$level == "Level 1",]
p2 <- plotMCMCre(plotdf, scale = 1.96, var = "mean", 
                 sd = "sd", sigmaScale = sigma(mixedModclose)) + 
  labs(title = "Competitiveness Model", x= "District", y = "Intercept")+ 
  ylim(c(-2, 3.5))
plotdf <- REsim(mixedModteach, nsims = 1000)
plotdf <- plotdf[plotdf$level == "Level 1",]
p3 <- plotMCMCre(plotdf, scale = 1.96, var = "mean", 
                 sd = "sd", sigmaScale = sigma(mixedModteach))+ 
  labs(title = "Teach Share Model", x= "District", y = "Intercept")+ 
  ylim(c(-2, 3.5))
plotdf <- REsim(mixedModlags, nsims = 1000)
plotdf <- plotdf[plotdf$level == "Level 1",]
p4 <- plotMCMCre(plotdf, scale = 1.96, var = "mean", 
                 sd = "sd", sigmaScale = sigma(mixedModlags))+ 
  labs(title = "Lagged Model", x= "District", y = "Intercept") + 
  ylim(c(-2, 3.5))

grid.arrange(p1, p2, p3, p4)
@

Even more interestingly is the pattern for the year effects demonstrated in 
Figure \ref{fig:randomEffectplot2}. In all four models we see one below average year, 
2010, and three above average years -- 2003, 2011, and 2012. These above average 
years are not always statistically different than zero -- 2003 tends to have many 
fewer observations than the other years -- but statewide spring election specific 
effects do appear to exert an influence on school board turnout. Most interestingly 
is that two years of elevated turnout across the state (net of district-election and 
district-average effects) were in 2011 and 2012 after the election of Governor Scott Walker 
and the introduction of Act 10. 

