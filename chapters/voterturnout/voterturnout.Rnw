# Test for year specific slopes
m.slope <- update(mixedMod1lagsb, . ~ . - (1|year))
m0 <- update(mixedMod1lagsb, . ~ . - (1|distid))
lagLRT <- exactRLRT(m.slope, mixedMod1lagsb, m0)
lagLRT$callFull <- mixedMod1lagsb@call
lagLRT$callSmall <- m.slope@call
@

\subsection{Rational Voters}

My second empirical question was to examine the relationship between electorate size 
and turnout, and electorate size, margin of victory and turnout. I use an adjusted estimate 
of the voting age population - the denominator in the turnout variable - to serve as 
an estimate of the electorate size.\footnote{Address possible endogeneity here with 
the dependent variable.} This is a conservative estimate of the actual electorate 
size in school board elections, which as can be as low as 15\% of the voting 
age population. If is is assumed that voters adjust the electorate size equally across jurisdictions 
when making their assessment of the perceived uiltity of voting, then this is not a factor. 
If there is evidence that voters in different jurisdicstions have more information about the 
likely electorate size in a school board election, and this varies across jurisdictions, 
then this becomes more problematic. 

<<closeModRLM, results ='asis'>>=
moddat <- dist_turn[, c("turnout", "turnoutLag2", "year", "fallTurnout", 
                        "VAP_adjLOG", "distid", "incumbent",
                        "per_white_all", "per65o", "PerBachelorOrAbove", 
                        "OOH_share", "median_incomeLOG", "districtwide", 
                        "contest", "minBlaisLago")]
moddat <- na.omit(moddat)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat$turnout <- moddat$turnout * 100
moddat$districtwide <- factor(moddat$districtwide)
moddat$contest <- factor(moddat$contest)
moddat$VAP_adjLOG_sq <- moddat$VAP_adjLOG^2
centr <- mean(moddat$turnout)
stddev <- sd(moddat$turnout)
moddat$outflag <- (moddat$turnout - centr) / stddev
moddat <- moddat[moddat$outflag <= 5 & moddat$outflag >= -5,]

nums <- sapply(moddat, is.numeric)
ScaleMeans <- apply(moddat[, nums], 2, mean, na.rm=TRUE)
ScaleSD <- apply(moddat[, nums], 2, sd, na.rm=TRUE)
moddatScaleClose <- cbind(ScaleMeans, ScaleSD); rm(ScaleMeans, ScaleSD)
nums <- sapply(moddat, is.numeric)
moddat[, nums] <- apply(moddat[, nums], 2, rescale)

dd <<- datadist(moddat)
options(datadist="dd")

closeRLM <- ols(turnout ~ VAP_adjLOG + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
                  districtwide + minBlaisLago, 
              data = moddat, x = TRUE, y = TRUE)

closeRLM$se <- sqrt(diag(vcov(robcov(closeRLM, cluster = moddat$distid))))
closeRLM2 <- ols(turnout ~ VAP_adjLOG + VAP_adjLOG_sq + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
                   districtwide + minBlaisLago + factor(year),
              data = moddat, x= TRUE, y = TRUE)
closeRLM2$se <- sqrt(diag(vcov(robcov(closeRLM2, cluster = moddat$distid))))
closeRLM3 <- ols(turnout ~ VAP_adjLOG + VAP_adjLOG_sq+ per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
                   districtwide + incumbent + contest * VAP_adjLOG + factor(year) + factor(distid), 
              data = moddat, x = TRUE, y = TRUE)
closeRLM3$se <- sqrt(diag(vcov(robcov(closeRLM3, cluster = moddat$distid))))
closeRLM4 <- ols(turnout ~ VAP_adjLOG + VAP_adjLOG_sq+ minBlaisLago*VAP_adjLOG + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG +
                   districtwide + incumbent + minBlaisLago + factor(year) + factor(distid), 
              data = moddat, x = TRUE, y = TRUE)
closeRLM4$se <- sqrt(diag(vcov(robcov(closeRLM4, cluster = moddat$distid))))


closeCoefs1 <- c("Intercept", "ln(VAP)", 
                  "$ln(VAP)^{2}$", "\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% OOH", 
                "ln(MedianIncome)", "District-wide", "No Incumbent",
                "Uncontested Seat", "VAP x Uncontested", 
                 "Blais-Lago", "VAP x Blais-Lago")

closeModTab <- apsrtable(closeRLM3, closeRLM4, se="robust", 
          label="tab:closemods", 
          model.names=c("RLM + District FE", "Interact + Year FE"), 
          caption = "Models of Competitiveness and Turnout in School Board Elections",
          notes = list(se.note, stars.note, "Year and district fixed effects omitted."),
          omitcoef=list("distid", 
                        expression(grep("distid", coefnames, value=TRUE)), 
                        "year", 
                        expression(grep("year", coefnames, value = TRUE))),
          coef.names = closeCoefs1,
          Sweave=FALSE)
@


<<cleanupa, echo=FALSE,results='hide'>>=
rm(ADMIN, VAP_dist, dist.tmp, dvp, errors, plotdf, presTurn, canInterp,
   canInterpIDX, centr, dumbRLM1, dumbRLM1b, dumbRLM2, dumbRLM2b, dumbRLMbest, 
   dumbRLMbestb, i, j)
@


Table \ref{tab:meClose} shows the partial-pooling results for two different 
models of competitiveness in school board elections. In the first model, races 
are coded as competitive following the schema in Chapter \ref{chap:candidacy} -- 
that is there are more serious candidates than seats available. In the second, I 
use the continuous measure of the Blais-Lago quotient to represent how competitive 
the races are, with a higher values corresponding to less competitive races. The 
control variables are the same from those in Table \ref{tab:meTurnout}. As 
expected, uncontested races have much lower turnout than contested races. Somewhat 
surprisingly, there is no detectable effect of incumbency on turnout. 

In the continuous model the Blais-Lago quotient is statistically significant and 
in the expected direction -- less competitive elections result in less turnout. 
However, the expectation that the relationship between competitiveness and district 
size would have an effect on turnout is not confirmed here - the interaction term 
is not statistically significant for either the uncontested dummy variable or the 
Blais-Lago quotient although it is in the right direction.\footnote{The fixed 
effect models are largely the same?}

\begin{tiny}
<<closeModMM, results='asis'>>=
mixedModclose <- lmer(turnout ~  VAP_adjLOG + VAP_adjLOG_sq +
                     per_white_all + 
                    per65o + PerBachelorOrAbove + OOH_share + 
                    median_incomeLOG + districtwide + incumbent +
                  contest *VAP_adjLOG  + (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

mixedModcloseB <- lmer(turnout ~  VAP_adjLOG +  VAP_adjLOG_sq + 
                     per_white_all + 
                     per65o + PerBachelorOrAbove + OOH_share + 
                     median_incomeLOG + districtwide + incumbent + 
                       contest * VAP_adjLOG + 
                   (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

mixedModcloseC <- lmer(turnout ~  VAP_adjLOG +  VAP_adjLOG_sq + 
                     per_white_all + 
                     per65o + PerBachelorOrAbove + OOH_share + 
                     median_incomeLOG + districtwide + incumbent + 
                       minBlaisLago * VAP_adjLOG + 
                   (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

closeCoefs2 <- c("Intercept", "ln(VAP)", 
                  "$ln(VAP)^{2}$", "\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% OOH", 
                  "ln(MedianIncome)", "District-wide", "No Incumbent", 
                 "Uncontested Seat", "VAP x Uncontested", 
                 "Blais-Lago", "VAP x Blais-Lago")


# summary(mixedMod2)
apsrtable(mixedModcloseB, mixedModcloseC, caption = "Partial Pooling Models of Competitiveness",
          model.names = c("Qualitative", "Blais-Lago"),
            label = "tab:meClose", notes = list(tabnote, stars.note), 
          coef.names = closeCoefs2, 
          Sweave = FALSE)

# Results with fallTurnout are largely similar but demographic variables are not 
# significant and less impactful due to collinearity with fall turnout
@
\end{tiny}


<<closeModSens,results='hide', eval=TRUE>>=
# m0 <- lm(turnout ~  minBlaisLago + VAP_adjLOG + minBlaisLago*VAP_adjLOG + 
#            per_white_all + per65o + PerBachelorOrAbove + OOH_share + 
#            median_incomeLOG + districtwide + 
#                   contest, data = moddat) # fit the null model

# exactLRT(m = refitML(mixedModclose), m0 = m0)

# Test for year specific slopes
m.slope <- update(mixedModcloseC, . ~ . - (1|year))
m0 <- update(mixedModcloseC, . ~ . - (1|distid))
closeLRT <- exactRLRT(m.slope, mixedModcloseC, m0)
closeLRT$callFull <- mixedModcloseC@call
closeLRT$callSmall <- m.slope@call
@

\clearpage

\subsection{Social Groups}

To test the argument that voter turnout may be influenced by the share of the 
electorate that is made up of unionized teachers, I combine features from the 
previous models in an attempt to find evidence of such an effect.  

% Partisanship and unionization

\subsubsection{Teachers' Unions}
<<teachInflRLM, results ='hide'>>=
moddat <- dist_turn[, c("turnout", "turnoutLag2", "year", "fallTurnout", 
                        "VAP_adjLOG", "distid", "per_white_all", "per65o", 
                        "PerBachelorOrAbove", "OOH_share", "median_incomeLOG", 
                        "teachShareofVoters", "districtwide", "incumbent",
                        "contest", "minBlaisLago")]
moddat <- na.omit(moddat)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$contest <- factor(moddat$contest)
moddat$districtwide <- factor(moddat$districtwide)
moddat$VAP_adjLOG_sq <- moddat$VAP_adjLOG^2
moddat$year <- factor(moddat$year)
moddat$turnout <- moddat$turnout * 100
centr <- mean(moddat$turnout)
stddev <- sd(moddat$turnout)
moddat$outflag <- (moddat$turnout - centr) / stddev
moddat <- moddat[moddat$outflag <=5 & moddat$outflag >= -5,]

nums <- sapply(moddat, is.numeric)
ScaleMeans <- apply(moddat[, nums], 2, mean, na.rm=TRUE)
ScaleSD <- apply(moddat[, nums], 2, sd, na.rm=TRUE)
moddatScaleTeach <- cbind(ScaleMeans, ScaleSD); rm(ScaleMeans, ScaleSD)
nums <- sapply(moddat, is.numeric)
moddat[, nums] <- apply(moddat[, nums], 2, rescale)
dd <<- datadist(moddat)
options(datadist="dd")

teachRLM <- ols(turnout ~ teachShareofVoters + fallTurnout + minBlaisLago + 
                    VAP_adjLOG + per_white_all + per65o + 
                  PerBachelorOrAbove + OOH_share + median_incomeLOG + 
                  districtwide + contest, data = moddat, x = TRUE, y = TRUE)

teachRLM$se <- sqrt(diag(vcov(robcov(teachRLM, cluster = moddat$distid))))

teachRLM2 <- ols(turnout ~ teachShareofVoters + fallTurnout + minBlaisLago + 
                    VAP_adjLOG + per_white_all + per65o + 
                   PerBachelorOrAbove + OOH_share + median_incomeLOG + 
                   districtwide + contest + year,
              data = moddat, x= TRUE, y = TRUE)

teachRLM2$se <- sqrt(diag(vcov(robcov(teachRLM2, cluster = moddat$distid))))


teachRLM3 <- ols(turnout ~ teachShareofVoters + turnoutLag2 + 
                   minBlaisLago + VAP_adjLOG +
                   VAP_adjLOG_sq + per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumbent + 
                   distid + factor(year), 
              data = moddat, x = TRUE, y = TRUE)

teachRLM3$se <- sqrt(diag(vcov(robcov(teachRLM3, cluster = moddat$distid))))

# Interaction model
teachRLM4 <- ols(turnout ~ teachShareofVoters +  
                   turnoutLag2 + minBlaisLago + 
                   VAP_adjLOG +  VAP_adjLOG_sq +
                    per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumbent + 
                   teachShareofVoters * VAP_adjLOG + factor(year) +
                   distid, 
              data = moddat, x = TRUE, y = TRUE)

teachRLM4$se <- sqrt(diag(vcov(robcov(teachRLM4, cluster = moddat$distid))))


teachCoefnames <- c("Intercept", "Teacher \\% VAP", "Lag Turnout", 
                 "Blais-Lago", "ln(VAP)", "$ln(VAP)^{2}$", "\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% OOH", 
                  "ln(MedianIncome)", "District-wide", "No Incumbent", 
                  "Teacher \\% X VAP")

teachTab1 <- apsrtable(teachRLM3, teachRLM4, se="robust", label="tab:teachmods", 
          model.names=c("RLM + District FE", "+ Interaction"), 
          caption = "Models of Unionization and Turnout in School Board Elections",
          notes = list(se.note, stars.note, "Year and district fixed effects omitted."),
          omitcoef=list("distid", 
                        expression(grep("distid", coefnames, value=TRUE)), 
                        "year", 
                        expression(grep("year", coefnames, value = TRUE))),
          coef.names = teachCoefnames,
          Sweave=FALSE)
@

Table \ref{tab:meInf} provides some evidence to support that teacher's unions 
may have an effect on the turnout. The key variables here are the teacher share of voters 
and its interaction with the voting age population. The main effects of the share 
of voters who are teachers is not significant and is quite small. However, 
the interaction suggests that as the voting age population increases and the 
teacher share of voting age population increases, turnout decreases. Including the 
square of the VAP reduces the interaction effect to being non-significant. Judging 
statistical significance of interaction predictors, however, is notoriously 
difficult -- particularly in mixed-effect models. I return to demonstrating the 
effect of these variables later using simulation methods to show their substantive 
impact on voter turnout as predicted by the model. Other variables follow their 
expected signs, although some like competitiveness have a smaller effect than 
in prior models. 

This result is counter to the theoretical expectations described above where more 
union membership would drive turnout up as a greater share of the population would 
have a stronger interest in school board outcomes. Despite this, the effect is 
understandable. If voters believe the school board election to be captured by a 
large interest group, they have  less of an incentive to vote. The threat of 
controlling the spring electorate for an interest group is enough to deter 
unorganized voters from participating. This type of behavior is the type of behavior 
that worries critics of special purpose governments like school districts 
\citep{fosterK,burnsN,berry2}. 


\begin{tiny}
<<teachInfMM, results='asis'>>=
teachCoefnames2 <- c("Intercept", "Teacher \\% VAP",  
                 "Blais-Lago", "Lag Turnout 2", "ln(VAP)", "\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% OOH", 
                  "ln(MedianIncome)", "District-wide", "No Incumbent",
                 "Teacher \\% x VAP", "$ln(VAP)^{2}$")
# what happens if I cut out lags

mixedModteach <- lmer(turnout ~ teachShareofVoters +  minBlaisLago +  turnoutLag2 + 
                    VAP_adjLOG + per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide +  incumbent +
                   teachShareofVoters * VAP_adjLOG + (1|year) +  (1|distid), 
              data = moddat, REML = TRUE)

mixedModteachB <- lmer(turnout ~ teachShareofVoters +  
                   turnoutLag2 + minBlaisLago + 
                   VAP_adjLOG +  VAP_adjLOG_sq +
                    per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumbent + 
                   teachShareofVoters * VAP_adjLOG + 
                         (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

apsrtable(mixedModteach, mixedModteachB, caption = "Partial Pooling Model of Staff Influence",
          model.names = c("Model 1","Model 2"),
            label = "tab:meInf", notes = list(stars.note), 
          coef.names = teachCoefnames2, 
          Sweave = FALSE)

# Same results when including fall turnout
@
\end{tiny}


<<mixedInfmodSen, results='hide', eval=TRUE>>=
# Test for year specific slopes
m.slope <- update(mixedModteachB, . ~ . - (1|year))
m0 <- update(mixedModteachB, . ~ . - (1|distid))
teachLRT <- exactRLRT(m.slope, mixedModteachB, m0)
teachLRT$callFull <- mixedModteachB@call
teachLRT$callSmall <- m.slope@call
@

\subsubsection{Partisanship}

Table \ref{tab:mePartisan} provides no evidence for a partisan dimension in school 
board turnout. While other variables hold their relationship from the tables 
above, the new variables for partisanship and party divide in the electorate are 
not statistically significant and their interaction with the size of the community 
is also not significant. If parties played an important role in the vote 
in spring elections than either the interaction between the party division or the 
proportion Democrats and the population of the district should be statistically 
significant and positive. The lack of a relationship provides evidence that parties 
do not influence school board turnout as a social group in a meaningful way. This 
seems clear, boards are not proving grounds for candidates for higher office and as 
they are non-partisan the party leadership has little incentive to prioritize them. 

<<partyMods, results ='hide'>>=
dist_turn$fallPartyDivision <- abs(dist_turn$fallTwoPartyShareDem - 0.5)

moddat <- dist_turn[, c("turnout", "year", "fallTurnout", "incumbent",
                        "VAP_adjLOG", "distid", "per_white_all", "per65o", 
                        "PerBachelorOrAbove", "OOH_share", "median_incomeLOG", 
                        "fallTwoPartyShareDem", "fallPartyDivision", 
                        "districtwide", "contest", "minBlaisLago")]
moddat <- na.omit(moddat)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$contest <- factor(moddat$contest)
moddat$districtwide <- factor(moddat$districtwide)
moddat$VAP_adjLOG_sq <- moddat$VAP_adjLOG^2
moddat$year <- factor(moddat$year)
moddat$turnout <- moddat$turnout * 100
centr <- mean(moddat$turnout)
stddev <- sd(moddat$turnout)
moddat$outflag <- (moddat$turnout - centr) / stddev
moddat <- moddat[moddat$outflag <=5 & moddat$outflag >= -5,]
nums <- sapply(moddat, is.numeric)
# nums <- nums[!names(nums) %in% c("fallPartyDivision")]
ScaleMeans <- apply(moddat[, nums], 2, mean, na.rm=TRUE)
ScaleSD <- apply(moddat[, nums], 2, sd, na.rm=TRUE)
moddatScaleParty <- cbind(ScaleMeans, ScaleSD); rm(ScaleMeans, ScaleSD)
moddat[, nums] <- apply(moddat[, nums], 2, rescale)
dd <<- datadist(moddat)
options(datadist="dd")

partyRLM1 <- ols(turnout ~ fallTurnout + minBlaisLago + 
                    VAP_adjLOG + VAP_adjLOG_sq  + per_white_all + per65o + 
                   PerBachelorOrAbove + OOH_share + median_incomeLOG + 
                   districtwide + incumbent + fallPartyDivision + year + distid,
              data = moddat, x= TRUE, y = TRUE)

partyRLM1$se <- sqrt(diag(vcov(robcov(partyRLM1, cluster = moddat$distid))))


partyRLM2 <- ols(turnout ~ fallTwoPartyShareDem + fallTurnout + minBlaisLago + 
                    VAP_adjLOG + VAP_adjLOG_sq + per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumbent + 
                   distid + factor(year), 
              data = moddat, x = TRUE, y = TRUE)

