rmsePlot2 <- ggplot(out, aes(x = mod, y = bootMed)) + 
  geom_bar(stat='identity', width = .5) + 
  geom_errorbar(aes(ymin = bootMed - bootSE, ymax = bootMed + bootSE), 
                width = .2, color = I("red")) + theme_dpi() + 
  # geom_point(aes(y = original, x = mod), color = I("red")) + 
  labs(x = "Model Name", y = "", 
       title = "Rolloff Models") 
@

Figure \ref{fig:printRMSEplot} shows the results for turnout models in the top 
panel and rolloff models in the bottom panel. The height of the bar represents 
the RMSE standardized to represent the percentage of a standard deviation the 
average observation is mispredicted. A lower figure is better. The red error 
bar represents the bootstrapped RMSE plus or minus two standard deviations of 
all of the resampled RMSE values. Overall the rolloff models perform better than the 
turnout models, but none of the models are significantly better fitting than any 
of the others within each dependent variable. 

This suggests two things. First, the demographic variables and the year and 
district effects are doing most of the work in explaining the dependent variables. 
Any additional variance explained by the theoretically interesting variables has 
marginal impact on accurately predicting the dependent variable. Second, there 
is significant unexplained variance in turnout that is not covered by any of the 
measures in any of the models or in the district or election specific intercepts. 
There is room for future work to improve these models through identifying measures 
to improve the prediction. 

<<printRMSEplot, fig.scap="Comparing Model Fit Across Variables", fig.cap="Figures show the bootstrapped root mean square error (RMSE) of competing models across 150 bootstrapped replications along with a confidence interval. A lower RMSE corresponds to a more accurate prediction and better explanation of the dependent variable.", fig.height=4,fig.width=8>>==
library(gridExtra)
grid.arrange(rmsePlot1, rmsePlot2, left = "Mean Model Error in Std. Dev.")
@

\subsection{Substantive Effects}

After finding evidence in favor of voters behaving as theory might expect, I now 
turn my attention to exploring the magnitude of these effects. Table 
\ref{tab:turnoutRESULTS} summarizes the substantive findings for all variables 
across both turnout and rolloff. Each row in the table shows the net impact on 
turnout and rolloff changing a key predictor associated with one of the theories 
of voter turnout. 

In general, the impacts are modest. District size and prior district turnout have 
the largest substantive impacts on both rolloff and turnout. Competitiveness has 
a notably smaller impact, requiring a large shift in competitiveness to provide 
a measurable increase in turnout. In a median sized district, the increase in 
voter turnout attributable to this increase in competitiveness would result in 
an additional 25 voters -- enough to sway the outcome of a race in fewer than 
10\% of the observed spring election cycles. Net of these effects, the effects 
of interest groups and political parties are quite low. School board turnout is suppressed by a larger share of the number of voters being represented by 
teachers in the school district. This effect is smaller in smaller communities. 
There appears to be an influence of teachers on rolloff as well -- but only 
when measured as a share of the voting age population. These effects are quite 
modest with turnout averaging around 18\% a 0.25\% point increase in turnout in 
the median size district equates to just 13 additional voters. 

There is no evidence of a role of political parties in school board spring election 
turnout, but there is evidence off an effect on rolloff. A one standard deviation 
increase in partisan division represents a 25\% increase in rolloff for a typical 
district. However, in the median district this represents 50 fewer school board 
election voters -- well below the median victory margin in the closest race in each 
district, approximately 290 votes. 


% Describe model results

<<substEffSim, eval=FALSE, results='hide'>>=

# beta <- fixef(mixedMod1lagsb)["turnoutLag2"]
# margEff <- 0.6 * beta
# 
# margEff * 2 * moddatScaleLag["turnout", 2] + moddatScaleLag["turnout", 1] - 
#    moddatScaleLag["turnout", 1]
# 
# 0.6 * 2 * moddatScaleLag["turnoutLag2", 2] + moddatScaleLag["turnoutLag2", 1] - 
#    moddatScaleLag["turnoutLag2", 1]
# 
# # ------------------
# 
# beta <- fixef(undervoteMMlag)["turnoutLag2"]
# margEff <- 0.6 * beta
# 
# margEff * 2 * moddatScaleUndervote["turnoutDiff", 2] + 
#   moddatScaleUndervote["turnoutDiff", 1] - 
#    moddatScaleUndervote["turnoutDiff", 1]
# 
# 0.6 * 2 * moddatScaleUndervote["turnoutLag2", 2] + 
#   moddatScaleUndervote["turnoutLag2", 1] - 
#    moddatScaleUndervote["turnoutLag2", 1]

# ------------------------
effSizeScale <- function(model, scales, betaChg, dv, iv, iv2=NULL){
  beta <- fixef(model)[iv]
  polyString <- paste0(iv, "_sq")
  polyTerm <- intersect(polyString, names(fixef(model)))
  if(!is.null(iv2)){
    alpha <- fixef(model)[iv2]
    interactStrings <- c(paste(iv, iv2, sep=":"), paste(iv2, iv, sep=":"))
    interactTerm <- intersect(interactStrings, names(fixef(model)))
  } else{
    interactTerm <- NULL
  }
  
  if(length(polyTerm) > 0){
    beta2 <- fixef(model)[polyTerm]
    margEff <- (betaChg * beta) + (betaChg^2 * beta2)
  } else {
    margEff <- betaChg * beta
  }

  if(length(interactTerm > 0)){
    polyString <- paste0(iv2, "_sq")
    polyTerm <- intersect(polyString, names(fixef(model)))
    if(length(polyTerm) > 0){
    alpha2 <- fixef(model)[polyTerm]
    alphaLo <- quantile(model@frame[[iv2]], probs = 0.125) 
    alphaEffl <- (alphaLo * alpha) + (alpha2 * alphaLo^2)
    alphaM <- quantile(model@frame[[iv2]], probs = 0.5) 
    alphaEffm <- (alphaM * alpha) + (alpha2 * alphaM^2)
    alphaHi <- quantile(model@frame[[iv2]], probs = 0.875)
    alphaEffh <- (alphaHi * alpha) + (alpha2 * alphaHi^2)
      
    } else{
    alphaLo <- quantile(model@frame[[iv2]], probs = 0.125) 
    alphaEffl <- alphaLo * alpha
    alphaM <- quantile(model@frame[[iv2]], probs = 0.5) 
    alphaEffm <- alphaM * alpha
    alphaHi <- quantile(model@frame[[iv2]], probs = 0.875)
    alphaEffh <- alphaHi * alpha
    }
    
    psi <- fixef(model)[interactTerm]
    
    margEffLo <- margEff + alphaEffl + (betaChg * alphaLo *  psi)
    margEffHi <- margEff + alphaEffh + (betaChg * alphaHi *  psi)
    margEffM <-  margEff + alphaEffm + (betaChg * alphaM *  psi)
    margEff <- c(margEffLo, margEffM, margEffHi)
}

  DVdelta <- margEff * 2 * scales[dv, 2] + scales[dv, 1] - scales[dv, 1]

  varChg <- betaChg * 2 * scales[iv, 2] 
  varChg <- round(varChg, digits = 4)
  DVdelta <- round(DVdelta, digits = 4)
  
  ivMax <- max(model@frame[[iv]])
  ivMin <- min(model@frame[[iv]])
  
  varMax <- round(ivMax * 2 * scales[iv, 2] + scales[iv, 1], digits = 4)
  varMin <- round(ivMin * 2 * scales[iv, 2] + scales[iv, 1], digits = 4)
  varSD <- round(0.5 * 2 * scales[iv, 2], digits = 4)
  
  dvMax <- max(model@frame[[dv]])
  dvMin <- min(model@frame[[dv]])
  
  dvarMax <- round(dvMax * 2 * scales[dv, 2] + scales[dv, 1], digits = 4)
  dvarMin <- round(dvMin * 2 * scales[dv, 2] + scales[dv, 1], digits = 4)
  dvarSD <-  round(0.5 * 2 * scales[dv, 2], digits = 4)
  
  if(!is.null(iv2)){
    stub <- c(" for the Bottom Quartile ", " for the Median ", 
              " for the Top Quartile")
    print(paste0("Dependent variable changes ",  paste(DVdelta, stub, collapse=""), 
          " of the interacted variable ", iv2))
  } else{
    print(paste0("Dependent variable changes ", DVdelta))
  }
  print(paste0("on a range from ", dvarMin, " to ", dvarMax, 
               " on the dependent variable with standard deviation of ", dvarSD))
  print(paste0("for a change in independent variable of ", varChg))
  print(paste0("on a range from ", varMin, " to ", varMax, 
               " on the independent variable with standard deviation of ", varSD))
}

# turnoutlag2
effSizeScale(mixedMod1lagsb, scales = moddatScaleLag, betaChg = 0.6, 
             dv = "turnout", iv = "turnoutLag2")

# decreases are good
effSizeScale(mixedModcloseC, scales = moddatScaleClose, betaChg = -0.5, 
              dv = "turnout", iv = "VAP_adjLOG")

# Closeness
effSizeScale(mixedModcloseC, scales = moddatScaleClose, betaChg = 0.5, 
              dv = "turnout", iv = "minBlaisLago")
effSizeScale(mixedModcloseC, scales = moddatScaleClose, betaChg = 0.5, 
              dv = "turnout", iv = "minBlaisLago", iv2="VAP_adjLOG")
effSizeScale(mixedModcloseC, scales = moddatScaleClose, betaChg = 0, 
              dv = "turnout", iv = "minBlaisLago", iv2="VAP_adjLOG")

# teachershare
effSizeScale(mixedModteachD, scales = moddatScaleTeach, betaChg = 0.25, 
             dv = "turnout", iv = "teachShareofVoters2", iv2="VAP_adjLOG")
effSizeScale(mixedModteachD, scales = moddatScaleTeach, betaChg = 0, 
             dv = "turnout", iv = "teachShareofVoters2", iv2="VAP_adjLOG")

# Partisan divide
effSizeScale(mixedModP, scales = moddatScaleParty, betaChg = 0.25, 
             dv = "turnout", iv = "partyDivisionFall", iv2="VAP_adjLOG")
effSizeScale(mixedModPb, scales = moddatScaleParty, betaChg = 0.25, 
             dv = "turnout", iv = "fallTwoPartyShareDem", iv2="VAP_adjLOG")
#------------
# Rolloff
# turnoutlag2
effSizeScale(undervoteMMlag, scales = moddatScaleUndervote, betaChg = 0.8, 
             dv = "turnoutDiff", iv = "turnoutLag2")

# decreases are good
effSizeScale(undervoteMMclose, scales = moddatScaleUndervote, betaChg = -0.5, 
              dv = "turnoutDiff", iv = "VAP_adjLOG")

# Closeness
effSizeScale(undervoteMMclose, scales = moddatScaleUndervote, betaChg = 0.25, 
              dv = "turnoutDiff", iv = "minBlaisLago")
effSizeScale(undervoteMMclose, scales = moddatScaleUndervote, betaChg = 0.25, 
              dv = "turnoutDiff", iv = "minBlaisLago", iv2="VAP_adjLOG")
effSizeScale(undervoteMMclose, scales = moddatScaleUndervote, betaChg = 0, 
              dv = "turnoutDiff", iv = "minBlaisLago", iv2="VAP_adjLOG")

# teachershare
effSizeScale(undervoteMMteachB, scales = moddatScaleUndervote, betaChg = 0.5, 
             dv = "turnoutDiff", iv = "teachShareofVoters2", iv2="VAP_adjLOG")
effSizeScale(undervoteMMteachB, scales = moddatScaleUndervote, betaChg = 0, 
             dv = "turnoutDiff", iv = "teachShareofVoters2", iv2="VAP_adjLOG")

# Partisan divide
effSizeScale(undervoteMMparty, scales = moddatScaleUndervote, betaChg = 0.25, 
             dv = "turnoutDiff", iv = "fallTwoPartyShareDem", iv2="VAP_adjLOG")
effSizeScale(undervoteMMparty, scales = moddatScaleUndervote, betaChg = 0, 
             dv = "turnoutDiff", iv = "fallTwoPartyShareDem", iv2="VAP_adjLOG")
effSizeScale(undervoteMMpartyB, scales = moddatScaleUndervote, betaChg = 0.25, 
             dv = "turnoutDiff", iv = "partyDivisionFall", iv2="VAP_adjLOG")
effSizeScale(undervoteMMpartyB, scales = moddatScaleUndervote, betaChg = 0, 
             dv = "turnoutDiff", iv = "partyDivisionFall", iv2="VAP_adjLOG")
@


