@

\subsection{Electorate Size and Margin of Victory}

Our second empirical question was to examine the relationship between electorate size 
and turnout, and electorate size, margin of victory and turnout. I use an adjusted estimate 
of the voting age population - the denominator in the turnout variable - to serve as 
an estimate of the electorate size. This is a conservative estimate of the actual electorate 
size in school board elections, which as we have seen can be as low as 15\% of the voting 
age population. If we assume that voters adjust the electorate size equally across jurisdictions 
when making their assessment of the perceived uiltity of voting, then this is not a factor. 
If we have evidence that voters in different jurisdicstions have more information about the 
likely electorate size in a school board election, and this varies across jurisdictions, 
then this becomes more problematic. 

<<model3, results ='asis'>>=
moddat <- dist_turn[, c("turnout", "turnoutLag2", "year", "fallTurnout", "VAP_adjLOG", "distid", 
                        "per_white_all", "per65o", "PerBachelorOrAbove", "OOH_share", "median_incomeLOG", 
                        "CLOSE", "districtwide", "contest")]
moddat <- na.omit(moddat)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat$turnout <- moddat$turnout * 100
moddat$districtwide <- factor(moddat$districtwide)
# moddat$turnoutLag2 <- moddat$turnoutLag2 * 100
# moddat$turnoutLag1 <- moddat$turnoutLag1 * 100
# moddat$per_white_all <- moddat$per_white_all * 100
# moddat$per65o <- moddat$per65o * 100
# moddat$PerBachelorOrAbove <- moddat$PerBachelorOrAbove * 100
# moddat$OOH_share <- moddat$OOH_share * 100
# moddat$fallTurnout <- moddat$fallTurnout * 100
centr <- mean(moddat$turnout)
stddev <- sd(moddat$turnout)
moddat$outflag <- (moddat$turnout - centr) / stddev
moddat <- moddat[moddat$outflag <= 5 & moddat$outflag >= -5,]

dd <<- datadist(moddat)
options(datadist="dd")

closeRLM <- ols(turnout ~ CLOSE + VAP_adjLOG + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + districtwide + 
                  contest, 
              data = moddat, x = TRUE, y = TRUE)

closeRLM$se <- sqrt(diag(vcov(robcov(closeRLM, cluster = moddat$distid))))


closeRLM2 <- ols(turnout ~ CLOSE + VAP_adjLOG + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + districtwide + 
                  contest+ factor(year),
              data = moddat, x= TRUE, y = TRUE)

closeRLM2$se <- sqrt(diag(vcov(robcov(closeRLM2, cluster = moddat$distid))))


closeRLM3 <- ols(turnout ~CLOSE + VAP_adjLOG + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + districtwide + 
                  contest + factor(distid), 
              data = moddat, x = TRUE, y = TRUE)

closeRLM3$se <- sqrt(diag(vcov(robcov(closeRLM3, cluster = moddat$distid))))

closeRLM4 <- ols(turnout ~ CLOSE + VAP_adjLOG + CLOSE*VAP_adjLOG + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + districtwide + 
                  contest + factor(year), 
              data = moddat, x = TRUE, y = TRUE)

closeRLM4$se <- sqrt(diag(vcov(robcov(closeRLM4, cluster = moddat$distid))))


apsrtable(closeRLM, closeRLM2, closeRLM3, closeRLM4, se="robust", label="tab:closemods", 
          model.names=c("Simple RLM", "RLM + Year FE", "RLM + District FE", "Interact + Year FE"), 
          caption = "Models of Competitiveness and Turnout in School Board Elections",
          notes = list(se.note, stars.note, "Year and district fixed effects omitted."),
          omitcoef=list("distid", 
                        expression(grep("distid", coefnames, value=TRUE)), 
                        "year", 
                        expression(grep("year", coefnames, value = TRUE))), 
          Sweave=FALSE)

# 
# library(MCMCpack)
# 
# fit1<-MCMCtobit(turnout ~ CLOSE + turnoutLag2 + fallTurnout + log(VAP_adj) + per_white_all +
#                    per65o + PerBachelorOrAbove + OOH_share + log(median_income),
#                 data=moddat,below=0,above=1,burnin=2000,mcmc=70000,thin=5)
# HPDinterval(fit1)

@

As Table \ref{tab:closemods} shows, across all three specifications, competitiveness and the electorate size matter. A non-competitive race has about a 2\% decrease in voter turnout -- substantial considering the average turnout in school board elections of X\%. A log increase 
in voting age population decreases turnout by about 3.5\%. However, the same specification 
problems from Table \ref{tab:lagmods} appaers in Table \ref{tab:closemods}. Again, 
I turn to partial pooling to resolve this issue. 

<<model4, results='asis'>>=
mixedMod2 <- lmer(turnout ~  CLOSE + VAP_adjLOG + CLOSE*VAP_adjLOG + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + districtwide + 
                  contest  + (1|distid), 
              data = moddat, REML = TRUE)

mixedMod2b <- lmer(turnout ~ CLOSE + VAP_adjLOG + CLOSE*VAP_adjLOG + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + districtwide + 
                  contest + (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

# summary(mixedMod2)
apsrtable(mixedMod2b, caption = "Partial Pooling Model for Competitiveness",
          model.names = c("Partial Pooled"),
            label = "tab:meClose", notes = list(tabnote, stars.note), 
          Sweave = FALSE)
@

The results in Table \ref{tab:meClose} mirror those found in columns 1 and 2 of Table 
\ref{tab:closemods}. This provides evidence in support of the argument that school board 
election voters are more active in smaller electorates and in competitive races. 

<<closeModSens,results='hide'>>=
m0 <- lm(turnout ~  CLOSE + VAP_adjLOG + CLOSE*VAP_adjLOG + per_white_all + 
                  per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + districtwide + 
                  contest, data = moddat) # fit the null model

exactLRT(m = refitML(mixedMod2), m0 = m0)

# Test for year specific slopes
m.slope <- update(mixedMod2b, . ~ . - (1|year))
m0 <- update(mixedMod2b, . ~ . - (1|distid))
exactRLRT(m.slope, mixedMod2b, m0)


@

\subsection{Unionization}

To test the argument that voter turnout may be influenced by the share of the 
electorate that is made up of unionized teachers, I combine features from the 
previous models in an attempt to find evidence of such an effect.  

<<model5, results ='asis'>>=
moddat <- dist_turn[, c("turnout", "turnoutLag2", "year", "fallTurnout", "VAP_adjLOG", "distid", 
                        "per_white_all", "per65o", "PerBachelorOrAbove", "OOH_share", "median_incomeLOG", 
                        "CLOSE", "teachShareofVoters", "districtwide", "contest")]

moddat <- na.omit(moddat)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$districtwide <- factor(moddat$districtwide)
moddat$year <- factor(moddat$year)
moddat$turnout <- moddat$turnout * 100
# moddat$turnoutLag2 <- moddat$turnoutLag2 * 100
# moddat$turnoutLag1 <- moddat$turnoutLag1 * 100
# moddat$per_white_all <- moddat$per_white_all * 100
# moddat$per65o <- moddat$per65o * 100
# moddat$PerBachelorOrAbove <- moddat$PerBachelorOrAbove * 100
# moddat$OOH_share <- moddat$OOH_share * 100
# moddat$fallTurnout <- moddat$fallTurnout * 100
# moddat$VAP_adj <- log(moddat$VAP_adj)
# moddat$median_income <- log(moddat$median_income)
centr <- mean(moddat$turnout)
stddev <- sd(moddat$turnout)
moddat$outflag <- (moddat$turnout - centr) / stddev
moddat <- moddat[moddat$outflag <=5 & moddat$outflag >= -5,]

dd <<- datadist(moddat)
options(datadist="dd")

##TODO: add interaction between teachShareofVoters and VAP_adjLOG, for coordination 
# purposes it is easier for teachers to work together in smaller population. Turnout 
# increases as teach share of voters increases, decreases as population increases
# and decreases as size of district + teacher share increases due to coordination costs

teachRLM <- ols(turnout ~ teachShareofVoters + fallTurnout + 
                    VAP_adjLOG + per_white_all +
                   per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + districtwide +
                  contest, data = moddat, x = TRUE, y = TRUE)

teachRLM$se <- sqrt(diag(vcov(robcov(teachRLM, cluster = moddat$distid))))


teachRLM2 <- ols(turnout ~ teachShareofVoters + fallTurnout + 
                    VAP_adjLOG + per_white_all +
                   per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + districtwide +
                  contest + year,
              data = moddat, x= TRUE, y = TRUE)

teachRLM2$se <- sqrt(diag(vcov(robcov(teachRLM2, cluster = moddat$distid))))


teachRLM3 <- ols(turnout ~ teachShareofVoters + fallTurnout + 
                    VAP_adjLOG + per_white_all +
                   per65o + PerBachelorOrAbove + OOH_share + median_incomeLOG + districtwide +
                  contest+ distid, 
              data = moddat, x = TRUE, y = TRUE)

teachRLM3$se <- sqrt(diag(vcov(robcov(teachRLM3, cluster = moddat$distid))))




apsrtable(teachRLM, teachRLM2, teachRLM3, se="robust", label="tab:teachmods", 
          model.names=c("Simple RLM", "RLM + Year FE", "RLM + District FE"), 
          caption = "Models of Unionization and Turnout in School Board Elections",
          notes = list(se.note, stars.note, "Year and district fixed effects omitted."),
          omitcoef=list("distid", 
                        expression(grep("distid", coefnames, value=TRUE)), 
                        "year", 
                        expression(grep("year", coefnames, value = TRUE))), 
          Sweave=FALSE)

# 
# library(MCMCpack)
