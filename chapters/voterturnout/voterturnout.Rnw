dumbRLM2 <- ols(turnout ~ turnoutLag2 + VAP_adjLOG + VAP_adjLOG_sq + 
                  per_white_all + per65o + PerBachelorOrAbove +  OOH_share+
                  median_incomeLOG + districtwide + minBlaisLago + factor(year) + 
                  factor(distid), data = moddat, x = TRUE, y = TRUE)
