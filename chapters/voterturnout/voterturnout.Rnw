partyRLM3 <- ols(turnout ~ fallPartyDivision*VAP_adjLOG + fallTurnout + minBlaisLago + 
                    VAP_adjLOG + VAP_adjLOG_sq+ per_white_all + per65o + 
                   PerBachelorOrAbove + OOH_share + median_incomeLOG + 
                   districtwide + incumbent + year + distid,
              data = moddat, x= TRUE, y = TRUE)

partyRLM3$se <- sqrt(diag(vcov(robcov(partyRLM3, cluster = moddat$distid))))


partyRLM4 <- ols(turnout ~ fallTwoPartyShareDem*VAP_adjLOG + fallTurnout + minBlaisLago + 
                    VAP_adjLOG + VAP_adjLOG_sq+ per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumbent + 
                   distid + factor(year), 
              data = moddat, x = TRUE, y = TRUE)

partyRLM4$se <- sqrt(diag(vcov(robcov(partyRLM4, cluster = moddat$distid))))

partyCoefNames <- c("Intercept", "Fall Turnout", 
                 "Blais-Lago", "ln(VAP)", "$ln(VAP)^{2}$", "\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% OOH", 
                  "ln(MedianIncome)", "District-wide", "No Incumbent", 
                  "Fall Party Divide", "Fall 2 Party Dem.", 
                 "Party Division x VAP", 
                 "2 Party Dem x VAP")

partyModtab <- apsrtable(partyRLM1, partyRLM2, partyRLM3, partyRLM4, se="robust", label="tab:partymods", 
          model.names=c("Party Unity", "Dem Share", "Party Unity Inter.", "Dem Share Inter."), 
          caption = "Models of Partisanship and Turnout in School Board Elections",
          notes = list(se.note, stars.note, "Year and district fixed effects omitted."),
