@

<<bootRMSE2, results='hide', cache=TRUE>>=
sigmaBoot <- boot(undervoteMMclose@frame, bootRMSE, R = 150, model = undervoteMMclose)
out <- cbind(summary(sigmaBoot), mod  = "Blais-Lago")
sigmaBoot <- boot(undervoteMMlag@frame, bootRMSE, R = 150, model = undervoteMMlag)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "Habit"))
sigmaBoot <- boot(undervoteMMparty@frame, bootRMSE, R = 150, model = undervoteMMparty)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "% Democrat"))
sigmaBoot <- boot(undervoteMMpartyB@frame, bootRMSE, R = 150, model = undervoteMMpartyB)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "Party Division"))
