<<turnoutCompetitive, echo=FALSE, fig.cap="Turnout in School Board Elections based on Contestation">>=
dist_turn$contestINC[dist_turn$nrealcand <= dist_turn$nwins & dist_turn$ninc == 0] <- "Open Uncontested"
dist_turn$contestINC[dist_turn$nrealcand <= dist_turn$nwins & dist_turn$ninc > 0] <- "Incumbent Uncontested"
dist_turn$contestINC[dist_turn$nrealcand > dist_turn$nwins & dist_turn$ninc > 0] <- "Incumbent Contested"
dist_turn$contestINC[dist_turn$nrealcand > dist_turn$nwins & dist_turn$ninc ==0] <- "Open Contested"

dist_turn$incumbent <- "Open"
dist_turn$incumbent[dist_turn$ninc > 0] <- "Incumbent"
dist_turn$contest <- "Open"
dist_turn$contest[dist_turn$nrealcand > dist_turn$nwins] <- "Contested"


tempdf <- dist_turn[!is.na(dist_turn$turnout) & dist_turn$turnout < 0.95,]
qplot(turnout, data = tempdf, fill = contest, 
      color = I("gray90")) +  
  theme_dpi() + 
  facet_wrap(~contestINC, ncol = 1) +
