lowerBar <- ((quantile(fitted(mixedModcloseC), prob = 0.25) * 2 * moddatScaleClose["turnout", 2]) + 
      moddatScaleClose["turnout", 1]) /100
upperBar <- ((quantile(fitted(mixedModcloseC), prob = 0.75) * 2 * moddatScaleClose["turnout", 2]) + 
