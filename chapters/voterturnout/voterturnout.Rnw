# out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedModteach"))
sigmaBoot <- boot(mixedModteachD@frame, bootRMSE, R = 150, model = mixedModteachD)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "Teach. Infl."))
# sigmaBoot <- boot(mixedModPb@frame, bootRMSE, R = 150, model = mixedModPb)
# out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedModPb"))

rmsePlot1 <- ggplot(out, aes(x = mod, y = bootMed)) + 
  geom_bar(stat='identity', width = .5) + 
  geom_errorbar(aes(ymin = bootMed - bootSE, ymax = bootMed + bootSE), 
                width = .2, color = I("red")) + theme_dpi() + 
  labs(x = "Model Name", y = "", 
       title = "Turnout Models") 
