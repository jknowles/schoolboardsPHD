\subsection{Social Groups}

To test the argument that voter turnout may be influenced by interest group 
strength, I combine features from the previous models in an attempt to find 
evidence of such an effect.  


\subsubsection{Teachers' Unions}
<<teachInflRLM, results ='hide'>>=
moddat <- dist_turn[, c("turnout", "turnoutLag2", "year", "fallTurnout", 
                        "VAP_adjLOG", "distid", "per_white_all", "per65o", 
                        "PerBachelorOrAbove", "OOH_share", "median_incomeLOG", 
                        "teachShareofVoters", "districtwide", "incumShare",
                        "minBlaisLago", "teachShareofVoters2")]
moddat <- na.omit(moddat)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$districtwide <- factor(moddat$districtwide)
moddat$year <- factor(moddat$year)
moddat$turnout <- moddat$turnout * 100
centr <- mean(moddat$turnout)
stddev <- sd(moddat$turnout)
moddat$outflag <- (moddat$turnout - centr) / stddev
moddat <- moddat[moddat$outflag <=5 & moddat$outflag >= -5,]

nums <- sapply(moddat, is.numeric)
ScaleMeans <- apply(moddat[, nums], 2, mean, na.rm=TRUE)
ScaleSD <- apply(moddat[, nums], 2, sd, na.rm=TRUE)
moddatScaleTeach <- cbind(ScaleMeans, ScaleSD); rm(ScaleMeans, ScaleSD)
nums <- sapply(moddat, is.numeric)
moddat[, nums] <- apply(moddat[, nums], 2, rescale)
moddat$VAP_adjLOG_sq <- moddat$VAP_adjLOG^2
dd <<- datadist(moddat)
options(datadist="dd")

teachRLM <- ols(turnout ~ teachShareofVoters + fallTurnout + minBlaisLago + 
                    VAP_adjLOG + per_white_all + per65o + 
                  PerBachelorOrAbove + OOH_share + median_incomeLOG + 
                  districtwide, data = moddat, x = TRUE, y = TRUE)

teachRLM$se <- sqrt(diag(vcov(robcov(teachRLM, cluster = moddat$distid))))

teachRLM2 <- ols(turnout ~ teachShareofVoters + fallTurnout + minBlaisLago + 
                    VAP_adjLOG + per_white_all + per65o + 
                   PerBachelorOrAbove + OOH_share + median_incomeLOG + 
                   districtwide + year,
              data = moddat, x= TRUE, y = TRUE)

teachRLM2$se <- sqrt(diag(vcov(robcov(teachRLM2, cluster = moddat$distid))))

teachRLM3 <- ols(turnout ~ teachShareofVoters + turnoutLag2 + 
                   minBlaisLago + VAP_adjLOG +
                   VAP_adjLOG_sq + per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumShare + 
                   distid + factor(year), 
              data = moddat, x = TRUE, y = TRUE)

teachRLM3$se <- sqrt(diag(vcov(robcov(teachRLM3, cluster = moddat$distid))))

# Interaction model
teachRLM4 <- ols(turnout ~ teachShareofVoters +  
                   turnoutLag2 + minBlaisLago + 
                   VAP_adjLOG +  VAP_adjLOG_sq +
                    per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumShare + 
                   teachShareofVoters * VAP_adjLOG + factor(year) +
                   distid, 
              data = moddat, x = TRUE, y = TRUE)

teachRLM4$se <- sqrt(diag(vcov(robcov(teachRLM4, cluster = moddat$distid))))

teachRLM5 <- ols(turnout ~ teachShareofVoters2 + turnoutLag2 + 
                   minBlaisLago + VAP_adjLOG +
                   VAP_adjLOG_sq + per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumShare + 
                   distid + factor(year), 
              data = moddat, x = TRUE, y = TRUE)

teachRLM5$se <- sqrt(diag(vcov(robcov(teachRLM5, cluster = moddat$distid))))

# Interaction model
teachRLM6 <- ols(turnout ~ teachShareofVoters2 +  
                   turnoutLag2 + minBlaisLago + 
                   VAP_adjLOG +  VAP_adjLOG_sq +
                    per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumShare + 
                   teachShareofVoters2 * VAP_adjLOG + factor(year) +
                   distid, 
              data = moddat, x = TRUE, y = TRUE)

teachRLM6$se <- sqrt(diag(vcov(robcov(teachRLM6, cluster = moddat$distid))))



teachCoefnames <- c("Intercept", "Teacher \\% Electorate", "Lag Turnout", 
                 "Competitiveness", "Electorate Size", "Electorate Size\\textsuperscript{2}", "\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% OOH", 
                  "Median Income", "District-wide", "Incumbent Share", 
                  "Teacher \\% X Elec. Size", "Teacher \\% of SB Vote", 
                 "Teacher \\% of SB X Elec. Size")

teachTab1 <- apsrtable(teachRLM3, teachRLM4, teachRLM5, teachRLM6, 
                       se="robust", label="tab:teachmods", 
          model.names=c("RLM + District FE", "+ Interaction", "Measure 2", 
                        "Measure 2 + Interaction"), 
          caption = "Models of Unionization and Turnout in School Board Elections",
          notes = list(se.note, stars.note, "Year and district fixed effects omitted."),
          omitcoef=list("distid", 
                        expression(grep("distid", coefnames, value=TRUE)), 
                        "year", 
                        expression(grep("year", coefnames, value = TRUE))),
          coef.names = teachCoefnames, digits = 3,
          Sweave=FALSE, stars = "default", size = "scriptsize")
@


Table \ref{tab:meInf} provides some evidence to support that teacher's unions 
may have an effect on turnout. The key variables here are the teacher share 
of voters and its interaction with the share of incumbents in the race. I 
expect teachers' unions to be more active and exert more influence on turnout 
when there are more non-incumbents in the race. The main effects of the share 
of voters who are teachers is negative and significant but small. 
The interaction term is negative, which suggests that as fewer incumbents are in 
the race and unions are stronger, turnout is suppressed. However, this effect is 
not statistically significant. 

Judging statistical significance of interaction predictors, however, is notoriously 
difficult -- particularly in mixed-effect models. I return to demonstrating the 
effect of these variables later using simulation methods to show their substantive 
impact on voter turnout as predicted by the model. Other variables follow their 
expected signs, although some like competitiveness have a smaller effect than 
in prior models.\footnote{The models reported here use teacher share of the 
number of voters in the school board election two years prior. This is used to 
avoid endogeneity and to better reflect the strategic interaction between school 
board vote turnout and district size. Using the teacher share of VAP results in 
the same sign, but statistically insignificant effects.} 

This result is counter to the theoretical expectations described above where more 
union membership would drive turnout up as a greater share of the population would 
have a stronger interest in school board outcomes. However, this is in line with 
the observed bivariate correlation between teacher share and turnout. In fact, 
the effect is understandable. If voters believe the school board election to 
be captured by a large interest group, they have  less of an incentive to vote.
The threat of controlling the spring electorate for an interest group is enough 
to deter unorganized voters from participating. This type of behavior is the 
type of behavior that worries critics of special purpose governments like 
school districts \citep{fosterK,burnsN,berry2}.

<<teachInfMM, results='asis'>>=
teachCoefnames2 <- c("Intercept", "Teacher \\% SB Vote",  
                 "Competitiveness",  "Electorate Size",  "Electorate Size\\textsuperscript{2}", 
                  "\\% White", "\\% Over 65", "\\% Bach. +", "\\% Owner Occupied", 
                  "Median Income", "District-wide", "Incumbent Share",
                  "Teacher \\% of SB X Inc Share")
# what happens if I cut out lags

mixedModteach <- lmer(turnout ~ teachShareofVoters +  minBlaisLago +   
                    VAP_adjLOG + VAP_adjLOG_sq + per_white_all + per65o + 
                      PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide +  incumShare +
                   teachShareofVoters + (1|year) +  (1|distid), 
              data = moddat, REML = TRUE)

mixedModteachB <- lmer(turnout ~ teachShareofVoters +  
                    minBlaisLago + 
                   VAP_adjLOG +  VAP_adjLOG_sq +
                    per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumShare + 
                   teachShareofVoters * VAP_adjLOG + 
                         (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

mixedModteachC <- lmer(turnout ~ teachShareofVoters2 +  minBlaisLago +  
                    VAP_adjLOG + VAP_adjLOG_sq + 
                      per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide +  incumShare +
                   teachShareofVoters2  + (1|year) +  (1|distid), 
              data = moddat, REML = TRUE)

mixedModteachD <- lmer(turnout ~ teachShareofVoters2 +  
                    minBlaisLago + 
                   VAP_adjLOG +  VAP_adjLOG_sq +
                    per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumShare + 
                   teachShareofVoters2 * VAP_adjLOG + 
                         (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

mixedModteachE <- lmer(turnout ~ teachShareofVoters2 +  
                    minBlaisLago + 
                   VAP_adjLOG +  
                    per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumShare + 
                   teachShareofVoters2 * VAP_adjLOG + 
                         (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

apsrtable(mixedModteachC, mixedModteachD, 
          caption = "Partial Pooling Model of Staff Influence",
          model.names = c("Main Effect", "Interaction"),
            label = "tab:meInf", notes = list(stars.note), 
          coef.names = teachCoefnames2, digits = 3,
          Sweave = FALSE, stars = "default", size = "footnotesize")
@


<<mixedInfmodSen, results='hide', eval=TRUE>>=
# Test for year specific slopes
m.slope <- update(mixedModteachB, . ~ . - (1|year))
m0 <- update(mixedModteachB, . ~ . - (1|distid))
teachLRT <- exactRLRT(m.slope, mixedModteachB, m0)
teachLRT$callFull <- mixedModteachB@call
teachLRT$callSmall <- m.slope@call
@

\subsubsection{Partisanship}

Table \ref{tab:mePartisan} provides no evidence to support a partisan dimension in school 
board turnout. While other variables hold their relationship from the tables 
above, the new variables for partisanship and party divide in the electorate are 
not statistically significant and their interaction with the size of the community 
is also not significant. If parties played an important role in the vote 
in spring elections than either the interaction between the party division or the 
proportion Democrats and the population of the district should be statistically 
significant and positive. The lack of a relationship provides evidence that parties 
do not influence school board turnout as a social group in a meaningful way. This 
seems clear, boards are not proving grounds for candidates for higher office and as 
they are non-partisan the party leadership has little incentive to prioritize them.
\footnote{There is no evidence in the fixed effect models either.}

<<partyMods, results ='hide'>>=
moddat <- dist_turn[, c("turnout", "year", "fallTurnout", "incumShare",
                        "VAP_adjLOG", "distid", "per_white_all", "per65o", 
                        "PerBachelorOrAbove", "OOH_share", "median_incomeLOG", 
                        "fallTwoPartyShareDem", "partyDivisionFall", 
                        "districtwide", "contest", "minBlaisLago")]
moddat <- na.omit(moddat)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$contest <- factor(moddat$contest)
moddat$districtwide <- factor(moddat$districtwide)
moddat$year <- factor(moddat$year)
moddat$turnout <- moddat$turnout * 100
centr <- mean(moddat$turnout)
stddev <- sd(moddat$turnout)
moddat$outflag <- (moddat$turnout - centr) / stddev
moddat <- moddat[moddat$outflag <=5 & moddat$outflag >= -5,]
nums <- sapply(moddat, is.numeric)
# nums <- nums[!names(nums) %in% c("fallPartyDivision")]
ScaleMeans <- apply(moddat[, nums], 2, mean, na.rm=TRUE)
ScaleSD <- apply(moddat[, nums], 2, sd, na.rm=TRUE)
moddatScaleParty <- cbind(ScaleMeans, ScaleSD); rm(ScaleMeans, ScaleSD)
moddat[, nums] <- apply(moddat[, nums], 2, rescale)
moddat$VAP_adjLOG_sq <- moddat$VAP_adjLOG^2
dd <<- datadist(moddat)
options(datadist="dd")

partyRLM1 <- ols(turnout ~ fallTurnout + minBlaisLago + 
                    VAP_adjLOG + VAP_adjLOG_sq  + per_white_all + per65o + 
                   PerBachelorOrAbove + OOH_share + median_incomeLOG + 
                   districtwide + incumShare + partyDivisionFall + year + distid,
              data = moddat, x= TRUE, y = TRUE)

partyRLM1$se <- sqrt(diag(vcov(robcov(partyRLM1, cluster = moddat$distid))))


partyRLM2 <- ols(turnout ~ fallTwoPartyShareDem + fallTurnout + minBlaisLago + 
                    VAP_adjLOG + VAP_adjLOG_sq + per_white_all + per65o + 
                   PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumShare + 
                   distid + factor(year), 
              data = moddat, x = TRUE, y = TRUE)

partyRLM2$se <- sqrt(diag(vcov(robcov(partyRLM2, cluster = moddat$distid))))

partyRLM3 <- ols(turnout ~ partyDivisionFall*VAP_adjLOG + fallTurnout + minBlaisLago + 
                    VAP_adjLOG + VAP_adjLOG_sq+ per_white_all + per65o + 
                   PerBachelorOrAbove + OOH_share + median_incomeLOG + 
                   districtwide + incumShare + year + distid,
              data = moddat, x= TRUE, y = TRUE)

partyRLM3$se <- sqrt(diag(vcov(robcov(partyRLM3, cluster = moddat$distid))))


partyRLM4 <- ols(turnout ~ fallTwoPartyShareDem*VAP_adjLOG + fallTurnout + minBlaisLago + 
                    VAP_adjLOG + VAP_adjLOG_sq+ per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumShare + 
                   distid + factor(year), 
              data = moddat, x = TRUE, y = TRUE)

partyRLM4$se <- sqrt(diag(vcov(robcov(partyRLM4, cluster = moddat$distid))))

partyCoefNames <- c("Intercept", "Fall Turnout", 
                 "Competitiveness", "Electorate Size", "Electorate Size\\textsuperscript{2}", "\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% Owner Occupied", 
                  "Median Income", "District-wide", "Incumbent Share", 
                  "Fall Party Divide", "Fall 2 Party Dem.", 
                 "Party Division x Elec. Size", 
                 "2 Party Dem x Elec. Size")

partyModtab <- apsrtable(partyRLM1, partyRLM2, partyRLM3, partyRLM4, 
                         se="robust", label="tab:partymods", 
          model.names=c("Party Unity", "Dem Share", 
                        "Party Unity Inter.", "Dem Share Inter."), 
          caption = "Models of Partisanship and Turnout in School Board Elections",
          notes = list(se.note, stars.note, "Year and district fixed effects omitted."),
          omitcoef=list("distid", 
                        expression(grep("distid", coefnames, value=TRUE)), 
                        "year", 
                        expression(grep("year", coefnames, value = TRUE))), 
          coef.names = partyCoefNames,
          Sweave=FALSE, stars = "default", 
          size = "scriptsize")
@



<<partyMixedMods, results='asis'>>=
partyCoefNames2 <- c("Intercept", "Fall Party Divide", "Fall Turnout", 
                 "Competitiveness", "Electorate Size", "Electorate Size\\textsuperscript{2}","\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% Owner Occupied", 
                  "Median Income", "District-wide", "Incumbent Share", 
                 "Party Division x Elec. Size", 
                 "Fall 2 Party Dem.", "2 Party Dem\\textsuperscript{2}","2 Party Dem x Elec. Size")

mixedModP <- lmer(turnout ~ partyDivisionFall + fallTurnout + minBlaisLago + 
                    VAP_adjLOG + VAP_adjLOG_sq +per_white_all + per65o + 
                   PerBachelorOrAbove + OOH_share + median_incomeLOG + 
                   districtwide + incumShare + partyDivisionFall * VAP_adjLOG + 
                    (1|distid) + (1|year), 
              data = moddat, REML = TRUE)

mixedModPb <- lmer(turnout ~ VAP_adjLOG + VAP_adjLOG_sq + fallTwoPartyShareDem +
                     I(fallTwoPartyShareDem^2)+ 
                     fallTurnout + 
                     minBlaisLago + 
                    VAP_adjLOG + per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumShare +
                     fallTwoPartyShareDem * VAP_adjLOG +
                     (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

apsrtable(mixedModP, mixedModPb, caption = "Partial Pooling Model of Partisanship",
          model.names = c("Division", "Democrat"),
            label = "tab:mePartisan", notes = list(tabnote, stars.note), 
          Sweave = FALSE, 
          coef.names = partyCoefNames2, digits = 3, stars = "default", 
          size = "footnotesize")
@


<<mixedPartymodSen, results='hide', eval=TRUE>>=
# Test for year specific slopes
m.slope <- update(mixedModPb, . ~ . - (1|year))
m0 <- update(mixedModPb, . ~ . - (1|distid))
partyLRT <- exactRLRT(m.slope, mixedModPb, m0)
partyLRT$callFull <- mixedModPb@call
partyLRT$callSmall <- m.slope@call
@



<<cleanupb, echo=FALSE,results='hide'>>=
rm(partyRLM1, partyRLM2, partyRLM3, partyRLM4, teachRLM, teachRLM2, 
   teachRLM3, teachRLM4, closeRLM, closeRLM2, closeRLM3, closeRLM4)
@

\clearpage

\subsection{School Board Vote Rolloff}

In this section I explore whether any of the models 
above explain the difference between top ticket turnout and school board turnout. 
As much as rolloff coincides with political relevance of the school board race 
to the electorate, the relationships observed above should also be observed in 
the measure of rolloff -- with decreased rolloff taking the place of increased 
turnout. 


<<cleanundervotedata, results='hide'>>=
load("../../data/cache/springElectionVotes.rda")
# load("data/cache/springElectionVotes.rda")
springVotes$votesTopTicketSpring <- springVotes$VotesCast
springVotes$VotesCast <- NULL
dist_turn <- merge(dist_turn, springVotes, 
                   by = c("distid", "year"), all.x = TRUE)

dist_turn$topTicketTurnoutSpring <- dist_turn$votesTopTicketSpring / dist_turn$VAP_adj
dist_turn$turnoutDiff <- dist_turn$topTicketTurnoutSpring - dist_turn$turnout

vars2 <- c("turnout", "turnoutLag2", "year", "fallTurnout", "incumShare",
                        "VAP_adjLOG", "distid", "per_white_all", "per65o", 
                        "PerBachelorOrAbove", "OOH_share", "median_incomeLOG", 
                        "teachShareofVoters", "districtwide", 
                        "contest", "minBlaisLago", "teachShareofVoters2")

vars1 <- c("turnout", "turnoutLag2", "year", "fallTurnout", "topTicketTurnoutSpring",
           "turnoutDiff", "ImputedFlag",
                        "VAP_adjLOG", "distid", "per_white_all", "per65o", 
                        "PerBachelorOrAbove", "OOH_share", "median_incomeLOG", 
                        "fallTwoPartyShareDem", "partyDivisionFall", 
                        "districtwide", "contest", "minBlaisLago")

moddat <- dist_turn[, unique(c(vars1, vars2))]
moddat$ImputedFlag[is.na(moddat$ImputedFlag)] <- "Observed"
moddat$ImputedFlag <- defac(moddat$ImputedFlag)
moddat$ImputedFlag[moddat$ImputedFlag == "Imputed2010"] <- "Imputed"
moddat$ImputedFlag[moddat$ImputedFlag == "Observed2010"] <- "Observed"
moddat$ImputedFlag <- factor(moddat$ImputedFlag, levels = c("Imputed", "Observed"))
moddat$ImputedFlag <- relevel(moddat$ImputedFlag, ref = "Imputed")
moddat <- na.omit(moddat)
moddat <- moddat[order(moddat$distid, moddat$year),]
moddat$distid <- factor(moddat$distid)
moddat$year <- factor(moddat$year)
moddat$districtwide <- factor(moddat$districtwide)
moddat$turnout <- moddat$turnout * 100
moddat$turnoutDiff <- moddat$turnoutDiff * 100
# moddat$turnoutLag2 <- moddat$turnoutLag2 * 100
# moddat$turnoutLag1 <- moddat$turnoutLag1 * 100
# moddat$per_white_all <- moddat$per_white_all * 100
# moddat$per65o <- moddat$per65o * 100
# moddat$PerBachelorOrAbove <- moddat$PerBachelorOrAbove * 100
# moddat$OOH_share <- moddat$OOH_share * 100
# moddat$fallTurnout <- moddat$fallTurnout * 100
# moddat$VAP_adj <- log(moddat$VAP_adj)
# moddat$median_income <- log(moddat$median_income)
centr <- mean(moddat$turnoutDiff)
stddev <- sd(moddat$turnoutDiff)
moddat$outflag <- (moddat$turnoutDiff - centr) / stddev
moddat <- moddat[moddat$outflag <= 5 & moddat$outflag >= -5,]
centr <- mean(moddat$turnout)
stddev <- sd(moddat$turnout)
moddat$outflag <- (moddat$turnout - centr) / stddev
moddat <- moddat[moddat$outflag <= 5 & moddat$outflag >= -5,]
nums <- sapply(moddat, is.numeric)
ScaleMeans <- apply(moddat[, nums], 2, mean, na.rm=TRUE)
ScaleSD <- apply(moddat[, nums], 2, sd, na.rm=TRUE)
moddatScaleUndervote <- cbind(ScaleMeans, ScaleSD); rm(ScaleMeans, ScaleSD)
nums <- sapply(moddat, is.numeric)
moddat[, nums] <- apply(moddat[, nums], 2, rescale)
moddat$VAP_adjLOG_sq <- moddat$VAP_adjLOG^2
dd <<- datadist(moddat)
options(datadist="dd")
@

For rolloff data my data are restricted to the spring elections from 2007-2012. 
To calculate rolloff, I take the difference in the turnout for the top ticket 
in the spring election and the turnout for the highest turnout school board 
election in the school district. The greater this number, the greater the 
share of voters who failed to complete their ballots. The median district 
has \Sexpr{iPer(mean(dist_turn$turnoutDiff, na.rm=TRUE)*100)} percentage point 
difference in their turnout, meaning that if the turnout in the school board 
election was 1,810, then the turnout for the top ticket race would be 
\Sexpr{iNum2(1810 + 1810*mean(dist_turn$turnoutDiff, na.rm=TRUE))}. Thus 
ballot fatigue is not that uncommon and matches findings in other elections 
\citep{streb09,wattenberg00}.

<<undervoteMMfits1, results='asis'>>=
undervoteMMlag <- lmer(turnoutDiff ~ turnoutLag2 + fallTurnout + 
                         VAP_adjLOG + VAP_adjLOG_sq + per_white_all + 
                         per65o + PerBachelorOrAbove + OOH_share + 
                         median_incomeLOG + districtwide + incumShare +
                         ImputedFlag + minBlaisLago + 
                         (1|year) + (1|distid), 
              data = moddat, REML = FALSE)
undervoteMMclose <- lmer(turnoutDiff ~  minBlaisLago + VAP_adjLOG + fallTurnout +
                           VAP_adjLOG_sq + per_white_all + 
                    per65o + PerBachelorOrAbove + OOH_share + 
                      ImputedFlag + minBlaisLago * VAP_adjLOG +
                    median_incomeLOG + districtwide + incumShare +
                    (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

undervoteMMteach <- lmer(turnoutDiff ~ teachShareofVoters + fallTurnout + 
                           minBlaisLago + VAP_adjLOG + VAP_adjLOG_sq +
                           per_white_all + per65o + PerBachelorOrAbove +
                  OOH_share + median_incomeLOG + districtwide + incumShare +
                    ImputedFlag+  
                   teachShareofVoters * VAP_adjLOG + (1|year) + (1|distid), 
              data = moddat, REML = TRUE)
undervoteMMteachB <- lmer(turnoutDiff ~ teachShareofVoters2 + fallTurnout + 
                           minBlaisLago + VAP_adjLOG + VAP_adjLOG_sq +
                           per_white_all + per65o + PerBachelorOrAbove +
                  OOH_share + median_incomeLOG + districtwide + incumShare +
                    ImputedFlag+  
                   teachShareofVoters2 * VAP_adjLOG + (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

undervoteMMparty <- lmer(turnoutDiff ~ fallTwoPartyShareDem*VAP_adjLOG + VAP_adjLOG_sq +
                           fallTurnout + minBlaisLago +
                  VAP_adjLOG + per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide + incumShare +
                    ImputedFlag + 
                      (1|year) + (1|distid), 
              data = moddat, REML = TRUE)
undervoteMMpartyB <- lmer(turnoutDiff ~ partyDivisionFall*VAP_adjLOG +  VAP_adjLOG_sq+ 
                           fallTurnout + minBlaisLago +
                  VAP_adjLOG + per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide +incumShare +
                    ImputedFlag +
                      (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

coefNamesUnd1 <- c("Intercept", "Turnout Lag (2)","Fall Turnout", 
                 "Electorate Size", "Electorate Size\\textsuperscript{2}","\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% Owner Occupied", 
                  "ln(MedianIncome)", "District-wide", "Incumbent Share","Imputed",
                 "Competitiveness", "Competitiveness X Elec. Size")


apsrtable(undervoteMMlag, undervoteMMclose,  
          caption = "Partial Pooling Model of School Board Rolloff",
           model.names = c("Lag", "Close Race"),
            label = "tab:meUndv1", notes = list(stars.note), 
          Sweave = FALSE, digits = 3, 
          coef.names = coefNamesUnd1, stars = "default", size = "footnotesize")
@


Table \ref{tab:meUndv1} shows the results of the first three types of models 
investigated 
above for turnout. Note that here the sign is flipped -- the smaller the dependent 
variable, the more turnout for school board in relation to the top ticket turnout 
in the spring election. Prior turnout continues to matter in the lagged model, 
the higher the prior turnout the less the gap between top ticket and school board 
races in the present spring election. In the measures of the closeness of seats 
the less competitive a race is the greater the gap between the top ticket and the 
board race -- but this effect is only significant in interaction with district size. 
In small communities this relationship does not matter. 

<<undervoteMMfits2, results='asis'>>=
coefNamesUnd2 <- c("Intercept", "Teacher Share Elec.", "Fall Turnout", 
                   "Competitiveness", "Electorate Size", "Electorate Size\\textsuperscript{2}","\\% White", 
                  "\\% Over 65", "\\% Bach. +", "\\% Owner Occupied", 
                  "Median Income", "District-wide", "Incumbent Share","Imputed", 
                 "Teacher Share x Elec. Size", "Teach. Share of SB", "Teach. Share SB x Elec. Size",
                 "Fall Dem.", "Fall Dem. X Elec. Size", 
                 "Fall Partisan", "Fall Partisan x Elec. Size")
apsrtable(undervoteMMteach, undervoteMMteachB, undervoteMMparty, undervoteMMpartyB,
          caption = "Partial Pooling Model of School Board Rolloff",
           model.names = c("Teach. Infl.", "Teach. Infl. 2", 
                           "Party Infl.", "Party Divide"),
            label = "tab:meUndv2", notes = list(stars.note), 
          Sweave = FALSE, coef.names = coefNamesUnd2, stars = "default", 
          size = "footnotesize")
@


Table \ref{tab:meUndv2} shows the models for interest group influence on 
school board rolloff and provides the most interesting results. The results for the 
control variables are largely the same as in Table \ref{tab:meUndv1}, but here the 
rolloff results are different than the results for total turnout. In all three 
cases I find evidence of group influence in the completion of spring ballots. In 
the case of partisan division, this effect is only present in larger communities -- 
as communities and division get larger, the turnout gap for school board races widens. 

In the case of teachers, as teachers make up a greater share of the electorate 
fewer spring election voters who go to the polls bother to cast a vote for school 
board -- paralleling the finding from above for overall turnout. Community size 
exacerbates this effect -- in larger communities this effect is stronger. 

There is also evidence in Table \ref{tab:meUndv2} that Democratic party strength is 
related with fewer voters completing the school board vote. 
Partisan division increases rolloff, but is strongly interacted with district 
size -- as communities get larger and party division is stronger, rolloff grows. 

Also of interest is the near insignificance of all demographic controls on spring 
election rolloff. In both Table \ref{tab:meUndv1} and Table \ref{tab:meUndv2} 
the only consistent demographic indicators are indicators of wealth. This aligns 
with prior work by \citet{oliver} indicating that local election voters are 
more likely to be long-time residents who own property in the community. 

\clearpage
\subsection{Model Fit}

After reviewing the generally favorable results above, it is important to evaluate 
how well the models actually fit the data at hand. Assessing model fit in a mixed 
model framework is not as straightforward as with a standard OLS regression. 
Instead of a more sample-dependent model fit statistics like the Akaike's An 
Information Criterion, I prefer an estimate of the predictive power of the 
model for the observations in the sample. To assess this, I use a bootstrapped 
estimate of the Root Mean Squared Error (RMSE) to demonstrate how close the 
predicted values are to the fitted values across models across many resamples.
\footnote{To do this, I predict turnout on 150 bootstrap resamples of the data 
and estimate the RMSE for predictions from the original model across each of these 
resamples.}


<<modFitplot1, eval = TRUE, fig.scap="Comparing Model Fit for Competitiveness Model", fig.cap="Comparing Model Fit for Competitiveness Model. Black represents observed value, purple represents fixed effect estimate, and the red dots are the estimate from the full model.", fig.show='hide'>>=
library(broom)
plotdf <- augment(mixedModcloseC)
plotdf$yUnscale <- (plotdf$turnout * 2 * moddatScaleClose["turnout", 2]) + 
   moddatScaleClose["turnout", 1]
plotdf$yhatUnscale <- (plotdf$.fitted * 2 * moddatScaleClose["turnout", 2]) + 
   moddatScaleClose["turnout", 1]
plotdf$x1Unscale <- (plotdf$minBlaisLago * 2 * moddatScaleClose["minBlaisLago", 2]) + 
   moddatScaleClose["minBlaisLago", 1]
plotdf$yhatFixed <- (plotdf$.fixed * 2 * moddatScaleClose["turnout", 2]) + 
   moddatScaleClose["turnout", 1]

plotSlope <- coefficients(lm(yUnscale ~ x1Unscale, data = plotdf))[2]
plotInt <- coefficients(lm(yUnscale ~ x1Unscale, data = plotdf))[1]

cases <- sample(unique(plotdf$distid), 12)
plotdf <- plotdf[plotdf$distid %in% cases, ]

modelFitexamplePlot <- ggplot(plotdf, aes(x = year, y = yUnscale/100)) +
         geom_line(aes(group = distid), linetype = 2) + 
  geom_point(aes(x = year, y = yhatFixed/100), color = I("purple")) +
  geom_point(aes(x = year, y = yhatUnscale/100), color = I("red")) + 
  facet_wrap(~distid) + 
  scale_y_continuous(label = percent) +
  theme_bw() + labs(x= "Year", y = "Turnout", 
                    title = "Model Fit for Blais-Lago Model") + 
  theme(strip.text = element_blank())

modelFitexamplePlot
@


<<modFitplot2Hide, fig.show='hide'>>=
plotdf <- augment(mixedMod1lagsb)
plotdf$yUnscale <- (plotdf$turnout * 2 * moddatScaleLag["turnout", 2]) + 
   moddatScaleLag["turnout", 1]
plotdf$yhatUnscale <- (plotdf$.fitted * 2 * moddatScaleLag["turnout", 2]) + 
   moddatScaleLag["turnout", 1]
plotdf$x1Unscale <- (plotdf$turnoutLag2 * 2 * moddatScaleLag["turnoutLag2", 2]) + 
   moddatScaleLag["turnoutLag2", 1]
plotdf$yhatFixed <- (plotdf$.fixed * 2 * moddatScaleLag["turnout", 2]) + 
   moddatScaleLag["turnout", 1]

plotdf$x1Unscale <- plotdf$x1Unscale * 100
plotdf <- plotdf[plotdf$x1Unscale < 99, ]

plotSlope <- coefficients(lm(yUnscale ~ x1Unscale, data = plotdf))[2]
plotInt <- coefficients(lm(yUnscale ~ x1Unscale, data = plotdf))[1]

cases <- sample(unique(plotdf$distid), 12)
plotdf <- plotdf[plotdf$distid %in% cases, ]


ggplot(plotdf, aes(x = x1Unscale, y = yUnscale)) +
         geom_point() + 
  geom_point(aes(x = x1Unscale, y = yhatUnscale), color = I("red")) + 
  geom_point(aes(x = x1Unscale, y = yhatFixed), color = I("purple")) +
  geom_smooth(aes(x = x1Unscale, y = yUnscale), method = "lm", 
              se = FALSE, color = I("black")) + 
  geom_smooth(aes(x = x1Unscale, y = yhatUnscale), method = "lm", 
              se = FALSE, color = I("red")) + 
  geom_smooth(aes(x = x1Unscale, y = yhatFixed), method = "lm", 
              se = FALSE, color = I("purple")) +
  facet_wrap(~distid) + 
  geom_abline(intercept = plotInt, slope = plotSlope, linetype=2) +
  xlim(c(0, max(plotdf$x1Unscale))) + 
  theme_bw() + labs(x = "Lag Turnout", y = "Turnout", 
                    title = "Model Fit for Lagged Turnout Models")

# Bootstrap the beta coefficients here using bootMer
# http://glmm.wikidot.com/faq
@


<<bootRMSE, results='hide', cache=TRUE>>=
library(boot)

sigmaBoot <- boot(mixedModP@frame, bootRMSE, R = 150, model = mixedModP)
out <- cbind(summary(sigmaBoot), mod  = "Party Division")
# sigmaBoot <- boot(mixedModlags@frame, bootRMSE, R = 150, model = mixedModlags)
# out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedModlags"))
sigmaBoot <- boot(mixedMod1lagsb@frame, bootRMSE, R = 150, model = mixedMod1lagsb)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "Habit"))
# sigmaBoot <- boot(mixedModcloseC@frame, bootRMSE, R = 150, model = mixedModcloseC)
# out <- rbind(out, cbind(summary(sigmaBoot), mod  = "mixedModcloseC"))
sigmaBoot <- boot(mixedModclose@frame, bootRMSE, R = 150, model = mixedModclose)
out <- rbind(out, cbind(summary(sigmaBoot), mod  = "Blais-Lago"))
# sigmaBoot <- boot(mixedModcloseB@frame, bootRMSE, R = 100, model = mixedModcloseB)
