       y = "Count of Races",
       title = "Turnout and Race Typology in School Board Elections") + 
  theme(legend.position = c(0.8, 0.85))
rm(tempdf)

@

<<turnoutSize, echo=FALSE, fig.cap="Turnout in School Board Elections based on Electorate Size">>=

