                  "ln(MedianIncome)", "District-wide",
                 "Teacher \\% x VAP", 
                 "Fall Turnout",  "$ln(VAP)^{2}$")


mixedModteach <- lmer(turnout ~ teachShareofVoters +  minBlaisLago +  turnoutLag2 + 
                    VAP_adjLOG + per_white_all + per65o + PerBachelorOrAbove +
                   OOH_share + median_incomeLOG + districtwide +  
                   teachShareofVoters * VAP_adjLOG + (1|year) +  (1|distid), 
              data = moddat, REML = TRUE)

mixedModteachB <- lmer(turnout ~ teachShareofVoters + fallTurnout + minBlaisLago +  
                         VAP_adjLOG + VAP_adjLOG_sq + per_white_all + per65o + 
                         PerBachelorOrAbove + OOH_share + median_incomeLOG + 
                         districtwide +  
                         teachShareofVoters * VAP_adjLOG + 
                         (1|year) + (1|distid), 
              data = moddat, REML = TRUE)

apsrtable(mixedModteach, mixedModteachB, caption = "Partial Pooling Model of Staff Influence",
          model.names = c("Model 1","Model 2"),
            label = "tab:meInf", notes = list(stars.note), 
          coef.names = teachCoefnames2, 
          Sweave = FALSE)

@
\end{tiny}


<<mixedInfmodSen, results='hide', eval=TRUE>>=
# Test for year specific slopes
m.slope <- update(mixedModteachB, . ~ . - (1|year))
m0 <- update(mixedModteachB, . ~ . - (1|distid))
teachLRT <- exactRLRT(m.slope, mixedModteachB, m0)
teachLRT$callFull <- mixedModteachB@call
teachLRT$callSmall <- m.slope@call
@

\subsubsection{Partisanship}

Table \ref{tab:mePartisan} provides no evidence for a partisan dimension in school 
board turnout. While other variables hold their relationship from the tables 
above, the new variables for partisanship and party divide in the electorate are 
not statistically significant. If parties played an important role in the vote 
in spring elections than either the interaction between the party division or the 
proportion Democrats and the population of the district should be statistically 
significant and positive. The lack of a relationship provides evidence that parties 
do not

