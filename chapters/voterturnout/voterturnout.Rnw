<<turnoutAutocorrelation, echo=FALSE, fig.cap="Turnout in School Board Elections based on Prior Turnout">>=
lg  <- function(x) c(NA, x[1:length(x)-1])
lg2 <- function(x) c(NA, NA, x[2:length(x) -2])

dist_turn$year <- as.numeric(dist_turn$year)
dist_turn.tmp <- dist_turn[, c("distid", "year", "voters", "turnout")]

dist_turn.tmp <- dist_turn.tmp[order(dist_turn.tmp$distid, dist_turn.tmp$year),]

dist_turn.tmp <- as.data.table(dist_turn.tmp)[, votersLag1:= lg(voters), by = "distid"]
dist_turn.tmp <- as.data.table(dist_turn.tmp)[, votersLag2:= lg2(voters), by = "distid"]
dist_turn.tmp <- as.data.table(dist_turn.tmp)[, turnoutLag1:= lg(turnout), by = "distid"]
dist_turn.tmp <- as.data.table(dist_turn.tmp)[, turnoutLag2:= lg2(turnout), by = "distid"]
dist_turn.tmp$voters <- NULL
dist_turn.tmp$turnout <- NULL
dist_turn.tmp <- as.data.frame(dist_turn.tmp)
dist_turn <- merge(dist_turn, dist_turn.tmp)
rm(dist_turn.tmp)

qplot(turnoutLag2, turnout, 
      data = na.omit(dist_turn[dist_turn$turnout < 0.9 & dist_turn$year > 2003 & 
                                 dist_turn$turnoutLag2 < 0.9,])) +
  facet_wrap(~year) + theme_dpi() + geom_smooth(method = 'rlm') + 
  scale_x_continuous(label = percent) + 
  scale_y_continuous(label = percent) + 
  labs(x = "Lagged School Board Turnout (2 year lag)", y = "School Board Turnout", 
       title = "Comparing Lagged Turnout")
@
% Turnout and group membership

<<unionInf, echo=FALSE, fig.cap="Turnout in School Board Elections based on School Staff Share">>=
dist_turn <- merge(dist_turn, distAttr, by = c("distid", "year"))

dist_turn$mergeKey <- FORMATdistid(dist_turn$distid)
dist_turn <- merge(dist_turn, ADMIN, by.x = c("mergeKey", "year"), 
                   by.y =c("DISTID", "YEAR"))
dist_turn$mergeKey <- NULL
dist_turn$DISTID <- NULL

dist_turn$teachShareofVoters <- round(dist_turn$FTE_TEACH,0) / dist_turn$VAP_adj
dist_turn$teachShareofVoters[!is.finite(dist_turn$teachShareofVoters)] <- 0
dist_turn <- as.data.table(dist_turn)[, teachShareofVotersLag1:= lg(teachShareofVoters), 
                                      by = "distid"]
dist_turn <- as.data.table(dist_turn)[, teachShareofVotersLag2:= lg2(teachShareofVoters), 
                                      by = "distid"]

dist_turn <- as.data.frame(dist_turn)

plotdf <- dist_turn[dist_turn$year > 2004, c("year", "teachShareofVoters", "turnout")]
plotdf <- na.omit(plotdf)

qplot(teachShareofVoters, turnout, 
      data = plotdf) + 
  geom_smooth(method="rlm") + theme_dpi() +
